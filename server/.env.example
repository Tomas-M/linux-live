# Run one static Rust server process. No Rust, Node.js, OpenSSL or SQLite runtime is needed.
HOST=127.0.0.1
PORT=8787
PUBLIC_URL=https://gpt.slax.org
DATABASE=data/slax-ai.sqlite
TRUST_PROXY=false

# Optional native HTTPS. Leave both empty when Apache terminates HTTPS.
TLS_CERT_FILE=
TLS_KEY_FILE=

# One credit is $0.01 of prepaid service. Grant 20 credits once after verification.
WELCOME_CREDITS=20
WELCOME_DAILY_LIMIT=1000
RESULT_RETENTION_HOURS=24
PRICE_MULTIPLIER=2
MAX_OUTPUT_TOKENS=4096
MAX_INPUT_BYTES=120000
PROVIDER_TIMEOUT_MS=120000

# Switch to chat-completions for another compatible provider; set its prices too.
AI_PROVIDER=openai-responses
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-6.1-sol
AI_REASONING_EFFORT=medium
# USD per million tokens, standard processing. Review when changing model/provider.
INPUT_PRICE=2
CACHED_INPUT_PRICE=0.10
OUTPUT_PRICE=10
LONG_CONTEXT_THRESHOLD=272000
LONG_INPUT_MULTIPLIER=2
LONG_OUTPUT_MULTIPLIER=1.5

# SMTP is required for registration, verification and password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Slax AI <support@example.com>"

# Optional: a trusted backend may add credits using this separate secret.
ADMIN_TOKEN=

# Optional Stripe Checkout. Keep all secrets on this server.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
