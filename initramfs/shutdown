#!/bin/sh
# Shutdown script for initramfs. It's automatically started by
# systemd (if you use it) on shutdown, no need for any tweaks.
# Purpose of this script is to unmount everything cleanly.
#
# Author: Tomas M <http://www.linux-live.org/>
#

# Systemd has finished acquiring the console; start a new owner after the handoff.
if [ -f /lib/bootsplash/config ] && grep -qw quiet /proc/cmdline; then
   if ! grep -qwE 'text|debug' /proc/cmdline; then
      /bin/fbmenu --shutdown /lib/bootsplash >/dev/null 2>&1 &
   fi
fi

. /lib/config
. /lib/livekitlib

debug_start

debug_log "Entering shutdown procedures of Linux Live Kit"
debug_log "Called with arguments: " "$*"

# if debug is enabled, run shell now
debug_shell

detach_free_loops()
{
   losetup -a | cut -d : -f 1 | xargs -r -n 1 losetup -d
}

# Try child mounts first, retaining the changes backing mount until its daemon finishes.
# $1 = mount subtree to unmount
umount_all()
{
   tac /proc/mounts | awk -v root="$1" '$2==root || index($2,root "/")==1 {print $2}' | while IFS= read -r LINE; do
      LINE=$(printf '%b' "$LINE")
      if [ "$LINE" = "$BACKING_MOUNT" ]; then continue; fi
      umount "$LINE" 2>/dev/null
      detach_free_loops
   done
}

# Failed storage must remain accessible instead of being powered off underneath recovery.
# $1 = reason shutdown cannot safely continue
shutdown_recovery()
{
   fbmenu --disable 2>/dev/null
   echo "$1" >/dev/console
   echo 'Storage has not been safely closed. Exit this shell to retry shutdown.' >/dev/console
   setsid sh -c 'exec sh < /dev/tty1 >/dev/tty1 2>&1'
}

# These runtime facts belong to the initramfs; remove the live-root path prefix.
CLOSING_STORAGE=""
BACKING_MOUNT=""
if [ "$(cat /memory/storage/kind 2>/dev/null)" = container ]; then
   CLOSING_STORAGE=$(cat /memory/storage/storage) || exit 1
   CLOSING_STORAGE=${CLOSING_STORAGE#/run/initramfs}
   CLOSING_FUSE=$(cat /memory/storage/dynfilefs) || exit 1
   CLOSING_FUSE=${CLOSING_FUSE#/run/initramfs}
   BACKING_MOUNT=$(mounted_dir "$CLOSING_STORAGE") || exit 1
fi

# Update devs so we are aware of all active /dev/loop* files.
# Detach loop devices which are no longer used
debug_log "- Detaching loops"
mdev -s
detach_free_loops

# do it the dirty way, simply try to umount everything to get rid of most mounts
debug_log "- Stopping AUFS xino maintenance"
# Unlinking pseudo-links during unmount must not queue new inode-index workers.
awk '$3 == "aufs" { print $2 }' /proc/mounts | while read LINE; do
   mount -i -o remount,notrunc_xino "$LINE"
done

debug_log "- Unmounting union"
umount_all /oldroot

# If oldroot is still mounted, there is something blocking.
# Lets move it somewhere so we can unmount it cleanly
debug_log "- Moving mounts outside of union if necessry"
NR=100
tac /proc/mounts | cut -d " " -f 2 | grep ^/oldroot/. | while IFS= read -r LINE; do
   LINE=$(printf '%b' "$LINE")
   NR=$(($NR+1))
   mkdir -p /move/$NR
   mount --move "$LINE" "/move/$NR" 2>/dev/null
   umount /oldroot 2>/dev/null
done

# remember from which device we are started, so we can eject it later
DEVICE="$(cat /proc/mounts | grep /memory/data | grep /dev/ | cut -d " " -f 1)"

# Keep virtual optical media attached; DMI also catches VMs hiding the CPU flag.
if grep -qw hypervisor /proc/cpuinfo ||
   grep -Eiq '^(KVM|QEMU|VMware|VMW|innotek GmbH|VirtualBox|Xen|Bochs|Parallels|BHYVE|Hyper-V|Virtual Machine)' \
      /sys/class/dmi/id/sys_vendor /sys/class/dmi/id/product_name 2>/dev/null ||
   [ -e /sys/hypervisor/type ]; then
   DEVICE=""
fi

debug_log "- going through several cycles of umounts to clear everything left"
for i in 1 2 3 4; do
  for d in $(ls -1 /move 2>/dev/null | sort); do
      umount_all /move/$d
   done
done

# FUSE detaches before its final checkpoint and close; never abandon a busy parent.
RETRIES=0
while true; do
   umount_all /oldroot
   umount_all /move
   umount_all /memory

   if [ "$CLOSING_STORAGE" != "" ] && ! mountpoint -q "$CLOSING_FUSE"; then
      if persistence closed "$CLOSING_STORAGE"; then
         CLOSING_STORAGE=""
         BACKING_MOUNT=""
         continue
      fi
      shutdown_recovery 'Saved changes could not finish closing.'
      continue
   fi

   if ! awk '$2 ~ /^\/(oldroot|move|memory)(\/|$)/ {found=1} END {exit !found}' /proc/mounts; then break; fi
   RETRIES=$((RETRIES + 1))
   if [ "$RETRIES" -ge 300 ]; then
      shutdown_recovery 'A filesystem is still busy or could not be unmounted.'
      RETRIES=0
   fi
   sleep 0.1
done

# eject cdrom device if we were running from it
for i in $(cat /proc/sys/dev/cdrom/info | grep name); do
   if [ "$DEVICE" = "/dev/$i" ]; then
      echo "[  OK  ] Attemptiong to eject /dev/$i..."
      eject /dev/$i
      echo "[  OK  ] CD/DVD tray will close in 6 seconds..."
      sleep 6
      eject -t /dev/$i
   fi
done

debug_shell

shutdown_command="$1"

if [ "$shutdown_command" = "reboot" ]; then
   echo "Rebooting..." > /dev/console
   reboot
   reboot -f
else
   poweroff
   poweroff -f
fi

# we shouldn't be here. But if we are, reboot
debug_log reboot -f
reboot -f

# well, shit happens
echo We should never reach so far. Something is totally fucked up.
echo Here you have a shell, to experiment with the universe.
/bin/sh < /dev/console > /dev/console 2> /dev/console
