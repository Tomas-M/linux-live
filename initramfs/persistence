#!/bin/sh
# Durable storage policy; arguments and data files are never evaluated as shell code.

BASE=$(dirname "$(readlink -f "$0")")
PATH="$BASE/bin:$BASE/usr/bin:$BASE/sbin:$PATH"
. "$BASE/lib/livekitlib"
. "$BASE/lib/config"
if [ "$(id -u)" != 0 ]; then exit 1; fi

# Validate identities without converting their full 64-bit value to floating point.
# $1 = saved-state identity to validate (16 hexadecimal digits)
policy_id()
{
   test "${#1}" = 16 && printf '%s\n' "$1" | grep -qE '^[0-9a-f]+$'
}

# Reject links and special files before reading policy from writable media.
# $1 = regular metadata file to read
policy_read()
{
   if [ ! -f "$1" ] || [ -L "$1" ]; then echo '* Invalid storage policy file.' >&2; return 1; fi
   @mount.dynfilefs --metadata "${1%/*}/.persistence" read "${1##*/}"
}

# Publish complete metadata before acknowledging a change to the desktop or boot.
# $1 = destination metadata file
# $2.. = text lines to write atomically
policy_write()
{
   local FILE
   FILE="$1"
   shift
   @mount.dynfilefs --metadata "${FILE%/*}/.persistence" write "${FILE##*/}" "$@"
}

# Record removal before releasing the old inode, so interrupted cleanup is replayable.
# $1 = metadata file to remove
policy_clear()
{
   @mount.dynfilefs --metadata "${1%/*}/.persistence" clear "${1##*/}"
}

# The empty marker remembers the selected drive; its time orders choices across devices.
# $1 = changes directory containing the resume marker
# $2 = optional marker time in Unix seconds; defaults to the current time
policy_mark()
{
   local FILE NOW PREVIOUS
   FILE="$1/resume.txt"
   NOW=${2:-$(date +%s)}
   if ! printf '%s\n' "$NOW" | grep -qE '^[0-9]+$'; then return 1; fi
   if [ -e "$FILE" ] || [ -L "$FILE" ]; then
      # Only the timestamp matters; never read marker contents from writable media.
      if [ ! -f "$FILE" ] || [ -L "$FILE" ]; then return 1; fi
      PREVIOUS=$(date -r "$FILE" +%s) || return 1
      if [ "$PREVIOUS" -gt "$NOW" ]; then NOW=$PREVIOUS; fi
   fi
   @mount.dynfilefs --metadata "$1/.persistence" mark resume.txt "$NOW"
}

# A run owns one durable starting point and one independent save/discard choice.
# $1 = changes directory containing run.txt
policy_run()
{
   local TEXT ID MODE
   if [ ! -e "$1/run.txt" ] && [ ! -L "$1/run.txt" ]; then return 0; fi
   TEXT=$(policy_read "$1/run.txt") || return 1
   ID=$(printf '%s\n' "$TEXT" | sed -n 1p)
   MODE=$(printf '%s\n' "$TEXT" | sed -n 2p)
   if ! policy_id "$ID" || [ "$(printf '%s\n' "$TEXT" | wc -l)" != 2 ]; then return 1; fi
   if [ "$MODE" != save -a "$MODE" != discard ]; then return 1; fi
   printf '%s %s\n' "$ID" "$MODE"
}

# Explicit restore selection takes precedence over the previous run's discard policy.
# $1 = changes directory containing restore.txt and the previous run policy
policy_target()
{
   local ID RUN
   if [ -e "$1/restore.txt" ] || [ -L "$1/restore.txt" ]; then
      ID=$(policy_read "$1/restore.txt") || return 1
      policy_id "$ID" || return 1
      printf '%s\n' "$ID"
   else
      RUN=$(policy_run "$1") || return 1
      if [ "${RUN#* }" = discard ]; then printf '%s\n' "${RUN% *}"; fi
   fi
}

# Resolve a live node by identity; names are only the command argument after validation.
# $1 = changes directory containing changes.dat
# $2 = saved-state identity to resolve
# $3 = optional mounted DynFileFS directory from which to read the catalog
policy_name()
{
   perch_restore_points "$1" "$3" | awk -F '\t' -v id="$2" '"x" $2=="x" id {print $3; found=1} END {exit !found}'
}

# Reserve the next exact ID before creating an owned point, closing the crash-recording gap.
# $1 = mounted DynFileFS directory containing snapshots.json
policy_next_id()
{
   cat "$1/snapshots.json" | awk 'BEGIN {RS="\"id\":"; FS="\""} /^"/ {print $2}' | sort | tail -n 1 | awk '
      BEGIN {digits="0123456789abcdef"; carry=1}
      {for (i=16;i>0;i--) {n=index(digits,substr($0,i,1))-1+carry; carry=(n==16); value=substr(digits,n%16+1,1) value}
       if (carry || length(value)!=16) exit 1; print value}
   '
}

# Only exact ID/name pairs recorded by this lifecycle may be removed automatically.
# $1 = changes directory containing owned guard records
# $2 = mounted DynFileFS directory whose obsolete guards may be deleted
policy_cleanup()
{
   local PROFILE MOUNT RUN TARGET FILE ID NAME LIVE SAVED CATALOG
   PROFILE="$1"; MOUNT="$2"
   RUN=$(policy_run "$PROFILE") || return 1
   TARGET=$(policy_target "$PROFILE") || return 1
   CATALOG=$(cat "$MOUNT/snapshots.json") || return 1
   for FILE in "$PROFILE"/guard.*; do
      if [ ! -e "$FILE" ] && [ ! -L "$FILE" ]; then continue; fi
      ID=${FILE##*.}
      policy_id "$ID" || return 1
      NAME=$(policy_read "$FILE") || return 1
      if [ "$ID" = "${RUN% *}" -o "$ID" = "$TARGET" ]; then continue; fi
      LIVE=$(policy_name "$PROFILE" "$ID" "$MOUNT") || LIVE=""
      SAVED=$(printf '%s\n' "$CATALOG" | awk -v id="$ID" '
         BEGIN {RS="\"id\":"; FS="\""}
         "x" $2=="x" id {name=$0; sub(/.*,"name":"/,"",name); sub(/".*/,"",name); print name}
      ')
      # A crash before creation can leave this reserved ID to a different immutable point.
      if [ "$SAVED" = "" -o "$SAVED" != "$NAME" ]; then
         policy_clear "$FILE" || return 1
         continue
      fi
      if [ "$LIVE" != "" ]; then
         if ! printf 'delete %s\n' "$NAME" > "$MOUNT/snapshot"; then return 1; fi
      fi
      # Tombstones keep ancestry; retain matching ownership records so the UI can hide them.
   done
   sync
}

# Hide the unformatted disk and retain a named, formatted starting state for the user.
# $1 = changes directory in which to record ownership of the unformatted state
# $2 = mounted DynFileFS directory on which to create Initial state
policy_initialize()
{
   local POINTS CREATED ID NAME AUTOMATIC
   POINTS=$(perch_restore_points "$1" "${2:-}") || return 1
   if ! printf '%s\n' "$POINTS" | while IFS="$(printf '\t')" read -r CREATED ID NAME AUTOMATIC; do
      if [ "$ID" = "" ]; then continue; fi
      policy_write "$1/guard.$ID" "$NAME" || exit 1
   done; then return 1; fi
   printf 'create Initial state\n' > "$2/snapshot"
}

# Identify the formatted initial state through its owned unformatted parent.
# $1 = changes directory containing changes.dat and its guard records
# $2 = optional mounted DynFileFS directory from which to read the catalog
policy_initial()
{
   local CATALOG ROOT ID NAME OWNER
   if [ "${2:-}" != "" ]; then CATALOG=$(cat "$2/snapshots.json") || return 1
   else CATALOG=$(@mount.dynfilefs -f "$1/changes.dat" --snapshots --json) || return 1; fi
   ROOT=$(printf '%s\n' "$CATALOG" | awk 'BEGIN {RS="\"id\":"; FS="\""} /^"/ && /,"parent":null/ {
      name=$0; sub(/.*,"name":"/,"",name); sub(/".*/,"",name); printf "%s\t%s\n",$2,name
   }')
   if [ "$ROOT" = "" ]; then return 0; fi
   ID=$(printf '%s\n' "$ROOT" | cut -f 1)
   NAME=$(printf '%s\n' "$ROOT" | cut -f 2-)
   policy_id "$ID" || return 1
   # A store without an owned unformatted root has no clean initial point.
   if [ ! -e "$1/guard.$ID" ] && [ ! -L "$1/guard.$ID" ]; then return 0; fi
   OWNER=$(policy_read "$1/guard.$ID") || return 1
   if [ "$OWNER" != "$NAME" ]; then return 1; fi
   printf '%s\n' "$CATALOG" | awk -v parent="$ID" 'BEGIN {RS="\"id\":"; FS="\""}
      /^"/ && index($0,",\"parent\":\"" parent "\"") && /,"name":"Initial state",/ && /,"deleted":false/ {print $2; found=1}
      END {exit !found}'
}


# Move only the selected container's files and publish its metadata last.
policy_import()
{
   local STORE ID SOURCE FILE TARGET
   STORE="$1"
   ID=$(perch_legacy_session "$STORE") || return 0
   SOURCE="$STORE/$ID"
   for FILE in "$STORE"/changes.dat* "$STORE"/guard.* "$STORE"/run.txt "$STORE"/restore.txt "$STORE"/keep-current.*; do
      if [ -e "$FILE" ] || [ -L "$FILE" ]; then
         echo '* Cannot import saved changes over existing storage files.' >&2
         return 1
      fi
   done
   for FILE in "$SOURCE"/changes.dat*; do
      if [ -L "$FILE" ] || { [ ! -f "$FILE" ] && [ ! -d "$FILE" ]; }; then return 1; fi
   done
   @mount.dynfilefs --metadata "$SOURCE/changes.dat" recover || return 1
   @mount.dynfilefs -f "$SOURCE/changes.dat" -i >/dev/null || return 1
   set --
   for FILE in "$SOURCE"/changes.dat?* "$SOURCE"/changes.dat; do
      if [ ! -e "$FILE" ]; then continue; fi
      TARGET="$STORE/${FILE##*/}"
      if ! mv -n "$FILE" "$TARGET" || [ -e "$FILE" ]; then
         # Undo the moves completed by this attempt before returning the error.
         for TARGET do mv -n "$TARGET" "$SOURCE/" || break; done
         sync
         return 1
      fi
      set -- "$@" "$TARGET"
   done
   sync && printf '%s\n' "$ID"
}

# FUSE unmount returns before the daemon finishes its final metadata checkpoint.
# $1 = changes directory whose changes.dat.lock must disappear
policy_closed()
{
   local RETRY
   for RETRY in $(seq 1 300); do
      if [ ! -e "$1/changes.dat.lock" ]; then return 0; fi
      sleep 0.1
   done
   echo '* Storage did not finish closing.' >&2
   return 1
}

# Close the backing filesystem immediately after removing the durable run flag.
# $1 = changes directory, $2 = its last backing mount
policy_close()
{
   if ! mountpoint -q "$2" || ! policy_closed "$1"; then return 1; fi
   if policy_clear "$1/active.txt" && umount "$2"; then return 0; fi
   if ! policy_write "$1/active.txt" 'Saved changes have not been closed.'; then
      echo '* Could not restore the active marker after a storage error.' >&2
   fi
   return 1
}

# Loop teardown can outlive umount; wait before snapshotting or closing its FUSE provider.
# $1 = mounted inner filesystem directory to unmount and release from its loop device
policy_detach()
{
   local DEVICE FILE BACKING RETRY
   DEVICE=$(mounted_device "$1") || return 1
   FILE="/sys/class/block/${DEVICE##*/}/loop/backing_file"
   BACKING=$(cat "$FILE") || return 1
   umount -d "$1" || return 1
   for RETRY in $(seq 1 300); do
      if [ "$(cat "$FILE" 2>/dev/null)" != "$BACKING" ]; then return 0; fi
      sleep 0.1
   done
   echo '* The saved-changes loop device is still in use.' >&2
   return 1
}

# Publish only a complete formatted store; old directories and incomplete root files are untouched.
# $1 = changes directory in which to publish the new store
# $2 = initial virtual filesystem size in MiB
policy_create()
{
   local STORAGE SIZE STAGE MOUNT INNER FILE NAME INITIAL OK
   STORAGE="$1"; SIZE="$2"
   for FILE in "$STORAGE"/changes.dat* "$STORAGE"/guard.* "$STORAGE"/run.txt "$STORAGE"/restore.txt "$STORAGE"/keep-current.*; do
      if [ -e "$FILE" ] || [ -L "$FILE" ]; then echo '* Storage already exists or is incomplete; it will not be overwritten.' >&2; return 1; fi
   done
   STAGE=$(mktemp -d "$STORAGE/.initialize.XXXXXX") || return 1
   MOUNT=$(mktemp -d /tmp/initialize.XXXXXX) || return 1
   INNER="$MOUNT.fs"
   mkdir "$INNER" || return 1
   OK=0
   if @mount.dynfilefs -f "$STAGE/changes.dat" -s "$SIZE" -p 4000 -m "$MOUNT" --auto-snapshot-limit "$AUTOSNAPSHOT_LIMIT"; then
      if mkfs.xfs.custom "$MOUNT/virtual.dat" && mount -t xfs -o loop,nouuid "$MOUNT/virtual.dat" "$INNER"; then
         if xfs_growfs "$INNER" >/dev/null; then OK=1; fi
         if ! policy_detach "$INNER"; then return 1; fi
         if [ "$OK" = 1 ] && policy_initialize "$STAGE" "$MOUNT"; then
            INITIAL=$(policy_initial "$STAGE" "$MOUNT") || INITIAL=""
            if ! policy_id "$INITIAL" || ! printf 'protect %s\n' "$INITIAL" > "$MOUNT/snapshot" || ! policy_cleanup "$STAGE" "$MOUNT"; then OK=0; fi
         else
            OK=0
         fi
      fi
      if ! umount "$MOUNT"; then return 1; fi
      policy_closed "$STAGE" || return 1
   fi
   rmdir "$INNER" "$MOUNT"
   if [ "$OK" != 1 ]; then return 1; fi

   # Metadata is the commit record; interrupted publication never looks like a new empty disk.
   for FILE in "$STAGE"/changes.dat.* "$STAGE"/guard.*; do
      if [ ! -e "$FILE" ]; then continue; fi
      NAME=${FILE##*/}
      if [ "$NAME" = changes.dat.txn -o "$NAME" = changes.dat.txn.lock ]; then continue; fi
      if ! mv -n "$FILE" "$STORAGE/$NAME" || [ -e "$FILE" ]; then return 1; fi
   done
   sync
   @mount.dynfilefs --metadata "$STORAGE/changes.dat" copy changes.dat "$STAGE/changes.dat" || return 1
   # No stage name is reused; cleanup is also ordered before freeing its allocation.
   for FILE in "$STAGE"/* "$STAGE"/.[!.]*; do
      if [ ! -f "$FILE" ]; then continue; fi
      @mount.dynfilefs --metadata "$STAGE/changes.dat" unlink "${FILE##*/}" || return 1
   done
   @mount.dynfilefs --metadata "$STORAGE/changes.dat" rmdir "${STAGE##*/}"
}

# A user-selected point changes the next start without overriding the run's save policy.
# $1 = changes directory whose restore request is updated
# $2 = saved-state identity to restore, or current to clear an explicit restore
policy_select()
{
   local STORAGE ID FILE
   STORAGE="$1"; ID="$2"
   if [ "$ID" = current ]; then
      policy_clear "$STORAGE/restore.txt" || return 1
   else
      policy_id "$ID" || return 1
      policy_name "$STORAGE" "$ID" "" >/dev/null || return 1
      policy_write "$STORAGE/restore.txt" "$ID" || return 1
   fi
   for FILE in "$STORAGE"/keep-current.*; do
      if [ "${FILE##*.}" != "$ID" ] && { [ -e "$FILE" ] || [ -L "$FILE" ]; }; then policy_clear "$FILE" || return 1; fi
   done
   sync
}

# A manual point survives automatic retention; the record proves ownership on recovery.
# $1 = changes directory in which to record ownership of the starting state
# $2 = mounted DynFileFS directory on which to create the starting state
policy_guard()
{
   local PROFILE MOUNT NAME ID LIVE
   PROFILE="$1"; MOUNT="$2"
   NAME="live-start-$(cat /proc/sys/kernel/random/uuid)"
   ID=$(policy_next_id "$MOUNT") || return 1
   policy_id "$ID" || return 1
   policy_write "$PROFILE/guard.$ID" "$NAME" || return 1
   if ! printf 'create %s\n' "$NAME" > "$MOUNT/snapshot"; then return 1; fi
   LIVE=$(policy_name "$PROFILE" "$ID" "$MOUNT") || return 1
   if [ "$LIVE" != "$NAME" ]; then return 1; fi
   printf '%s\n' "$ID"
}

# Fit generated labels in DynFileFS's byte limit without splitting a UTF-8 character.
# $1 = full label, $2 = optional collision suffix
policy_label()
{
   printf '%s\n' "$1" | LC_ALL=C awk -v suffix="${2:-}" '
      BEGIN {for (i=128;i<192;i++) continuation=continuation sprintf("%c",i)}
      {name=$0; limit=250-length(suffix)
       if (length(name)>limit) {
          limit-=3; while (index(continuation,substr(name,limit+1,1))) limit--
          name=substr(name,1,limit); sub(/[ .]+$/,"",name); name=name "…"
       }
       print name suffix}
   '
}

# Preserve one recovered state, reusing identical history and journaling rename ownership.
# $1 = changes directory containing the restore request and previous run policy
# $2 = mounted DynFileFS directory whose current data may need to be preserved
policy_prepare()
{
   local PROFILE MOUNT ID INTENT LABEL SAVED LIVE RUN COUNT POINTS TARGET ORIGINAL STATS MATCH OWNER
   PROFILE="$1"; MOUNT="$2"
   RUN=$(policy_run "$PROFILE") || return 1
   if [ "$RUN" = "" -o "${RUN#* }" = discard ]; then return 0; fi
   if [ ! -e "$PROFILE/restore.txt" ] && [ ! -L "$PROFILE/restore.txt" ]; then return 0; fi
   ID=$(policy_read "$PROFILE/restore.txt") || return 1
   policy_id "$ID" || return 1
   TARGET=$(policy_name "$PROFILE" "$ID" "$MOUNT") || return 1
   INTENT="$PROFILE/keep-current.$ID"
   ORIGINAL=""; SAVED=""; LIVE=""
   if [ -e "$INTENT" ] || [ -L "$INTENT" ]; then
      LABEL=$(policy_read "$INTENT") || return 1
      SAVED=$(printf '%s\n' "$LABEL" | sed -n 2p)
      ORIGINAL=$(printf '%s\n' "$LABEL" | sed -n 3p)
      LABEL=$(printf '%s\n' "$LABEL" | sed -n 1p)
      if policy_id "$SAVED"; then LIVE=$(policy_name "$PROFILE" "$SAVED" "$MOUNT") || LIVE=""; fi
      if [ "$LABEL" != "" -a "$LIVE" = "$LABEL" ]; then return 0; fi
   fi

   # A recorded source name distinguishes a pending promotion from a consumed new-ID reservation.
   if [ "$ORIGINAL" = "" -o "$LIVE" != "$ORIGINAL" ]; then
      ORIGINAL=""
      STATS=$(cat "$MOUNT/stats") || return 1
      MATCH=$(printf '%s\n' "$STATS" | sed -n 's/.*"currentMatchesParent":\(true\|false\).*/\1/p')
      if [ "$MATCH" = true ]; then
         SAVED=$(printf '%s\n' "$STATS" | sed -n 's/.*"currentParent":"\([0-9a-f]*\)".*/\1/p')
         policy_id "$SAVED" || return 1
         ORIGINAL=$(policy_name "$PROFILE" "$SAVED" "$MOUNT") || return 1
      elif [ "$MATCH" = false ]; then
         SAVED=$(policy_next_id "$MOUNT") || return 1
      else
         echo '* Changes storage does not report snapshot equality.' >&2
         return 1
      fi
   fi

   OWNER=""
   if [ -e "$PROFILE/guard.$SAVED" ] || [ -L "$PROFILE/guard.$SAVED" ]; then OWNER=$(policy_read "$PROFILE/guard.$SAVED") || return 1; fi
   # Preserve user labels; only automatic points and our own starting guards are promoted.
   if [ "$ORIGINAL" != "" -a "${ORIGINAL#auto-}" = "$ORIGINAL" -a "$OWNER" != "$ORIGINAL" ]; then
      LABEL="$ORIGINAL"
   else
      if [ "${TARGET#auto-}" != "$TARGET" ]; then TARGET='Saved on restart'; fi
      LABEL=$(policy_label "Before restoring $TARGET") || return 1
      POINTS=$(cat "$MOUNT/snapshot") || return 1
      COUNT=1
      while printf '%s\n' "$POINTS" | grep -qFx "$LABEL"; do
         COUNT=$((COUNT + 1))
         LABEL=$(policy_label "Before restoring $TARGET" " ($COUNT)") || return 1
      done
   fi
   policy_write "$INTENT" "$LABEL" "$SAVED" "$ORIGINAL" || return 1
   if [ "$ORIGINAL" = "" ]; then
      if ! printf 'create %s\n' "$LABEL" > "$MOUNT/snapshot"; then return 1; fi
   elif [ "$ORIGINAL" != "$LABEL" ]; then
      if ! printf 'rename %s %s\n' "$SAVED" "$LABEL" > "$MOUNT/snapshot"; then return 1; fi
   fi
   LIVE=$(policy_name "$PROFILE" "$SAVED" "$MOUNT") || return 1
   if [ "$LIVE" != "$LABEL" ]; then return 1; fi
}

# Start policy is published before consuming the request or releasing previous guards.
# $1 = changes directory in which to publish the new run policy
# $2 = mounted DynFileFS directory containing the activated filesystem
# $3 = optional legacy session moved before this mount
policy_start()
{
   local ID FILE PREVIOUS INITIAL
   PREVIOUS=$(policy_target "$1") || return 1
   INITIAL=$(policy_initial "$1" "$2") || return 1
   ID=$(policy_guard "$1" "$2") || return 1
   policy_write "$1/run.txt" "$ID" save || return 1
   printf 'autosnapshot on\n' > "$2/snapshot" || return 1
   policy_clear "$1/restore.txt" || return 1
   for FILE in "$1"/keep-current.*; do
      if [ -e "$FILE" ] || [ -L "$FILE" ]; then policy_clear "$FILE" || return 1; fi
   done
   sync
   if [ "$PREVIOUS" != "" -a "$PREVIOUS" != "$INITIAL" ]; then
      printf 'unprotect %s\n' "$PREVIOUS" > "$2/snapshot" || return 1
   fi
   policy_cleanup "$1" "$2" || return 1
   if [ "${3:-}" != "" ]; then policy_clear "$1/last_session.txt" || return 1; fi
   printf '%s\n' "$ID"
}

if [ "$#" -lt 2 ] || ! printf '%s\n' "$1" | grep -qE '^(create|import|initial|closed|detach|select|mark|initialize|target|run|start|prepare|save|open|close|enable|inspect)$'; then exit 1; fi
if [ "$1" != closed -a "$1" != detach -a "$1" != inspect ]; then
   @mount.dynfilefs --metadata "$2/.persistence" recover || exit 1
fi

if [ "$1" = create ]; then policy_create "$2" "$3"
elif [ "$1" = import ]; then policy_import "$2"
elif [ "$1" = initial ]; then policy_initial "$2" "${3:-}"
elif [ "$1" = closed ]; then policy_closed "$2"
elif [ "$1" = open ]; then policy_write "$2/active.txt" 'Saved changes have not been closed.'
elif [ "$1" = close ]; then policy_close "$2" "$3"
elif [ "$1" = enable ]; then policy_clear "$2/active.txt"
elif [ "$1" = inspect ]; then
   if filesystem_needs_check "$2" "$3"; then
      echo 'The unmounted filesystem still reports errors or needs a check.' >&2
      exit 1
   fi
elif [ "$1" = detach ]; then policy_detach "$2"
elif [ "$1" = select ]; then policy_select "$2" "$3"
elif [ "$1" = mark ]; then policy_mark "$2" "${3:-}"
elif [ "$1" = initialize ]; then policy_initialize "$2" "${3:-}"
elif [ "$1" = target ]; then policy_target "$2"
elif [ "$1" = run ]; then policy_run "$2"
elif [ "$1" = start ]; then policy_start "$2" "$3" "${4:-}"
elif [ "$1" = prepare ]; then policy_prepare "$2" "$3"
elif [ "$1" = save ]; then
   RUN=$(policy_run "$2") || exit 1
   if [ "$RUN" != "" ]; then policy_write "$2/run.txt" "${RUN% *}" save; fi
else exit 1
fi
