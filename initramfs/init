#!/bin/sh
# Initial script for Linux Live Kit
# Author: Tomas M <http://www.linux-live.org/>

export PATH=.:/:/usr/sbin:/usr/bin:/sbin:/bin

. /lib/config
. /lib/livekitlib

# Capture early output before mounting /proc or switching to the copied root.
if [ -d /lib/bootsplash ]; then
   SPLASH_LOG=/var/log/boot.log
   exec 3>&1 4>&2
   exec >>"$SPLASH_LOG" 2>&1
fi

transfer_initramfs

MEMORY=/memory
CHANGES=$MEMORY/changes
UNION=$MEMORY/union
DATAMNT=$MEMORY/data
BUNDLES=$MEMORY/bundles

header "Live Kit init <http://www.linux-live.org/>"

init_proc_sysfs
splash_listen

debug_start
                                                                                                                                                       debug_shell
# load some modules manually first, then modprobe everything we have
init_devs
splash_start
init_aufs
init_zram

# modprobe all devices excluding network drivers
modprobe_everything -v /drivers/net/

# initialize blkid cache file
init_blkid_cache

# find data dir with filesystem bundles
DATA="$(find_data 45 "$DATAMNT")"
check_data_found "$DATA"
splash_start
                                                                                                                                                      debug_shell
# setup persistent changes, if possible
CHANGES_MOUNT=$CHANGES
UPPER=$CHANGES
if ! aufs_is_supported >/dev/null; then
   CHANGES_MOUNT=$MEMORY/overlay
   UPPER=$CHANGES_MOUNT/changes
fi
while ! persistent_changes "$DATA" "$CHANGES" "$CHANGES_MOUNT"; do
   fatal 'Could not activate persistent changes'
done
STORAGE_KIND="$(cat "$MEMORY/storage/kind")"
if [ "$STORAGE_KIND" = ram ] && [ -f "$MEMORY/storage/unclean/device" ]; then
   STORAGE_KIND=recovery
fi
splash_start "$STORAGE_KIND"
                                                                                                                                                      debug_shell
# copy to RAM if needed
DATA="$(copy_to_ram "$DATA" "$CHANGES")"
printf '%s\n' "/run/initramfs$DATA" > "$MEMORY/storage/source"

# mount bundles
mount_bundles "$DATA" "$BUNDLES"
                                                                                                                                                      debug_shell
# init aufs union, or setup overlayfs union
while ! init_union "$CHANGES_MOUNT" "$UNION" "$BUNDLES" "$UPPER"; do
   fatal 'Could not mount the union filesystem'
done
printf '%s\n' "/run/initramfs$UPPER" > "$MEMORY/storage/upper"

# add data to aufs union
union_append_bundles "$BUNDLES" "$UNION"
                                                                                                                                                      debug_shell
# rootcopy
copy_rootcopy_content "$DATA" "$UNION"

# create fstab
fstab_create "$UNION"
                                                                                                                                                      debug_shell
# run user custom preinit
user_preinit "$DATA" "$UNION"

header "Live Kit done, starting $LIVEKITNAME"
change_root "$UNION"

splash_stop
header "!!ERROR occured, you shouldn't be here.!!"
/bin/sh
