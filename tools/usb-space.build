#!/bin/sh
# Rebuild the bundled native Windows tool only after changing its source.
set -eu
TOOLS=$(cd "$(dirname "$0")" && pwd -P)
TEMP=$(mktemp -d "${TMPDIR:-/tmp}/usb-space-build.XXXXXX")
trap 'rm -r "$TEMP"' 0
printf '1 ICON "%s/usb-space.ico"\n1 24 "%s/usb-space.manifest"\n' "$TOOLS" "$TOOLS" > "$TEMP/resource.rc"
i686-w64-mingw32-windres "$TEMP/resource.rc" "$TEMP/resource.o"
i686-w64-mingw32-gcc -std=c11 -Os -Wall -Wextra -Werror -municode -mwindows -static-libgcc \
   -Wl,--nxcompat,--dynamicbase,--no-insert-timestamp "$TOOLS/usb-space.c" "$TEMP/resource.o" \
   -lcomctl32 -lshell32 -lole32 -loleaut32 -lwbemuuid -o "$TOOLS/../bootfiles/grub/usb-space/usb-space.exe"
i686-w64-mingw32-strip "$TOOLS/../bootfiles/grub/usb-space/usb-space.exe"
