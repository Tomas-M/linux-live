#!/bin/sh

# Functions library :: for Linux Live Kit scripts
# Author: Tomas M. <http://www.linux-live.org>
#

# =================================================================
# debug and output functions
# =================================================================

# Keep keyboard input responsive while the boot script waits for devices.
splash_listen()
{
   [ "$SPLASH_LOG" ] || return 0
   # Text boots keep the console even when quiet was supplied explicitly.
   if grep -qw text /proc/cmdline || ! grep -qw quiet /proc/cmdline; then splash_disable; return; fi
   chvt 1
   fbmenu --serve /lib/bootsplash "$SPLASH_LOG" &
   SPLASH_PID=$!
}

# Stop the renderer before an interactive console, or preserve pixels at handoff.
splash_stop()
{
   [ "$SPLASH_LOG" ] || return 0
   if [ "$SPLASH_PID" ]; then
      if [ "$1" = "keep" ]; then
         fbmenu --keep
      else
         fbmenu --disable || cat "$SPLASH_LOG" >&3
         fbmenu --stop
      fi
      wait "$SPLASH_PID" 2>/dev/null
      SPLASH_PID=
   fi
   exec >&3 2>&4
}

# Restore direct console output; the renderer already displayed captured output.
splash_disable()
{
   [ "$SPLASH_LOG" ] || return 0
   if [ ! "$SPLASH_PID" ]; then cat "$SPLASH_LOG" >&3; fi
   splash_stop
   exec 3>&- 4>&-
   SPLASH_LOG=
}

# Start graphics without changing video modes; Esc remains disabled for this boot.
splash_start()
{
   [ "$SPLASH_LOG" ] || return 0
   if [ -e /run/bootsplash.disabled ]; then splash_disable; return; fi
   fbmenu --start || splash_disable
}

debug_start()
{
   if grep -q debug /proc/cmdline; then
      splash_disable
      echo 7 >/proc/sys/kernel/printk
      DEBUG_IS_ENABLED=1
      set -x
   else
      DEBUG_IS_ENABLED=
   fi
}

debug_log()
{
   if [ "$DEBUG_IS_ENABLED" ]; then
      echo "- debug: $*" >&2
   fi
   log "- debug: $*"
}

# header
# $1 = text to show
#
header()
{
   echo "[0;1m""$@""[0;0m"
}


# echo green star
#
echo_green_star()
{
   echo -ne "[0;32m""* ""[0;39m"
}

# log - store given text in /var/log/livedbg
log()
{
   echo "$@" 2>/dev/null >>/var/log/livedbg
}

echolog()
{
   echo "$@"
   log "$@"
}


# show information about the debug shell
show_debug_banner()
{
   echo
   echo "====="
   echo ": Debugging started. Here is the root shell for you."
   echo ": Type your desired commands or hit Ctrl+D to continue booting."
   echo
}


# debug_shell
# executed when debug boot parameter is present
#
debug_shell()
{
   if [ "$DEBUG_IS_ENABLED" ]; then
      show_debug_banner
      setsid sh -c 'exec sh < /dev/tty1 >/dev/tty1 2>&1'
      echo
   fi
}

fatal()
{
   splash_stop
   if [ "${2:-}" != "" ]; then printf '\033[2J\033[H'; fi
   echolog
   header "Fatal error occurred - $1"
   if [ "${2:-}" != "" ]; then
      cat "$2"
   else
      echolog "Something went wrong and we can't continue. This should never happen."
   fi
   echolog "Please reboot your computer with Ctrl+Alt+Delete ..."
   echolog
   setsid sh -c 'exec sh < /dev/tty1 >/dev/tty1 2>&1'
}


# get value of commandline parameter $1
# $1 = parameter to search for
#
cmdline_value()
{
   cat /proc/cmdline | egrep -o "(^|[[:space:]])$1=[^[:space:]]+" | tr -d " " | cut -d "=" -f 2- | tail -n 1
}


# test if the script is started by root user. If not, exit
#
allow_only_root()
{
  if [ "0$UID" -ne 0 ]; then
     echo "Only root can run $(basename $0)"; exit 1
  fi
}


# Create bundle
# call mksquashfs with apropriate arguments
# $1 = directory which will be compressed to squashfs bundle
# $2 = output file
# $3..$9 = optional arguments like -keep-as-directory or -b 123456789
#
create_bundle()
{
   debug_log "create_module" "$*"
   rm -f "$2" # overwrite, never append to existing file
   mksquashfs "$1" "$2" -comp xz -b 1024K -Xbcj x86 -always-use-fragments $3 $4 $5 $6 $7 $8 $9>/dev/null
}


# Move entire initramfs tree to tmpfs mount.
# It's a bit tricky but is necessray to enable pivot_root
# even for initramfs boot image
#
transfer_initramfs()
{
   if [ ! -r /lib/initramfs_escaped ]; then
      echo "switch root from initramfs to ramfs"
      SWITCH=/m # one letter directory
      mkdir -p $SWITCH
      mount -t tmpfs -o size="100%" tmpfs $SWITCH
      cp -a /??* $SWITCH 2>/dev/null # only copy two-and-more-letter directories
      cd $SWITCH
      echo "This file indicates that we successfully escaped initramfs" > $SWITCH/lib/initramfs_escaped
      exec switch_root -c /dev/console . $0
   fi
}


# mount virtual filesystems like proc etc
#
init_proc_sysfs()
{
   debug_log "init_proc_sysfs" "$*"
   mkdir -p /proc /sys /etc $MEMORY
   mount -n -t proc proc /proc
   if grep -qw quiet /proc/cmdline; then
      echo "0" >/proc/sys/kernel/printk
   fi
   mount -n -t sysfs sysfs /sys
   mount -n -o remount,rw rootfs /
   ln -sf /proc/mounts /etc/mtab
}


# modprobe all modules found in initial ramdisk
# $1 = -e for match, -v for negative match
# $2 = regex pattern
#
modprobe_everything()
{
   debug_log "modprobe_everything" "$*"

   echo_green_star >&2
   echo "Probing for hardware" >&2

   find /lib/modules/ | fgrep .ko | egrep $1 $2 | sed -r "s:^.*/|[.]ko\$::g" | xargs -n 1 modprobe 2>/dev/null
   refresh_devs
}


refresh_devs()
{
   debug_log "refresh_devs" "$*"
   if [ -r /proc/sys/kernel/hotplug ]; then
      echo /sbin/mdev > /proc/sys/kernel/hotplug
   fi
   mdev -s
}


# make sure some devices are there
init_devs()
{
   debug_log "init_devs" "$*"
   modprobe zram 2>/dev/null
   modprobe loop 2>/dev/null
   modprobe squashfs 2>/dev/null
   modprobe fuse 2>/dev/null
   # High-speed USB controllers must initialize before their companion drivers.
   modprobe ehci-hcd 2>/dev/null
   modprobe ehci-pci 2>/dev/null
   refresh_devs
}


# Activate zram (auto-compression of RAM)
# Compressed RAM consumes 1/2 or even 1/4 of original size
# Setup static size of 500MB
#
init_zram()
{
   debug_log "init_zram" "$*"
   echo_green_star
   echo "Setting dynamic RAM compression using ZRAM if available"
   if [ -r /sys/block/zram0/disksize ]; then
      echo 536870912 > /sys/block/zram0/disksize # 512MB
      mkswap /dev/zram0 >/dev/null
      swapon /dev/zram0
      echo 100 > /proc/sys/vm/swappiness
   fi
}


aufs_is_supported()
{
   if [ "${UNIONFS:-auto}" = overlay ]; then return 1; fi
   cat /proc/filesystems | grep aufs
}


# load the AUFS kernel driver. If not found,
# load overlayfs instead.
#
init_aufs()
{
   debug_log "init_aufs" "$*"
   if [ "${UNIONFS:-auto}" != overlay ]; then
      modprobe aufs 2>/dev/null
   fi
   if ! aufs_is_supported >/dev/null; then
      modprobe overlay 2>/dev/null
   fi
   refresh_devs
}


# Setup empty aufs union, or create overlayfs union
# $1 = changes directory (ramfs or persistent changes)
# $2 = union directory where to mount the union
# $3 = bundles directory
#
init_union()
{
   debug_log "init_union" "$*"
   mkdir -p "$1"
   mkdir -p "$2"

   if aufs_is_supported >/dev/null; then
      echo_green_star
      echo "Setting up empty union using aufs"
      mount -t aufs -o xino="/.xino",trunc_xino,br="$1" aufs "$2"
   else
      echo_green_star
      echo "Setting up union using overlayfs"
      mkdir -p "$1/changes"
      mkdir -p "$1/workdir"
      local LOWER
      LOWER=$(find "$3" -mindepth 1 -maxdepth 1 -type d | sortmod | tac | tr '\n' ':' | sed -r 's/:$//')
      mount -t overlay overlay -o "lowerdir=$LOWER,upperdir=$1/changes,workdir=$1/workdir,index=off,metacopy=off,redirect_dir=off,xino=off" "$2"
   fi
}


# Return device mounted for given directory
# $1 = directory
#
mounted_device()
{
   debug_log "mounted_device" "$*"

   local MNT TARGET
   MNT="$1"
   while [ "$MNT" != "/" -a "$MNT" != "." -a "$MNT" != "" ]; do
      TARGET="$(grep -F " $MNT " /proc/mounts | cut -d " " -f 1)"
      if [ "$TARGET" != "" ]; then
         echo "$TARGET"
         return
      fi
      MNT="$(dirname "$MNT")"
   done
}


# Return mounted dir for given directory
# $1 = directory
#
mounted_dir()
{
   debug_log "mounted_dir" "$*"

   local MNT
   MNT="$1"
   while [ "$MNT" != "/" -a "$MNT" != "." -a "$MNT" != "" ]; do
      if mountpoint -q "$MNT" 2>/dev/null; then
         echo "$MNT"
         return
      fi
      MNT="$(dirname "$MNT")"
   done
}


# Initialize blkid cache by manually probing all devices
#
init_blkid_cache()
{
   local DEV
   cat /proc/partitions | tr -s " " |  cut -d " " -f 5 | while read DEV; do
      blkid /dev/$DEV >/dev/null 2>/dev/null
   done
}


# Get device tag.
# $1 = device
# $2 = tag name, such as TYPE, LABEL, UUID, etc
#
device_tag()
{
   blkid -s $2 "$1" | sed -r "s/^[^=]+=//" | tr -d '"'
}


# Make sure to mount FAT12/16/32 using vfat
# in order to support long filenames
# $1 = device
# $2 = prefix to add, like -t
#
device_bestfs()
{
   debug_log "device_bestfs" "$*"
   local FS

   FS="$(device_tag "$1" TYPE | tr [A-Z] [a-z])"
   if [ "$FS" = "msdos" -o "$FS" = "fat" -o "$FS" = "vfat" ]; then
      FS="vfat"
   elif [ "$FS" = "ntfs" ]; then
      FS="ntfs3"
   fi

   if [ "$2" != "" ]; then
      echo -n "$2"
   fi

   echo "$FS"
}


# Filesystem options for initial mount
# $1.. = filesystem
#
fs_options()
{
   debug_log "fs_options" "$*"

   echo -n "-t $1 "
   # Probe NTFS read-only until Windows hibernation is checked; ISO9660 is never writable.
   if [ "$1" = "iso9660" -o "$1" = "ntfs" -o "$1" = "ntfs3" ]; then
      echo "-o ro"
      return
   fi
   echo -n "-o rw"

   if [ "$1" = "vfat" ]; then
      echo ",check=s,shortname=mixed,iocharset=utf8"
   fi
}


# Mount command for given filesystem
# $1.. = filesystem
#
mount_command()
{
   debug_log "mount_command" "$*"

   echo "mount"
}


# Accept only an absent hibernation file or a complete, zeroed Windows header.
# $1 = read-only NTFS mount directory
ntfs_hibernation_inactive()
{
   local FILE HEADER

   FILE=$(find "$1" -maxdepth 1 -iname hiberfil.sys) || return 1
   if [ "$FILE" = "" ]; then return 0; fi
   if [ ! -f "$FILE" ] || [ -L "$FILE" ]; then return 1; fi
   HEADER=$(od -An -v -N 4096 -t x1 "$FILE") || return 1
   HEADER=$(printf '%s' "$HEADER" | tr -d ' \n')
   if [ "${#HEADER}" -ne 8192 ]; then return 1; fi
   test "$(printf '%s' "$HEADER" | tr -d 0)" = ""
}


# Mount normally, allowing NTFS writes only after a read-only hibernation check.
# $1 = device, $2 = mount directory, $3 = filesystem
# $4 = optional file for initial mount errors
mount_device()
{
   local NUMBER EXISTING

   # Reuse an already checked NTFS mount; a second RO mount of an RW superblock is refused.
   if [ "$3" = ntfs -o "$3" = ntfs3 ]; then
      NUMBER=$(cat "/sys/class/block/$(basename "$(readlink -f "$1")")/dev") || return 1
      EXISTING=$(awk -v device="$NUMBER" '$3==device && $4=="/" {print $5; exit}' /proc/self/mountinfo)
      if [ "$EXISTING" != "" ]; then
         $(mount_command "$3") --bind "$(printf '%b' "$EXISTING")" "$2" 2>"${4:-/dev/null}"
         return
      fi
   fi

   if ! $(mount_command "$3") "$1" "$2" $(fs_options "$3") 2>"${4:-/dev/null}"; then return 1; fi
   if [ "$3" != ntfs -a "$3" != ntfs3 ]; then return 0; fi

   if ! ntfs_hibernation_inactive "$2" 2>/dev/null; then
      echo "* Keeping $1 read-only: Windows is hibernated or its state could not be verified." >&2
   elif ! mount -o remount,rw "$2" 2>/dev/null; then
      echo "* Keeping $1 read-only: NTFS refused the read-write remount." >&2
   fi
   return 0
}


# echo first network device known at the moment of calling, eg. eth0
#
network_device()
{
   debug_log "network_device" "$*"
   local BOOTIF DEVICE
   BOOTIF=$(cmdline_value BOOTIF | sed 's/^01-//; s/-/:/g' | tr 'A-F' 'a-f')
   if [ "$BOOTIF" ]; then
      # Keep probing until the NIC used by the firmware is available.
      for DEVICE in /sys/class/net/*; do
         if [ "$(cat "$DEVICE/address")" = "$BOOTIF" ]; then basename "$DEVICE"; return; fi
      done
      return
   fi
   cat /proc/net/dev | grep : | grep -v lo: | grep -v ip6tnl | cut -d : -f 1 | tr -d " " | head -n 1
}


# Modprobe network kernel modules until a working driver is found.
# The function returns the first device found, yet it doesn't have
# to be a working one, eg. if the computer has two network interfaces
# and ethernet cable is plugged only to one of them.
#
init_network_dev()
{
   debug_log "init_network_dev" "$*"
   local MODULE ETH

   for MODULE in 3c59x acenic e1000 e1000e e100 epic100 hp100 ne2k-pci \
   pcnet32 8139too 8139cp tulip via-rhine r8169 atl1e yellowfin tg3 \
   dl2k ns83820 atl1 b44 bnx2 skge sky2 tulip forcedeth sb1000 sis900; do
      modprobe $MODULE 2>/dev/null
      ETH="$(network_device)"
      if [ "$ETH" != "" ]; then
         echo $ETH
         return 0
      fi
      rmmod $MODULE 2>/dev/null
   done

   # If we are here, none of the above specified modules worked.
   # As a last chance, try to modprobe everything else
   modprobe_everything -e /drivers/net/
   echo $(network_device)
}


# Initialize network IP address
# either static from ip=bootparameter, or from DHCP
#
init_network_ip()
{
   debug_log "init_network_ip" "$*"
   local IP ETH SCRIPT CLIENT SERVER GW MASK

   SCRIPT=/tmp/dhcpscript
   ETH=$(init_network_dev)
   IP=$(cmdline_value ip)

   echo "* Setting up network" >&2

   if [ "$IP" != "" -a "$IP" != dhcp ]; then
      # set IP address as given by boot paramter
      echo "$IP" | while IFS=":" read CLIENT SERVER GW MASK; do
         ifconfig $ETH "$CLIENT" netmask "$MASK"
         route add default gw "$GW"
         echo nameserver "$GW" >> /etc/resolv.conf
         echo nameserver "$SERVER" >> /etc/resolv.conf
      done
   else
      # An omitted address or ip=dhcp requests a DHCP lease.
      ifconfig $ETH up
      printf '%s\n' '#!/bin/sh' 'if [ "$1" != "bound" ]; then exit; fi' \
         'ifconfig $interface $ip netmask $subnet' 'route add default gw $router' \
         'echo nameserver $dns >>/etc/resolv.conf' >"$SCRIPT"
      chmod a+x $SCRIPT
      udhcpc -i $ETH -n -s $SCRIPT -q >/dev/null
   fi
}


# Mount data from http using httpfs
# $1 = from URL
# $2 = target
mount_data_http()
{
   debug_log "mount_data_http" "$*"
   local CACHE HTTPMNT

   echo_green_star >&2
   echo "Load data from $1" >&2

   CACHE=$(cmdline_value cache | sed -r "s/[^0-9]//g" | sed -r "s/^0+//g")
   if [ "$CACHE" != "" ]; then
      CACHE="-C /tmp/httpfs.cache -S "$(($CACHE*1024*1024))
   fi

   init_network_ip

   if [ "$(network_device)" != "" ]; then
      echo "* Mounting remote file..." >&2
      # Keep the remote file visible below its separate loop-mounted filesystem.
      HTTPMNT="$2.httpfs"
      mkdir -p "$2" "$HTTPMNT"
      if ! @mount.httpfs2 -r 9999 -t 5 $CACHE -c /dev/null "$1" "$HTTPMNT" -o ro >/dev/null 2>/dev/null; then return 1; fi
      if ! mount -o loop,ro "$HTTPMNT"/* "$2"; then
         umount "$HTTPMNT" 2>/dev/null
         return 1
      fi
      echo "$2/$LIVEKITNAME"
   fi
}


# stdin = files to get
# $1 = server
# $2 = destination directory
#
tftp_mget()
{
   while read FNAME; do
      echo "* $FNAME ..." >&2
      tftp -b 1486 -g -r "$FNAME" -l "$2/$FNAME" "$1"
   done
}


# Download data from tftp
# $1 = target (store downloaded files there)
#
download_data_pxe()
{
   debug_log "download_data_pxe" "$*"
   local IP CMD CLIENT SERVER GW MASK PORT PROTOCOL JOBS

   mkdir -p "$1/$LIVEKITNAME"
   IP="$(cmdline_value ip)"

   echo "$IP" | while IFS=":" read CLIENT SERVER GW MASK PORT; do
      echo_green_star >&2
      echo "Contacting PXE server $SERVER" >&2

      if [ "$PORT" = "" ]; then PORT="7529"; fi

      init_network_ip

      echo "* Downloading PXE file list" >&2

      PROTOCOL=http
      wget -q -O "$1/PXEFILELIST" "http://$SERVER:$PORT/PXEFILELIST?$(uname -r):$(uname -m)"
      if [ $? -ne 0 ]; then
         echo "Error downloading from http://$SERVER:$PORT, trying TFTP" >&2
         PROTOCOL=tftp
         echo PXEFILELIST | tftp_mget "$SERVER" "$1"
      fi

      echo "* Downloading files from the list" >&2

      if [ "$PROTOCOL" = "http" ]; then
         cat "$1/PXEFILELIST" | while read FILE; do
            wget -O "$1/$LIVEKITNAME/$(basename $FILE)" "http://$SERVER:$PORT/$FILE"
         done
      else
         JOBS=3
         for i in $(seq 1 $JOBS); do
            awk "NR % $JOBS == $i-1" "$1/PXEFILELIST" | tftp_mget "$SERVER" "$1/$LIVEKITNAME" &
         done
         wait
      fi
   done

   echo "$1/$LIVEKITNAME"
}


# Find LIVEKIT data by mounting all devices
# If found, keep mounted, else unmount
# $1 = data directory target (mount here)
# $2 = data directory which contains compressed bundles
# $3 = optional filesystem UUID supplied by the bootloader
#
find_data_try()
{
   debug_log "find_data_try" "$*"

   local DEVICE FS FROM ISOMNT DEVICES BOOTDEVICE RESULT

   mkdir -p "$1"
   blkid >/var/log/live-data/blkid
   DEVICES=$(sort /var/log/live-data/blkid | cut -d: -f 1)
   if [ "${3:-}" != "" ]; then
      # Wait for the boot filesystem rather than selecting another installation too early.
      BOOTDEVICE=$(blkid -U "$3") || return 0
      DEVICES=$(printf '%s\n%s\n' "$BOOTDEVICE" "$DEVICES" | awk '!seen[$0]++')
   fi

   printf '%s\n' "$DEVICES" | grep -E -v "^$|/loop|/ram|/zram" | while read DEVICE; do
      FROM="$2"
      ISOMNT=""

      # supported syntax is even like from=/dev/sr0/livekitname. It is not so much
      # optiomal to put the following block of code here inside the while loop,
      # but there is no harm so lets modify DEVICE and FROM to make it work
      if echo "$FROM" | grep -q '^/dev/'; then
         DEVICE="$(echo "$FROM" | cut -d '/' -f 1-3)"
         FROM="$(echo "$FROM" | cut -d '/' -f 4-)"
         if [ "$FROM" = "" ]; then
            FROM="$LIVEKITNAME"
         fi
      fi

      FS="$(device_bestfs "$DEVICE")"
      # Keep each device's latest outcome across retries and command substitutions.
      RESULT=/var/log/live-data/$(echo "$DEVICE" | tr / _)
      printf '%s\t%s\t' "$DEVICE" "$FS" >"$RESULT.result"
      : >"$RESULT.error"
      if ! mount_device "$DEVICE" "$1" "$FS" "$RESULT.error"; then
         echo "Mount failed" >>"$RESULT.result"
         continue
      fi

      # if the FROM parameter is actual file, mount it again as loop (eg. iso)
      if [ -f "$1/$FROM" ]; then
         ISOMNT="$1/../iso"
         mkdir -p "$ISOMNT"
         if ! mount -o loop,ro "$1/$FROM" "$ISOMNT" 2>"$RESULT.error"; then
            echo "ISO mount failed" >>"$RESULT.result"
            umount "$1" 2>/dev/null
            continue
         fi
         FROM="../iso/$LIVEKITNAME"
      fi

      # search for bundles in the mounted directory
      if [ "$(find "$1/$FROM" -maxdepth 1 -name "*.$BEXT" 2>>"$RESULT.error")" != "" ]; then
         # we found at least one bundle/module here
         echo "System modules found" >>"$RESULT.result"
         echo "$FROM" > /var/log/from.log
         echo "$1/$FROM" | tr -s "/" | sed -r "s:/[^/]+/[.][.]/:/:g"
         return
      fi

      # search for bundles in modules directory
      if [ "$(find "$1/$FROM/modules" -maxdepth 1 -name "*.$BEXT" 2>>"$RESULT.error")" != "" ]; then
         # we found at least one bundle/module here
         echo "System modules found" >>"$RESULT.result"
         echo "$1/$FROM" | tr -s "/" | sed -r "s:/[^/]+/[.][.]/:/:g"
         echo "$FROM" > /var/log/from.log
         return
      fi

      if [ ! -d "$1/$FROM" ]; then
         echo "Data directory missing or unreadable" >>"$RESULT.result"
      else
         printf 'No *.%s system modules\n' "$BEXT" >>"$RESULT.result"
      fi

      # Release the ISO before its source filesystem, including failed searches.
      if [ "$ISOMNT" != "" ]; then umount "$ISOMNT" 2>/dev/null; fi
      umount "$1" 2>/dev/null
   done
}


# Retry finding LIVEKIT data several times,
# until timeouted or until data is found
# $1 = timeout
# $2 = data directory target (mount here)
#
find_data()
{
   debug_log "find_data" "$*"

   local DATA FROM TIMEOUT ASKPID BOOTUUID

   mkdir -p /var/log/live-data
   rm -f /var/log/live-data/*.result /var/log/live-data/*.error
   : >/var/log/live-data/blkid
   FROM="$(cmdline_value from)"
   printf '%s\n' "${FROM:-$LIVEKITNAME}" >/var/log/live-data/from
   # An explicit from= keeps its existing behavior and overrides the bootloader hint.
   BOOTUUID=""
   if [ "$FROM" = "" ]; then BOOTUUID=$(cmdline_value bootuuid); fi

   # boot parameter specified as from=http://server.com/file.iso
   if [ "$(echo $FROM | grep 'http://')" != "" ]; then
      mount_data_http "$FROM" "$2"
      return
   fi

   # if we got IP address as boot parameter, it means we booted over PXE
   if [ "$(cmdline_value ip)" != "" ]; then
      download_data_pxe "$2"
      return
   fi

   # If user wants to get asked, ask and periodically update list of devices
   if [ "$FROM" = "ask" ]; then
      (
         while true; do
            blkid -o full -s TYPE -s LABEL | grep -E -v '/loop|/ram|/zram|TYPE="swap"' | while read LINE; do
               DISK="$(echo "$LINE" | cut -d : -f 1)"
               SIZE="$(fdisk -l "$DISK" 2>/dev/null | grep $DISK | grep : | sed -r "s/.*: |,.*//g")"
               echo -n "$DISK: $SIZE, "
               echo "$LINE" | sed -r 's/[^"]*"([^"]*)"/\1, /g' | sed -r 's/, $//'
            done >/tmp/0.txt
            mv -f /tmp/0.txt /tmp/ask.txt
            sleep 1
         done
      ) &
      ASKPID=$!
      sleep 1 # give blkid some chance to finish
      FROM="$(fbmenu --menu "Look for /$LIVEKITNAME/ directory on:" /tmp/ask.txt)"
      FROM="$(echo "$FROM" | cut -d : -f 1)/$LIVEKITNAME"
      kill $ASKPID
   fi

   # default to livekitname autodetected on all disks
   if [ "$FROM" = "" ]; then FROM="$LIVEKITNAME"; fi
   printf '%s\n' "$FROM" >/var/log/live-data/from

   echo_green_star >&2
   echo -n "Looking for $LIVEKITNAME data in /$FROM .." | tr -s "/" >&2
   for TIMEOUT in $(seq 1 $1); do
      echo -n "." >&2
      refresh_devs
      DATA="$(find_data_try "$2" "$FROM" "$BOOTUUID")"
      # Resume ordinary discovery if the boot filesystem never became available.
      if [ "$DATA" = "" -a "$TIMEOUT" = "$1" -a "$BOOTUUID" != "" ]; then
         DATA="$(find_data_try "$2" "$FROM")"
      fi
      if [ "$DATA" != "" ]; then
         echo "" >&2
         echo "* Found on $(mounted_device "$2")" >&2
         echo "$DATA"
         return
      fi
      sleep 1
   done
   echo "" >&2
}


# Collect a full RAM-only report and a bounded console summary without mounting again.
data_diagnostics()
{
   local DEVICE FS RESULT UUID PREFERRED ERROR
   UUID=$(cmdline_value bootuuid)
   PREFERRED=""
   if [ "$UUID" != "" ]; then PREFERRED=$(blkid -U "$UUID") || PREFERRED=""; fi

   for RESULT in /var/log/live-data/*.result; do
      if [ -f "$RESULT" ]; then cat "$RESULT"; fi
   done >/var/log/live-data/devices
   awk 'NR>2 && $4 !~ /^(loop|ram|zram)/ {print "/dev/"$4}' /proc/partitions | while read DEVICE; do
      RESULT=/var/log/live-data/$(echo "$DEVICE" | tr / _).result
      if [ ! -f "$RESULT" ]; then
         FS=$(awk -v device="$DEVICE:" '$1==device {for (i=2; i<=NF; i++) if ($i ~ /^TYPE="/) {gsub(/^TYPE="|"$/, "", $i); print $i}}' /var/log/live-data/blkid)
         printf '%s\t%s\tNot searched\n' "$DEVICE" "${FS:--}"
      fi
   done >>/var/log/live-data/devices

   {
      printf 'Kernel: %s\nCommand line: ' "$(uname -r)"
      cat /proc/cmdline
      printf 'Live scripts checksum: '; cksum /lib/livekitlib
      printf 'Search: %s\nPreferred UUID: %s\n' "$(cat /var/log/live-data/from)" "${UUID:-none}"
      printf '\nDevices and latest search results:\n'
      cat /var/log/live-data/devices
      for RESULT in /var/log/live-data/*.result; do
         if [ ! -f "$RESULT" ]; then continue; fi
         cat "$RESULT"
         cat "${RESULT%.result}.error"
      done
      printf '\nPartitions:\n'; cat /proc/partitions
      printf '\nFilesystem identities:\n'; cat /var/log/live-data/blkid
      printf '\nAvailable filesystems:\n'; cat /proc/filesystems
      printf '\nLoaded drivers:\n'; cat /proc/modules
      printf '\nKernel messages:\n'; dmesg
   } >/var/log/live-data.log 2>&1

   {
      printf 'Kernel: %s\nSearch: %s\n' "$(uname -r)" "$(cat /var/log/live-data/from)"
      printf 'Preferred UUID: %s\n' "${UUID:-none}"
      if [ "$(cmdline_value from)" != "" ]; then
         echo "Explicit from= overrides the UUID preference."
      elif [ "$(cmdline_value ip)" != "" ]; then
         echo "Network boot requested; local disks were not searched."
      elif [ "$UUID" != "" ]; then
         printf 'Preferred device: %s; other devices also tried.\n' "${PREFERRED:-not detected}"
      fi
      printf '\nDEVICE            FS/DRIVER LAST RESULT\n'
      awk -F '\t' -v preferred="$PREFERRED" '
         {line=sprintf("%-17s %-9s %s", $1, $2, $3)}
         $1==preferred {print line; next}
         {rows[++count]=line}
         END {for (i=1; i<=count; i++) print rows[i]}
      ' /var/log/live-data/devices | head -n 6
      if [ ! -s /var/log/live-data/devices ]; then echo "No physical block devices detected."; fi
      if [ "$(wc -l </var/log/live-data/devices)" -gt 6 ]; then echo "More devices in the full report."; fi
      ERROR=/var/log/live-data/$(echo "$PREFERRED" | tr / _).error
      if [ ! -s "$ERROR" ]; then
         for RESULT in /var/log/live-data/*.result; do
            if [ ! -f "$RESULT" ]; then continue; fi
            if grep -qi 'mount failed' "$RESULT" && [ -s "${RESULT%.result}.error" ]; then ERROR=${RESULT%.result}.error; break; fi
         done
      fi
      if [ -s "$ERROR" ]; then printf 'Error detail:\n'; head -n 1 "$ERROR"; fi
      printf 'Recent storage messages:\n'
      dmesg | grep -Ei 'nvme|vmd|ahci|ata[0-9]|scsi|sd[a-z]|mmc|ntfs|exfat|btrfs|I/O error|unknown filesystem|timeout|timed out|fail' | tail -n 3
      printf 'Full report: more /var/log/live-data.log\n'
   } | tr '\000-\010\013-\037\177' '?' | awk '
      length($0)>78 {while (length($0)>75 && sub(/ *[^ ]+$/, "")) {}; $0=$0"..."}
      {print}
   ' >/var/log/live-data/summary
}


# Check if data is found and exists
# $1 = data directory
#
check_data_found()
{
   if [ "$1" = "" -o ! -d "$1" ]; then
      data_diagnostics
      fatal "Could not locate $LIVEKITNAME data" /var/log/live-data/summary
   fi
}


# Format KiB as a size or free/total pair, sharing the total's unit up to TB.
perch_size()
{
   awk 'BEGIN {
      split("KB MB GB TB",units)
      free=ARGV[1]; value=ARGV[ARGC-1]; unit=1
      while (value>=1024 && unit<4) { free/=1024; value/=1024; unit++ }
      if (ARGC==3) printf "%.1f/",free
      printf "%.1f %s",value,units[unit]
   }' "$@"
}


# Check whether a session can use a native branch instead of a container.
perch_native_fs()
{
   local FILE STATUS

   if [ -e "$1/changes.dat" ]; then return 1; fi
   if ! device_bestfs "$(mounted_device "$1")" | grep -qv ntfs; then return 1; fi
   FILE=$(mktemp "$1/.posix.XXXXXX") || return 1
   STATUS=0
   ln -s "$FILE" "$FILE.link" 2>/dev/null && chmod +x "$FILE" 2>/dev/null && test -x "$FILE" && \
      chmod -x "$FILE" 2>/dev/null && test ! -x "$FILE" || STATUS=$?
   rm -f "$FILE" "$FILE.link"
   return "$STATUS"
}


# Locate existing session metadata without changing its storage layout.
perch_session_file()
{
   local FILE

   FILE=boot/session.txt
   if [ -e "$1/changes.dat" -o -f "$1/session.txt" ]; then FILE=session.txt; fi
   echo "$1/$FILE"
}


# Read a session name from the metadata path used by its storage layout.
perch_session_name()
{
   head -n 1 "$(perch_session_file "$1")" 2>/dev/null | tr -d '\r\n' | tr '\000-\037\177' ' '
}


# Read live restore points as timestamp, stable ID, UTF-8 name and automatic flag.
perch_restore_points()
{
   local CATALOG

   if [ "${2:-}" != "" ]; then
      CATALOG=$(cat "$2/snapshots.json") || return 1
   else
      CATALOG=$(@mount.dynfilefs -f "$1/changes.dat" --snapshots --json) || return 1
   fi
   # DynFileFS names cannot contain double quotes, backslashes or controls.
   printf '%s\n' "$CATALOG" | awk '
      BEGIN { RS="\"id\":"; FS="\"" }
      /^"/ && /,"deleted":false/ {
         id=$2; name=$0; created=$0
         sub(/.*,"name":"/,"",name); sub(/".*/,"",name)
         sub(/.*,"created":/,"",created); sub(/,.*/,"",created)
         printf "%s\t%s\t%s\t%d\n",created,id,name,(/,"automatic":true/ ? 1 : 0)
      }
   '
}


# Resolve a one-shot restore request by identity, never by a possibly reused name.
perch_restore_name()
{
   local ID POINTS NAME

   ID=$(cat "$1/restore.txt") || return 1
   if [ "${#ID}" -ne 16 ] || ! printf '%s\n' "$ID" | grep -qE '^[0-9a-f]+$'; then
      echo '* Invalid restore point identity in restore.txt.' >&2
      return 1
   fi
   if ! POINTS=$(perch_restore_points "$1"); then return 1; fi
   if ! NAME=$(printf '%s\n' "$POINTS" | awk -F '\t' -v id="$ID" '
      "x" $2=="x" id {print $3; found=1}
      END { if (!found) exit 1 }
   '); then
      echo '* The requested restore point is unavailable; restore.txt was kept.' >&2
      return 1
   fi
   printf '%s\n' "$NAME"
}


# Commit only an explicitly chosen restore point, or continue the current profile state.
perch_set_restore()
{
   local FILE TEMP

   FILE=$(perch_session_file "$1")
   FILE="${FILE%/*}/restore.txt"
   if [ "$2" = current ]; then
      if ! rm -f "$FILE"; then return 1; fi
      persistence save "$1" || return 1
      sync
      return 0
   fi
   TEMP=$(mktemp "${FILE%/*}/.restore.XXXXXX") || return 1
   if ! printf '%s\n' "$2" > "$TEMP" || ! chmod 644 "$TEMP" || ! mv "$TEMP" "$FILE"; then
      rm -f "$TEMP"
      echo '* Could not save the restore point selection.' >&2
      return 1
   fi
   sync
}


# Inspect history without mounting it; Esc leaves any previously queued request unchanged.
perch_choose_restore()
{
   local ROWS POINTS CHOICE TITLE CREATED ID NAME AUTOMATIC GUARD

   ROWS=$(mktemp /tmp/restore-points.XXXXXX) || return 1
   printf 'current\tCurrent state\tLatest changes\n' > "$ROWS"
   POINTS=""
   TITLE='No restore points for this profile'
   if [ -f "$1/changes.dat" ]; then
      if POINTS=$(perch_restore_points "$1"); then
         if [ "$POINTS" != "" ]; then TITLE='Start profile from'; fi
         printf '%s\n' "$POINTS" | sort -rn | while IFS="$(printf '\t')" read -r CREATED ID NAME AUTOMATIC; do
            if [ "$ID" = "" ]; then continue; fi
            # An interrupted reservation is not ownership if another point claimed its ID.
            GUARD="$1/guard.$ID"
            if [ -f "$GUARD" ] && [ ! -L "$GUARD" ] && [ "$(cat "$GUARD" 2>/dev/null)" = "$NAME" ]; then continue; fi
            if [ "$AUTOMATIC" = 1 ]; then NAME='Automatic restore point'; fi
            printf '%s\t%s\t%s\n' "$ID" "$NAME" "$(date -u -d "@$CREATED" '+%Y-%m-%d %H:%M:%S UTC')"
         done >> "$ROWS"
      else
         TITLE='Restore points could not be read'
      fi
   fi
   CHOICE=$(fbmenu --menu "$TITLE" "$ROWS" --cancel) || CHOICE=""
   rm -f "$ROWS"
   if [ "$CHOICE" = "" ]; then return 2; fi
   if [ "$CHOICE" != current ] && ! printf '%s\n' "$POINTS" | awk -F '\t' -v id="$CHOICE" '"x" $2=="x" id {found=1} END {exit !found}'; then return 1; fi
   perch_set_restore "$1" "$CHOICE"
}


# List sessions with sortable dates and optional disk-qualified menu values.
perch_session_rows()
{
   local DIR NAME LASTMOD USAGE

   ls -1 "$1" 2>/dev/null | grep -E '^[0-9]+$' | while read DIR; do
      if [ ! -d "$1/$DIR" ]; then continue; fi
      USAGE=$(perch_size "$(du -s -k "$1/$DIR" 2>/dev/null | awk '{print $1}')")
      LASTMOD="$(date -r "$1/$DIR" "+%Y-%m-%d %H:%M")"
      NAME=$(perch_session_name "$1/$DIR")
      printf '%s\t%s%s\t%s\t%s%s  %9s\n' "$LASTMOD" "${2:-}" "$DIR" "${NAME:-Profile #$DIR}" "${3:+$3  }" "$LASTMOD" "$USAGE"
   done
}


# Choose a session across writable filesystems and return its full path.
select_perch_session()
{
   local SCAN BOOTDEVICE BOOTDIR DEVICE FS DIR CHANDIR LABEL FREE CHOICE TITLE SESSION SELECTED LASTSESSION ERROR

   CHOICE="${2:-}"
   while true; do
      SCAN=$(mktemp -d "$MEMORY/session-disks.XXXXXX") || return 1
      BOOTDEVICE=$(mounted_device "$1")
      BOOTDIR=$(mounted_dir "$1")
      printf 'new\tStart a new profile\n' > "$SCAN/sessions.txt"
      touch "$SCAN/disks.txt"
      touch "$SCAN/resume.txt"
      refresh_devs
      blkid | sort | cut -d: -f 1 | grep -E -v '/loop|/ram|/zram' | while IFS= read -r DEVICE; do
         FS=$(device_bestfs "$DEVICE")
         if [ "$FS" = "" -o "$FS" = swap ]; then continue; fi
         DIR=$(mktemp -d "$SCAN/disk.XXXXXX") || exit 1
         if ! mount_device "$DEVICE" "$DIR" "$FS"; then continue; fi
         if ! awk -v dir="$DIR" '$2==dir {print $4}' /proc/mounts | grep -qE '(^|,)rw(,|$)'; then
            umount "$DIR" >&2
            continue
         fi

         CHANDIR="$DIR/$LIVEKITNAME/changes"
         if [ "$DEVICE" = "$BOOTDEVICE" ]; then CHANDIR="$DIR/${1#"$BOOTDIR/"}"; fi
         if [ "${2:-}" = resume ]; then
            LASTSESSION=$(cat "$CHANDIR/last_session.txt" 2>/dev/null || true)
            if echo "$LASTSESSION" | grep -qE '^[0-9]+$' && [ -d "$CHANDIR/$LASTSESSION" ]; then
               printf '%s\t%s/%s\n' "$(date -r "$CHANDIR/last_session.txt" +%s)" "$CHANDIR" "$LASTSESSION" >> "$SCAN/resume.txt"
            fi
            continue
         fi
         LABEL=$(blkid -s LABEL -o value "$DEVICE" | tr -d '\r\n' | tr '\000-\037\177' ' ')
         FREE=$(perch_size $(df -Pk "$DIR" | awk 'END {print $4, $2}'))
         printf '%s/new\t%s (%s)\t%s  %s free\n' "$CHANDIR" "$DEVICE" "${LABEL:-No label}" "$FS" "$FREE" >> "$SCAN/disks.txt"
         perch_session_rows "$CHANDIR" "$CHANDIR/" "$(basename "$DEVICE")"
      done | sort -r | cut -f 2- >> "$SCAN/sessions.txt"

      # Compare each disk's last-used marker before updating the selected session.
      if [ "$CHOICE" = resume ]; then CHOICE=$(sort -nr "$SCAN/resume.txt" | head -n 1 | cut -f 2-); fi
      SELECTED=""
      while true; do
         if [ "$CHOICE" != new -a "${2:-}" != resume ]; then
            CHOICE=$(fbmenu --menu 'Select profile' "$SCAN/sessions.txt" --cancel --restore) || break
         fi
         if [ "$CHOICE" = "" ]; then break; fi
         if [ "${CHOICE#restore:}" != "$CHOICE" ]; then
            DIR=${CHOICE#restore:}
            if ! perch_choose_restore "$DIR"; then CHOICE=""; continue; fi
            CHOICE="$DIR"
         elif [ "${2:-}" != resume -a "$CHOICE" != new ]; then
            # An explicit profile selection continues its current state, overriding a queued restore.
            if ! perch_set_restore "$CHOICE" current; then CHOICE=""; continue; fi
         fi
         if [ "$CHOICE" = new ]; then
            TITLE='Select disk for new profile'
            if [ ! -s "$SCAN/disks.txt" ]; then TITLE='No writable disks found'; fi
            CHOICE=$(fbmenu --menu "$TITLE" "$SCAN/disks.txt" --cancel --refresh) || break
            if [ "$CHOICE" = refresh ]; then break; fi
            if [ "$CHOICE" = "" ]; then continue; fi
         fi

         CHANDIR=${CHOICE%/*}
         SESSION=${CHOICE##*/}
         if SESSION=$(restore_perch_session "$CHANDIR" "$SESSION"); then
            DIR=$(mounted_dir "$CHANDIR")
            mkdir -p "$MEMORY/persistence"
            mount -o move "$DIR" "$MEMORY/persistence" || break
            SELECTED="$MEMORY/persistence/${CHANDIR#"$DIR/"}/$SESSION"
            break
         fi
         if [ "${2:-}" = resume ]; then break; fi
         CHOICE=""
      done

      # The selected mount was moved out; release the remaining scan mounts.
      ERROR=0
      for DIR in "$SCAN"/disk.*; do
         if mountpoint -q "$DIR" 2>/dev/null; then
            if ! umount "$DIR" >&2; then ERROR=1; fi
         fi
      done
      rm -f "$SCAN/disks.txt" "$SCAN/sessions.txt" "$SCAN/resume.txt"
      rmdir "$SCAN"/disk.* "$SCAN" 2>/dev/null
      if [ "$ERROR" != 0 -a "$CHOICE" = refresh ]; then return 1; fi

      # F5 releases the previous scan before rediscovering disks, then reopens this picker.
      if [ "$CHOICE" != refresh ]; then break; fi
      CHOICE=new
   done
   if [ "$SELECTED" = "" ]; then return 1; fi
   echo "$SELECTED"
}


# Restore persistent changes from previous session.
# Store persistent changes to a directory and keep the directory in a session file,
# so we know which session was active last time so we can resume it next time
# $1 = changes directory
# $2 = optional selection from the all-disks picker
#
restore_perch_session()
{
   debug_log "restore_perch_session" "$*"

   local TIMEOUT DEVICE FS MOUNT DEVROOT
   local CHANDIR PERCHDIR LAST LASTSESSION NEW NAME NAMEFILE TEMP

   CHANDIR="$1"
   PERCHDIR="${2:-$(cmdline_value perchdir)}"

   # Supported syntax is even like perchdir=/dev/sda1/changes
   # In this case, perchdir is mounted over $CHANDIR and is set to ask
   if echo "$PERCHDIR" | grep -q '^/dev/'; then
      DEVICE="$(echo "$PERCHDIR" | cut -d '/' -f 1-3)"
      PERCHDIR="$(echo "$PERCHDIR" | cut -d '/' -f 4-)"

      FS="$(device_bestfs "$DEVICE")"
      MOUNT="$(mount_command $FS)"
      DEVROOT="$MEMORY/persistence"
      mkdir -p "$DEVROOT"

      echo -n "* Waiting for persistent changes on $DEVICE .." >&2
      for TIMEOUT in $(seq 1 20); do
         echo -n "." >&2
         refresh_devs
         mount_device "$DEVICE" "$DEVROOT" "$FS"
         if [ $? -eq 0 ]; then
            if ! awk -v dir="$DEVROOT" '$2==dir {print $4}' /proc/mounts | grep -qE '(^|,)rw(,|$)'; then
               umount "$DEVROOT" >&2
               return 1
            fi
            if [ "$PERCHDIR" != "" -a "$PERCHDIR" != "/" ]; then
               mkdir -p "$DEVROOT/$PERCHDIR"
               $MOUNT --bind "$DEVROOT/$PERCHDIR" "$CHANDIR"
               if [ $? -eq 0 ]; then
                 echo -e "\n" >&2
                 PERCHDIR=ask
                 break
               fi
            else
               if $MOUNT --bind "$DEVROOT" "$CHANDIR"; then
                  echo -e "\n" >&2
                  PERCHDIR=ask
                  break
               fi
            fi
            umount "$DEVROOT" 2>/dev/null
         fi
         sleep 1
      done
   fi

   # Do not select or create a profile when its storage is not writable.
   if [ "${2:-}" = "" ]; then
      mkdir -p "$CHANDIR" 2>/dev/null || return 1
      touch "$CHANDIR/.empty" 2>/dev/null || return 1
      rm -f "$CHANDIR/.empty"
   fi

   LAST=last_session.txt
   LASTSESSION=$(cat "$CHANDIR/$LAST" 2>/dev/null || true)

   while true; do
      # Restore-point cancellation returns to the profile list.
      if [ "$PERCHDIR" = "ask" ]; then
         printf 'new\tStart a new profile\n' > /tmp/sessions.txt
         perch_session_rows "$CHANDIR" | sort -r | cut -f 2- >> /tmp/sessions.txt
         PERCHDIR="$(fbmenu --menu 'Select profile' /tmp/sessions.txt --cancel --restore)" || return 1
         # Cancellation must not create a session or update last_session.txt.
         if [ "$PERCHDIR" = "" ]; then return 1; fi
         if printf '%s\n' "$PERCHDIR" | grep -qE '^[0-9]+$'; then
            if ! perch_set_restore "$CHANDIR/$PERCHDIR" current; then PERCHDIR=ask; continue; fi
         fi
      fi

      if [ "${PERCHDIR#restore:}" != "$PERCHDIR" ]; then
         PERCHDIR=${PERCHDIR#restore:}
         if ! perch_choose_restore "$CHANDIR/$PERCHDIR"; then PERCHDIR=ask; continue; fi
      fi

      # restore name for previous session if empty
      if [ "$PERCHDIR" = "" -o "$PERCHDIR" = "resume" ]; then
         if [ "$LASTSESSION" != "" ] && ! printf '%s\n' "$LASTSESSION" | grep -qE '^[0-9]+$'; then
            echo '* Invalid saved profile selection.' >&2
            return 1
         fi
         PERCHDIR="$LASTSESSION"
      fi

      # Only New profile or an empty automatic resume can create a profile.
      if [ "$PERCHDIR" != "" -a "$PERCHDIR" != new ]; then
         if ! printf '%s\n' "$PERCHDIR" | grep -qE '^[0-9]+$' || [ ! -d "$CHANDIR/$PERCHDIR" ]; then
            echo '* The requested profile does not exist.' >&2
            return 1
         fi
      else
         NEW="$(ls -1 "$CHANDIR" 2>/dev/null | grep -E '^[0-9]+$' | sort -n | tail -n 1)"
         if [ "$PERCHDIR" = "" -a "$NEW" != "" ]; then
            echo '* No previous profile is selected; choose a profile during startup.' >&2
            return 1
         fi
         NAME=""
         if [ "$NEW" = "" ]; then NAME='Initial profile'; fi
         NEW=$(($NEW + 1))
         mkdir -p "$CHANDIR" || return 1
         TEMP=$(mktemp -d "$CHANDIR/.new.XXXXXX") || return 1
         # Native branches must remain accessible to unprivileged applications.
         chmod 755 "$TEMP" 2>/dev/null || true

         # Keep container metadata alongside changes.dat and native metadata under boot.
         NAMEFILE=boot/session.txt
         if ! perch_native_fs "$TEMP"; then NAMEFILE=session.txt; fi
         if ! mkdir -p "$(dirname "$TEMP/$NAMEFILE")" || ! printf '%s\n' "$NAME" > "$TEMP/$NAMEFILE" || ! mv "$TEMP" "$CHANDIR/$NEW"; then
            rm -rf "$TEMP"
            return 1
         fi
         PERCHDIR="$NEW"
      fi
      break
   done

   # remember current, update timestamp
   echo "$PERCHDIR" > "$CHANDIR/$LAST"
   touch "$CHANDIR/$PERCHDIR"
   echo "$PERCHDIR"
}


# Activate persistent changes
# $1 = data directory
# $2 = target changes directory
#
persistent_changes()
{
   debug_log "persistent_changes" "$*"

   local CHANGES T1 EXISTS PERCHDIR PERCHSIZE PERCHFILE DYNMNT REQUEST RESTORE TARGET RESTORE_ID START_ID AUTOMATIC

   CHANGES="$1/$(basename "$2")"

   # Setup the directory anyway, it will be used in all cases
   mkdir -p "$2"
   mkdir -p "$MEMORY/profile"
   chmod 700 "$MEMORY/profile"
   printf 'ram\n' > "$MEMORY/profile/kind"
   for T1 in profile changes dynfilefs start; do printf '\n' > "$MEMORY/profile/$T1"; done

   # If persistent changes are not requested, end here
   # so memory will be used to save chanves temporarily
   if ! grep -qE '(^|[[:space:]])perch([[:space:]]|dir=|$)' /proc/cmdline; then
      return
   fi

   # Keep the selected backing mount when an activation retry follows the recovery shell.
   if [ "${PERSISTENT_SESSION:-}" != "" ]; then
      CHANGES=${PERSISTENT_SESSION%/*}
      PERCHDIR=${PERSISTENT_SESSION##*/}
   else
      PERCHDIR=$(cmdline_value perchdir)
      if ! printf '%s\n' "$PERCHDIR" | grep -qE '^(resume|ask|new|[0-9]+|/dev/.+)?$'; then
         echo '* Invalid profile selection in perchdir.' >&2
         return 1
      fi
      if printf '%s\n' "$PERCHDIR" | grep -qE '^[0-9]+$' && [ ! -d "$CHANGES/$PERCHDIR" ]; then
         echo '* The requested profile does not exist.' >&2
         return 1
      fi
      if [ "$PERCHDIR" = resume ]; then
         T1=$(select_perch_session "$CHANGES" resume) || T1=""
         if [ "$T1" != "" ]; then
            CHANGES=${T1%/*}
            PERCHDIR=${T1##*/}
         else
            PERCHDIR=$(restore_perch_session "$CHANGES") || PERCHDIR=""
         fi
      elif [ "$PERCHDIR" = ask -o "$PERCHDIR" = new ]; then
         CHANGES=$(select_perch_session "$CHANGES" "$PERCHDIR") || CHANGES=""
         PERCHDIR=${CHANGES##*/}
         CHANGES=${CHANGES%/*}
      else
         PERCHDIR=$(restore_perch_session "$CHANGES") || PERCHDIR=""
      fi
   fi
   if [ "$PERCHDIR" = "" ]; then
      echo "* Persistent changes disabled; using RAM for changes"
      return 0
   fi
   PERSISTENT_SESSION="$CHANGES/$PERCHDIR"

   T1="$CHANGES/.empty"

   # check if changes directory exists and is writable
   touch "$T1" 2>/dev/null && rm -f "$T1" 2>/dev/null

   # if not, simply return back
   if [ $? -ne 0 ]; then
      echo "* Persistent changes not writable or not used"
      return 1
   fi

   REQUEST=$(perch_session_file "$CHANGES/$PERCHDIR")
   REQUEST="${REQUEST%/*}/restore.txt"
   RESTORE=""
   RESTORE_ID=$(persistence target "${REQUEST%/*}") || return 1
   if [ "$RESTORE_ID" != "" ]; then
      if [ -L "$REQUEST" ]; then
         echo '* The restore point request restore.txt must be a regular file.' >&2
         return 1
      fi
      if [ ! -f "$CHANGES/$PERCHDIR/changes.dat" ]; then
         echo '* Restore points require a container-backed profile.' >&2
         return 1
      fi
      T1=$(perch_restore_points "$CHANGES/$PERCHDIR") || return 1
      RESTORE=$(printf '%s\n' "$T1" | awk -F '\t' -v id="$RESTORE_ID" '"x" $2=="x" id {print $3; found=1} END {exit !found}') || return 1
      AUTOMATIC=$(printf '%s\n' "$T1" | awk -F '\t' -v id="$RESTORE_ID" '"x" $2=="x" id {print $4}')
   fi

   # try to use native fs if posix-compatible
   echo_green_star
   echo "Testing persistent changes for posix compatibility"
   if perch_native_fs "$CHANGES/$PERCHDIR"; then
      echo "* Activating native persistent changes for profile #$PERCHDIR"
      mount --bind "$CHANGES/$PERCHDIR" "$2" || return 1
      printf 'native\n' > "$MEMORY/profile/kind"
      printf '%s\n' "/run/initramfs$CHANGES/$PERCHDIR" > "$MEMORY/profile/profile"
      printf '%s\n' "/run/initramfs$2" > "$MEMORY/profile/changes"
      return 0
   fi


   # Round total backing capacity up to GiB; the initial XFS image needs 16000 MiB.
   PERCHSIZE=$(df -Pk "$CHANGES" | awk 'END {
      size=int(($2 + 1048575) / 1048576) * 1024
      if (size < 16000) size=16000
      printf "%.0f\n",size
   }')

   PERCHFILE="$PERCHDIR/changes.dat"

   # resume or use new
   if [ -e "$CHANGES/$PERCHFILE" ]; then
      echo "* Resuming persistent changes for profile #$PERCHDIR"
      EXISTS="true"
      if ! T1=$(@mount.dynfilefs -i -f "$CHANGES/$PERCHFILE"); then return 1; fi
      T1=$(printf '%s\n' "$T1" | sed -n 's/^sizeMiB://p')
      if [ "$RESTORE" = "" -a "$T1" -gt "$PERCHSIZE" ]; then PERCHSIZE=$T1; fi
   else
      echo "* Creating new persistent changes for profile #$PERCHDIR"
      EXISTS=""
   fi

   # Use FAT32-sized parts for new storage; existing storage retains its split size.
   echo "- mounting dynamically enlarged storage"

   # Keep FUSE visible so shutdown uses its own filesystem options.
   DYNMNT="$2.dfs"
   mkdir -p "$DYNMNT"
   if mountpoint -q "$2" || mountpoint -q "$DYNMNT"; then
      echo '* Persistent storage is still mounted; unmount it before retrying.' >&2
      return 1
   fi
   TARGET="$2"
   # Preserve recovered current data before restore; protection precedes DynFileFS's startup pruning.
   if [ "$RESTORE_ID" != "" ] && { [ -e "$CHANGES/$PERCHDIR/keep-current.$RESTORE_ID" ] || [ -L "$CHANGES/$PERCHDIR/keep-current.$RESTORE_ID" ]; }; then
      @mount.dynfilefs -f "$CHANGES/$PERCHFILE" -m "$DYNMNT" --protect "$RESTORE_ID" || return 1
      # Replay an interrupted XFS journal, then capture a clean filesystem without live writers.
      if ! mount -t xfs -o loop "$DYNMNT/virtual.dat" "$TARGET"; then umount "$DYNMNT"; return 1; fi
      if ! umount "$TARGET"; then return 1; fi
      if ! persistence prepare "$CHANGES/$PERCHDIR" "$DYNMNT"; then umount "$DYNMNT"; return 1; fi
      umount "$DYNMNT" || return 1
   fi
   set -- -f "$CHANGES/$PERCHFILE" -s "$PERCHSIZE" -m "$DYNMNT" -p 4000
   if [ "$RESTORE" != "" ]; then
      echo "* Restoring profile from: $RESTORE"
      set -- "$@" --restore "$RESTORE"
      if [ "$AUTOMATIC" = 1 ]; then set -- "$@" --protect "$RESTORE_ID"; fi
   fi
   if ! @mount.dynfilefs "$@"; then return 1; fi
   if [ ! "$EXISTS" ]; then
      echo "- creating filesystem"
      if ! mkfs.xfs.custom "$DYNMNT/virtual.dat"; then umount "$DYNMNT"; return 1; fi
      # The new store's first automatic point predates formatting and cannot boot a profile.
      if ! T1=$(cat "$DYNMNT/snapshot") || ! printf 'delete %s\n' "$T1" > "$DYNMNT/snapshot"; then
         umount "$DYNMNT"
         return 1
      fi
   fi

   echo "- mounting persistent changes"
   if mount -t xfs -o loop "$DYNMNT/virtual.dat" "$TARGET"; then
      # Check XFS too, including a previous boot interrupted after container growth.
      if xfs_growfs "$TARGET" >/dev/null; then
         if START_ID=$(persistence start "$CHANGES/$PERCHDIR" "$DYNMNT"); then
            printf 'container\n' > "$MEMORY/profile/kind"
            printf '%s\n' "/run/initramfs$CHANGES/$PERCHDIR" > "$MEMORY/profile/profile"
            printf '%s\n' "/run/initramfs$TARGET" > "$MEMORY/profile/changes"
            printf '%s\n' "/run/initramfs$DYNMNT" > "$MEMORY/profile/dynfilefs"
            printf '%s\n' "$START_ID" > "$MEMORY/profile/start"
            return 0
         fi
      fi
      if ! umount "$TARGET"; then return 1; fi
   fi
   umount "$DYNMNT"
   return 1
}


# Copy content of rootcopy directory to union
# $1 = data directory
# $2 = union directory
copy_rootcopy_content()
{
   debug_log "copy_rootcopy_content" "$*"

   if [ "$(ls -1 "$1/rootcopy/" 2>/dev/null)" != "" ]; then
      echo_green_star
      echo "Copying content of rootcopy directory..."
      cp -a "$1"/rootcopy/* "$2"
   fi
}


# Run user custom preinit script if it exists
# $1 = data directory
# $2 = union directory
user_preinit()
{
   debug_log "user_preinit" "$*"

   local SRC

   SRC="$1/rootcopy/run/preinit.sh"

   if [ "$(ls -1 "$SRC" 2>/dev/null)" != "" ]; then
      echo_green_star
      echo "Executing user custom preinit..."
      debug_log "Executing user custom preinit [$SRC]"
      . "$SRC" "$2"
   fi
}


# Copy data to RAM if requested
# $1 = live data directory
# $2 = changes directory
#
copy_to_ram()
{
   debug_log "copy_to_ram" "$*"

   local MDIR MDEV RAM CHANGES LOOP

   if grep -vq toram /proc/cmdline; then
      echo "$1"
      return
   fi

   echo "* Copying $LIVEKITNAME data to RAM..." >&2
   RAM="$(dirname "$2")"/toram
   mkdir  -p "$RAM"
   cp -a "$1"/* "$RAM"
   echo "$RAM"

   MDIR="$(mounted_dir "$1")"
   LOOP="$(mounted_device "$1")"
   # BusyBox prints the backing filename after the device and offset fields.
   MDEV="$(losetup "$LOOP" 2>/dev/null | sed 's/^[^ ]* [^ ]* //')"
   if umount "$MDIR" 2>/dev/null; then
      if [ "$MDEV" ]; then
         losetup -d "$LOOP" 2>/dev/null
         MDIR="$(mounted_dir "$MDEV")"
         umount "$MDIR" 2>/dev/null
      fi
   fi
}


# load filter
#
filter_load()
{
   local FILTER
   FILTER=$(cmdline_value load)
   if [ "$FILTER" = "" ]; then
      cat -
   else
      cat - | egrep "$FILTER"
   fi
}


# noload filter
#
filter_noload()
{
   local FILTER
   FILTER=$(cmdline_value noload)
   FILTER=${FILTER//,/|}
   if [ "$FILTER" = "" ]; then
      cat -
   else
      cat - | egrep -v "$FILTER"
   fi
}

# sort modules by number even if they are in subdirectory
#
sortmod()
{
   cat - | sed -r "s,(.*/(.*)),\\2:\\1," | sort -n | cut -d : -f 2-
}


# Mount squashfs filesystem bundles
# $1 = directory where to search for bundles
# $2 = directory where to mount bundles
mount_bundles()
{
   echo_green_star
   echo "Mounting bundles"
   ( ls -1 "$1" | sort -n ; cd "$1" ; find modules/ 2>/dev/null | sortmod | filter_load) | grep '[.]'$BEXT'$' | filter_noload | while read BUNDLE; do
      echo "* $BUNDLE"
      BUN="$(basename "$BUNDLE")"
      mkdir -p "$2/$BUN"
      mount -o loop,ro -t squashfs "$1/$BUNDLE" "$2/$BUN"
   done
}


# Add mounted bundles to aufs union
# $1 = directory where bundles are mounted
# $2 = directory where union is mounted
#
union_append_bundles()
{
   debug_log "union_append_bundles" "$*"

   if aufs_is_supported >/dev/null; then
      echo_green_star
      echo "Adding bundles to union"
      find "$1" -mindepth 1 -maxdepth 1 | sortmod | while read BUNDLE; do
         mount -o remount,add:1:"$BUNDLE=rr+wh" aufs "$2"
      done
   fi
}


# Create empty fstab properly
# $1 = root directory
#
fstab_create()
{
   debug_log "fstab_create" "$*"

   local FSTAB DEVICE FS LABEL MOUNTPOINT OPTS

   FSTAB="$1/etc/fstab"
   if aufs_is_supported >/dev/null; then
      echo aufs / aufs defaults 0 0 > "$FSTAB"
   else
      echo overlay / overlay defaults 0 0 > "$FSTAB"
   fi
   echo proc /proc proc defaults 0 0 >> $FSTAB
   echo sysfs /sys sysfs defaults 0 0 >> $FSTAB
   echo devpts /dev/pts devpts gid=5,mode=620 0 0 >> $FSTAB
   echo tmpfs /dev/shm tmpfs defaults 0 0 >> $FSTAB

   # Keep generated media paths out of persistent changes on every boot.
   mkdir -p "$1/media"
   mount -t tmpfs -o mode=755 tmpfs "$1/media"

   if grep -qw noautomount /proc/cmdline || ! grep -qw automount /proc/cmdline; then
      return
   fi

   echo >> $FSTAB

   blkid | grep -v "^/dev/loop" | grep -v "^/dev/zram" | cut -d: -f 1 | while read DEVICE; do
      LABEL="$(basename $DEVICE)"
      # A hybrid image also exposes its partition's filesystem on the whole disk.
      if ls "/sys/class/block/$LABEL"/*/partition >/dev/null 2>&1; then
         continue
      fi

      FS="$(device_bestfs $DEVICE)"
      OPTS="defaults,noatime,nofail,x-systemd.device-timeout=10"

      if [ "$FS" != "" -a "$FS" != "swap" -a "$FS" != "squashfs" ]; then
         MOUNTPOINT=$(awk -v dev="$DEVICE" '$1==dev {print $2; exit}' /proc/mounts)

         if [ "$MOUNTPOINT" != "" ]; then
            # Keep boot and session storage mounted until initramfs shutdown.
            ln -s "/run/initramfs$MOUNTPOINT" "$1/media/$LABEL"
         else
            mkdir -p "$1/media/$LABEL"
            echo "$DEVICE" "/media/$LABEL" $FS $OPTS 0 0 >> $FSTAB
         fi
      fi
   done
}


# Change root and execute init
# $1 = where to change root
#
change_root()
{
   debug_log "change_root" "$*"
   local LOG
   if [ -e /run/bootsplash.disabled ]; then splash_disable; fi

   # if we are booting over httpfs, we need to copyup some files so they are
   # accessible on union without any further lookup down, else httpfs locks
   if [ "$(network_device)" != "" ]; then
      touch "/net.up.flag"
      touch "$1/etc/resolv.conf"
      touch "$1/etc/hosts"
      touch "$1/etc/gai.conf"
   fi

   umount /proc
   umount /sys

   cd "$1"

   # make sure important device files and directories are in union
   mkdir -p boot dev proc sys tmp media mnt run
   chmod 1777 tmp
   if [ ! -e dev/console ]; then mknod dev/console c 5 1; fi
   if [ ! -e dev/tty ]; then mknod dev/tty c 5 0; fi
   if [ ! -e dev/tty0 ]; then mknod dev/tty0 c 4 0; fi
   if [ ! -e dev/tty1 ]; then mknod dev/tty1 c 4 1; fi
   if [ ! -e dev/null ]; then mknod dev/null c 1 3; fi
   if aufs_is_supported >/dev/null; then
      if [ ! -e sbin/fsck.aufs ]; then ln -s /bin/true sbin/fsck.aufs; fi
   else
      if [ ! -e sbin/fsck.overlay ]; then ln -s /bin/true sbin/fsck.overlay; fi
   fi

   # find chroot and init
   if [ -x bin/chroot -o -L bin/chroot ]; then  CHROOT=bin/chroot; fi
   if [ -x sbin/chroot -o -L sbin/chroot ]; then  CHROOT=sbin/chroot; fi
   if [ -x usr/bin/chroot -o -L usr/bin/chroot ]; then  CHROOT=usr/bin/chroot; fi
   if [ -x usr/sbin/chroot -o -L usr/sbin/chroot ]; then CHROOT=usr/sbin/chroot; fi
   if [ "$CHROOT" = "" ]; then fatal "Can't find executable chroot command"; fi

   if [ -x bin/init -o -L bin/init ]; then INIT=bin/init; fi
   if [ -x sbin/init -o -L sbin/init  ]; then INIT=sbin/init; fi
   if [ "$INIT" = "" ]; then fatal "Can't find executable init command"; fi

   mkdir -p run
   # Preserve initramfs diagnostics in the booted system, including text boots.
   mkdir -p var/log
   for LOG in boot.log livedbg from.log; do
      if [ -f "/var/log/$LOG" ]; then cp "/var/log/$LOG" "var/log/$LOG"; fi
   done
   mount -t tmpfs tmpfs run
   # Let the splash release the initrd and follow startup until a console or X takes over.
   if [ "$SPLASH_PID" ]; then
      cp /bin/fbmenu run/fbmenu
      cp -a /lib/bootsplash run/bootsplash
      if [ ! -e dev/fb0 ]; then mknod dev/fb0 c 29 0; fi
      fbmenu --handoff "$1" || splash_disable
      SPLASH_PID=
   fi
   mkdir -p run/initramfs
   if aufs_is_supported >/dev/null; then
      mount -n -o remount,ro aufs .
   fi
   pivot_root . run/initramfs
   # The system init must not inherit the initrd's saved console descriptors.
   if [ "$SPLASH_LOG" ]; then exec 3>&- 4>&-; SPLASH_LOG=; fi
   exec $CHROOT . $INIT < dev/console > dev/console 2>&1
}
