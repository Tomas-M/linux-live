#!/bin/sh
# Compile native frontends with an older Linux ABI and system-only Windows imports.
set -eu
THIS=$(CDPATH= cd "$(dirname "$0")" && pwd)
OUT=${1:-$THIS/../installers}
TEMP=$(mktemp -d "${TMPDIR:-/tmp}/slax-installer.XXXXXX")
LINUX_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/slax-installer-linux.XXXXXX")
trap 'rm -r "$TEMP" "$LINUX_ROOT"' 0
mkdir -p "$OUT"
unshare --mount --propagation private sh "$THIS/build-linux-root" "$LINUX_ROOT"

# Embed the original PNG artwork without an image conversion or runtime data files.
python3 - "$THIS" "$TEMP/images.h" <<'PY'
from pathlib import Path
import sys
folder=Path(sys.argv[1])
with Path(sys.argv[2]).open('w') as header:
    for name in ('clover','wordmark','hard_drive','usb','layer_group','check','triangle_exclamation'):
        path=folder/(name+'.png') if name in ('clover','wordmark') else folder/'icons'/(name.replace('_','-')+'.png')
        data=path.read_bytes()
        header.write('static const unsigned char '+name+'_png[]={'+','.join(map(str,data))+'};\n')
    header.write('static const struct {const unsigned char *data; unsigned size;} installer_images[]={\n')
    for name in ('clover','wordmark','hard_drive','usb','layer_group','check','triangle_exclamation'):
        header.write('{'+name+'_png,sizeof('+name+'_png)},\n')
    header.write('};\n')
PY

# Build matching native BIOS tools as one trusted, compressed media payload.
sh "$THIS/build-grub" "$TEMP/grub" "$TEMP/grub-bios.tar.xz" "$TEMP/grub-assets-digest.h" "$LINUX_ROOT"

# Keep every Linux input, including the static C++ runtime, on the same old baseline.
bwrap --bind "$LINUX_ROOT" / --bind "$TEMP" /build --ro-bind "$THIS" /installer --dev /dev --proc /proc \
   --unshare-pid --die-with-parent --setenv PATH /usr/sbin:/usr/bin:/sbin:/bin /bin/sh -ec '
   g++-8 -std=c++17 -Os -Wall -Wextra -Werror -Wno-deprecated-declarations -pthread \
      -static-libstdc++ -static-libgcc -ffunction-sections -fdata-sections -Wl,--gc-sections \
      -I/build $(pkg-config --cflags gtk+-3.0 libudev blkid liblzma | sed "s/-I/-isystem /g") \
      /installer/main.cpp /installer/image.cpp /installer/install.cpp /installer/boot-menu.cpp /installer/disk-format.cpp /installer/firmware.cpp \
      /installer/linux-storage.cpp /installer/linux.cpp /installer/grub-assets.cpp -Wl,-Bstatic -lstdc++fs -Wl,-Bdynamic \
      $(pkg-config --libs gtk+-3.0 libudev blkid liblzma) -o /build/slax-install-linux
'
strip "$TEMP/slax-install-linux"

# Helpers must not require newer shared-library symbols than the installer that launches them.
python3 - "$TEMP" <<'PY'
from pathlib import Path
import re,subprocess,sys
root=Path(sys.argv[1]);installer=root/'slax-install-linux'
info=subprocess.check_output(['readelf','-l','-d',str(installer)],text=True)
if 'INTERP' not in info or not {'libc.so.6','liblzma.so.5'}<=set(re.findall(r'\(NEEDED\).*\[(.*?)\]',info)): sys.exit('Linux installer must use shared libc and liblzma')
if re.search(r'\((?:RPATH|RUNPATH)\)',info): sys.exit('Linux installer has a private library path')
baseline=subprocess.check_output(['readelf','--version-info',str(installer)],text=True)
if {'libstdc++.so.6','libgcc_s.so.1'}&set(re.findall(r'\(NEEDED\).*\[(.*?)\]',info)): sys.exit('Linux C++ runtimes must be static')
required=max((tuple(map(int,version.split('.'))) for version in re.findall(r'\bGLIBC_([0-9]+(?:\.[0-9]+)+)\b',baseline)),default=())
if required>(2,27): sys.exit('Linux installer requires glibc newer than 2.27')
for tool in (root/'grub/assets/linux').iterdir():
    info=subprocess.check_output(['readelf','--version-info',str(tool)],text=True)
    for library in ('GLIBC','XZ'):
        pattern=rf'\b{library}_([0-9]+(?:\.[0-9]+)+)\b'
        required=max((tuple(map(int,version.split('.'))) for version in re.findall(pattern,info)),default=())
        supported=max((tuple(map(int,version.split('.'))) for version in re.findall(pattern,baseline)),default=())
        if required>supported: sys.exit(f'{tool.name} requires {library}_{".".join(map(str,required))}, newer than the installer')
PY

# Give the ordinary PE executable a clear identity in Windows file properties.
python3 - "$THIS" "$TEMP/resource.rc" <<'PY'
from pathlib import Path
import sys
folder=Path(sys.argv[1]);version=(folder/'../rootcopy/etc/slax-version').read_text().split()[1]
numbers=version.replace('.',',')+',0,0'
Path(sys.argv[2]).write_text(f'''#include <windows.h>
1 ICON "{folder}/slax.ico"
2 ICON "{folder}/icons/triangle-exclamation.ico"
1 24 "{folder}/installer.manifest"
1 VERSIONINFO
FILEVERSION {numbers}
PRODUCTVERSION {numbers}
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Slax"
      VALUE "FileDescription", "Slax Installer"
      VALUE "FileVersion", "{version}"
      VALUE "InternalName", "slax-install"
      VALUE "OriginalFilename", "slax-install.exe"
      VALUE "ProductName", "Slax"
      VALUE "ProductVersion", "{version}"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
''')
PY
i686-w64-mingw32-windres "$TEMP/resource.rc" "$TEMP/resource.o"
i686-w64-mingw32-g++-posix -std=c++17 -Os -Wall -Wextra -Werror -Wno-cast-function-type \
   -municode -mwindows -static -D_WIN32_WINNT=0x0501 -I"$TEMP" -I"$TEMP/grub/windows/sysroot/include" \
   -Wl,--nxcompat,--dynamicbase,--no-insert-timestamp,--major-subsystem-version,5,--minor-subsystem-version,1 \
   "$THIS/main.cpp" "$THIS/image.cpp" "$THIS/install.cpp" "$THIS/boot-menu.cpp" "$THIS/disk-format.cpp" "$THIS/firmware.cpp" \
   "$THIS/windows-storage.cpp" "$THIS/windows.cpp" "$THIS/grub-assets.cpp" "$TEMP/resource.o" "$TEMP/grub/windows/sysroot/lib/liblzma.a" \
   -lgdiplus -lsetupapi -lcomdlg32 -lcomctl32 -lshell32 -lole32 -ladvapi32 -lgdi32 -luuid -o "$TEMP/slax-install.exe"
i686-w64-mingw32-strip "$TEMP/slax-install.exe"
install -m 755 "$TEMP/slax-install-linux" "$TEMP/slax-install.exe" "$OUT/"
install -m 644 "$TEMP/grub-bios.tar.xz" "$OUT/"
