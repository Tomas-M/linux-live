#!/bin/sh
set -e
THIS=$(CDPATH= cd "$(dirname "$0")" && pwd)
KIT=$(CDPATH= cd "$THIS/../.." && pwd)
. "$THIS/aufs-kernel-compile/versions"
. /etc/os-release
if [ "$(id -u)" != 0 ] || [ "$ID" != debian ] || [ "$(uname -m)" != x86_64 ]; then
   echo "Run this build as root on amd64 Debian." >&2
   exit 1
fi

export TMPDIR=/tmp
SUITE=${1:-trixie}
case "$SUITE" in ''|*[!a-z0-9-]*) echo "Use a Debian suite name, for example trixie." >&2; exit 1;; esac
mkdir -p "${2:-/var/tmp/slax-build-$SUITE}"
WORK=$(CDPATH= cd "${2:-/var/tmp/slax-build-$SUITE}" && pwd)
# Keep simultaneous builds from sharing output files.
exec 9>"$WORK/build.lock"
flock -n 9 || { echo "Another build is using $WORK." >&2; exit 1; }
IMAGE=$WORK/kernel/linux-image-${KERNELRELEASE}_${KERNELVERSION}-slax_amd64.deb

# Prepare the host kernel first, then continue with the same command after reboot.
if [ ! -f "$IMAGE" ] || [ "$(uname -r)" != "$KERNELRELEASE" ]; then
   if [ ! -f "$IMAGE" ]; then sh "$THIS/aufs-kernel-compile/compile" "$WORK/kernel"; fi
   apt-get install -y initramfs-tools
   dpkg -i "$IMAGE"
   printf 'Reboot into %s, then run this command again.\n' "$KERNELRELEASE"
   exit 0
fi
grep -qw aufs /proc/filesystems
apt-get update
apt-get install -y --no-install-recommends debootstrap squashfs-tools xorriso mtools \
   grub-pc-bin grub-efi-amd64-bin grub-common xz-utils cpio git make gcc libc6-dev

BUILD=$(mktemp -d /tmp/slax-build.XXXXXX)
trap 'rm -r "$BUILD"' 0
trap 'exit 130' INT
trap 'exit 143' TERM

# AUFS utilities preserve hardlinks when a completed branch becomes read-only.
git clone https://git.code.sf.net/p/aufs/aufs-util "$BUILD/aufs-util"
git -C "$BUILD/aufs-util" checkout --detach "$AUFSUTILCOMMIT"
# Use packaged UAPI headers because the kernel build tree is discarded.
dpkg-deb -x "$WORK/kernel/linux-libc-dev_${KERNELVERSION}-slax_amd64.deb" "$BUILD/kernel-headers"
make -C "$BUILD/aufs-util" CPPFLAGS="-I$BUILD/kernel-headers/usr/include -I$BUILD/kernel-headers/usr/include/x86_64-linux-gnu" auplink
PATH=$BUILD/aufs-util:$PATH
export PATH
MEDIA=$BUILD/media
unshare --mount --propagation private sh "$THIS/buildmods" "$SUITE" "$BUILD" "$IMAGE" "$MEDIA"

# Build the boot assets from the host's matching kernel, outside the Debian root.
cp "$KIT/config" "$BUILD/config"
printf '\nLIVEKITNAME=slax\nNETWORK=true\nKERNEL=$(uname -r)\nLMK=lib/modules/$KERNEL\nBEXT=sb\n' >> "$BUILD/config"
BOOT=$MEDIA/slax/boot
mkdir -p "$BOOT" "$MEDIA/slax/changes"
cp -a "$KIT/bootfiles/." "$BOOT/"
cp -a "$THIS/bootfiles/." "$BOOT/"
cp "/boot/vmlinuz-$(uname -r)" "$BOOT/vmlinuz"
cd "$KIT/initramfs"
INITRAMFS=$(LIVEKITCONFIG="$BUILD/config" SPLASH="$THIS/bootsplash" sh ./initramfs_create)
mv "$INITRAMFS" "$BOOT/initrfs.img"
sh "$KIT/tools/grub.create" "$MEDIA" slax
sh "$BOOT/grub/makeiso.sh" "$BUILD/slax-amd64.iso"
# Publish the completed ISO atomically; keep small package manifests alongside it.
cp -a "$BUILD/manifests" "$WORK/"
cp "$BUILD/slax-amd64.iso" "$WORK/slax-amd64.iso.part"
mv "$WORK/slax-amd64.iso.part" "$WORK/slax-amd64.iso"
printf 'ISO: %s/slax-amd64.iso\nBuild directory: %s\n' "$WORK" "$BUILD"
# Keep the completed media tree and filesystem branches for further edits.
trap - 0
