#!/bin/sh
set -e
[ -f /build/buildmods ] || { echo "Run Slax's build script instead of install." >&2; exit 1; }

apt-get update
# ConnMan handles NTP; the EFI compiler stays on the build host.
# Install Wacom data here so Xorg can reuse the complete hardware database.
# PXE needs GNU cpio and BusyBox's HTTP server; both reuse the existing libc6.
# fdisk supplies sfdisk for marking the USB EFI partition on GPT disks.
apt-get install --yes --no-install-recommends systemd-sysv udev libwacom-common dbus login passwd tzdata locales kmod \
mc squashfs-tools xorriso grub2-common grub-pc-bin zip unzip 7zip 7zip-rar psmisc net-tools iproute2 \
alsa-utils alsa-ucm-conf tmux man less xz-utils ca-certificates openssl acpid acpi-support-base powermgmt-base bzip2 gpart \
hdparm sdparm eject mdadm smartmontools nvme-cli dosfstools fdisk lsof htop gddrescue partclone testdisk rsync netcat-openbsd ssh gpm wireless-tools \
ntfs-3g rfkill file dnsmasq cpio busybox dvd+rw-tools usb-modeswitch pm-utils wget virt-what wpasupplicant connman \
e2fsprogs exfatprogs btrfs-progs lvm2 cryptsetup-bin iputils-ping bind9-dnsutils traceroute ethtool iw usbutils tcpdump \
linux-image-amd64


ln -sf bash /bin/sh
# Create the guest account with ALSA access for Chromium and VLC.
useradd -m -g users -G audio -s /bin/bash guest
printf 'root:toor\nguest:guest\n' | chpasswd

# Keep only the ACPI scripts, without pulling in another desktop.
cd /tmp
apt-get download acpi-support
mkdir acpisupport
dpkg -x acpi-support*.deb acpisupport
cp -a acpisupport/. /
