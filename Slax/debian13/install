#!/bin/sh
set -e
[ -f /build/buildmods ] || { echo "Run Slax's build script instead of install." >&2; exit 1; }

apt-get update
apt-get install --yes --no-install-recommends systemd-sysv udev dbus tzdata locales kmod \
mc squashfs-tools xorriso mtools grub-pc-bin grub-efi-amd64-bin zip unzip psmisc net-tools \
alsa-utils man less xz-utils ca-certificates openssl acpid acpi-support-base powermgmt-base bzip2 gpart \
hdparm sdparm mdadm smartmontools dosfstools lsof htop gddrescue rsync netcat-openbsd ssh gpm wireless-tools \
ntfs-3g rfkill file dnsmasq ntpsec-ntpdate dvd+rw-tools usb-modeswitch pm-utils wget virt-what wpasupplicant connman \
/artifacts/kernel.deb

ln -sf bash /bin/sh
# The old installer-created accounts must now be part of the bootstrapped core.
useradd -m -g users -s /bin/bash guest
printf 'root:toor\nguest:guest\n' | chpasswd

# Keep only the ACPI scripts, without pulling in another desktop.
cd /tmp
apt-get download acpi-support
mkdir acpisupport
dpkg -x acpi-support*.deb acpisupport
cp -a acpisupport/. /
