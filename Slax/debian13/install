#!/bin/sh
set -e
[ -f /build/buildmods ] || { echo "Run Slax's build script instead of install." >&2; exit 1; }

apt-get update
# ConnMan handles NTP; EFI images and mtools are only needed on the build host.
apt-get install --yes --no-install-recommends systemd-sysv udev dbus login passwd tzdata locales kmod \
mc squashfs-tools xorriso grub2-common grub-pc-bin zip unzip psmisc net-tools iproute2 \
alsa-utils man less xz-utils ca-certificates openssl acpid acpi-support-base powermgmt-base bzip2 gpart \
hdparm sdparm mdadm smartmontools dosfstools lsof htop gddrescue rsync netcat-openbsd ssh gpm wireless-tools \
ntfs-3g rfkill file dnsmasq dvd+rw-tools usb-modeswitch pm-utils wget virt-what wpasupplicant connman \
/artifacts/kernel.deb

# Keep the AUFS kernel paired with the modules shipped in the live image.
apt-mark hold "$(dpkg-deb -f /artifacts/kernel.deb Package)"

ln -sf bash /bin/sh
# Create the guest account with ALSA access for Chromium and VLC.
useradd -m -g users -G audio -s /bin/bash guest
printf 'root:toor\nguest:guest\n' | chpasswd

# Keep only the ACPI scripts, without pulling in another desktop.
cd /tmp
apt-get download acpi-support
mkdir acpisupport
dpkg -x acpi-support*.deb acpisupport
cp -a acpisupport/. /
