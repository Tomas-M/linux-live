#!/bin/sh
set -ex
AUFSURL=https://github.com/sfjro/aufs-standalone.git
CWD=$(CDPATH= cd "$(dirname "$0")" && pwd)
. "$CWD/versions"
export TMPDIR=/tmp
mkdir -p "${1:-/usr/src/slax-kernel}"
OUTPUT=$(CDPATH= cd "${1:-/usr/src/slax-kernel}" && pwd -P)
# Only one compiler may write packages to this directory at a time.
exec 8>"$OUTPUT/compile.lock"
flock -n 8 || { echo "A kernel build is already using $OUTPUT." >&2; exit 1; }

apt-get update
apt-get install -y build-essential bc kmod cpio flex libdw-dev libelf-dev libssl-dev dwarves bison git rsync python3 openssl debhelper fakeroot curl ca-certificates xz-utils patch

BUILD=$(mktemp -d /tmp/slax-kernel.XXXXXX)
trap 'rm -r "$BUILD"' 0
trap 'exit 130' INT
trap 'exit 143' TERM

# Prepare and compile the entire source tree in RAM; only packages go to disk.
mkdir "$BUILD/source"
cd "$BUILD/source"
curl -fL "https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-$KERNELVERSION.tar.xz" -o "linux-$KERNELVERSION.tar.xz"
echo "$KERNELSHA256  linux-$KERNELVERSION.tar.xz" | sha256sum -c -
tar -xf "linux-$KERNELVERSION.tar.xz" --strip-components=1
rm "linux-$KERNELVERSION.tar.xz"
cp "$CWD/config-x86_64" .config

git init aufs
git -C aufs remote add origin "$AUFSURL"
git -C aufs fetch --depth=1 origin "$AUFSCOMMIT"
git -C aufs checkout --detach FETCH_HEAD
cp -a aufs/fs .
cp -a aufs/Documentation/. Documentation/
cp -a aufs/include/uapi/linux/aufs_type.h include/uapi/linux/

# Retain Slax's loopback and inode patches, and reject mismatched patch context.
for PATCH in kbuild base mmap loopback; do
   patch --batch --fuzz=0 -p1 < "aufs/aufs7-$PATCH.patch"
done
for PATCH in vfs-ino tmpfs-idr; do
   patch --batch --fuzz=0 -p1 < "aufs/$PATCH.patch"
done

# Rebuild every configured module under a distinct release with our own signing key.
scripts/config --set-str LOCALVERSION '-slax' --disable LOCALVERSION_AUTO \
   --set-str MODULE_SIG_KEY certs/signing_key.pem --enable MODULE_SIG_ALL \
   --set-str SYSTEM_TRUSTED_KEYS '' --set-str SYSTEM_REVOCATION_KEYS '' \
   --enable AUFS_FS --enable AUFS_BRANCH_MAX_32767 --disable AUFS_BRANCH_MAX_127 \
   --enable AUFS_EXPORT --enable AUFS_XATTR --enable AUFS_DIRREN --enable AUFS_SHWH \
   --enable AUFS_BR_RAMFS --enable AUFS_BR_FUSE --disable AUFS_HNOTIFY --disable AUFS_DEBUG

# Production builds omit DWARF, BTF and debugger helper files.
scripts/config --disable DEBUG_INFO --disable DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT \
   --disable DEBUG_INFO_DWARF4 --disable DEBUG_INFO_DWARF5 --enable DEBUG_INFO_NONE \
   --disable DEBUG_INFO_BTF --disable DEBUG_INFO_BTF_MODULES --disable GDB_SCRIPTS
make olddefconfig

make -j"$(getconf _NPROCESSORS_ONLN)" bindeb-pkg KDEB_PKGVERSION="$KERNELVERSION-slax"

mkdir -p "$OUTPUT"
cp "$BUILD"/*.deb "$OUTPUT/"
printf 'You can find the Debian packages in %s\n' "$OUTPUT"
