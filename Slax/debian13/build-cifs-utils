#!/bin/sh
set -eu
OUTPUT=$1
WORK=$(mktemp -d /tmp/cifs-utils-repack.XXXXXX)
trap 'rm -rf "$WORK"' 0
cd "$WORK"
apt-get download cifs-utils
dpkg-deb --raw-extract cifs-utils_*.deb package

# Keep Debian's native mount, credentials and ACL tools without Python helpers.
rm package/usr/bin/smbinfo package/usr/bin/smb2-quota
rm package/usr/share/man/man1/smbinfo.1.gz package/usr/share/man/man1/smb2-quota.1.gz
rm package/usr/share/bash-completion/completions/smbinfo
sed -i -E 's/, python3(:any)?( \([^)]*\))?//' package/DEBIAN/control

sed -i "s/^Installed-Size:.*/Installed-Size: $(du -sk --exclude=DEBIAN package | cut -f1)/" package/DEBIAN/control
cd package
find . -type f ! -path './DEBIAN/*' -printf '%P\0' | sort -z | xargs -0 md5sum > DEBIAN/md5sums
cd ..

dpkg-deb --build --root-owner-group package "$OUTPUT"
