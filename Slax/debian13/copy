#!/bin/sh
set -e
[ -f /build/buildmods ] || { echo "Run Slax's build script instead of copy." >&2; exit 1; }
# Replace the link itself, without overwriting the time zone file it points to.
rm -f /etc/localtime
cp -a /build/rootcopy/. /
install -m 755 /artifacts/01-core/linux-assistant /usr/bin/linux-assistant
# Repair Debian's duplicate restore label and avoid restoring absent first-boot state.
sed -i '0,/LABEL="alsa_restore_go"/! s/LABEL="alsa_restore_go"/LABEL="alsa_restore_std"/' /usr/lib/udev/rules.d/90-alsa-restore.rules
sed -i '/RUN+=.* restore /s/^TEST!=/TEST=="\/var\/lib\/alsa\/asound.state", TEST!=/' /usr/lib/udev/rules.d/90-alsa-restore.rules
# Copied service files must not be writable by other users.
for FILE in /build/rootcopy/usr/lib/systemd/system/*.service; do
   chmod 644 "/usr/lib/systemd/system/$(basename "$FILE")"
done
chmod 644 /usr/lib/udev/rules.d/90-slax-automount.rules
# Runtime commands must be executable even when exported from a Windows checkout.
for FILE in /build/rootcopy/usr/bin/* /build/rootcopy/usr/sbin/*; do
   chmod 755 "${FILE#/build/rootcopy}"
done

ln -sf /usr/share/zoneinfo/Etc/UTC /etc/localtime
ln -sf /usr/lib/systemd/system/slax-rmmounts.service /etc/systemd/system/sysinit.target.wants/slax-rmmounts.service

# Disable bundled timers, including static units and timers activated by other services.
systemctl --root=/ mask apt-daily.timer apt-daily-upgrade.timer dpkg-db-backup.timer \
   fstrim.timer man-db.timer systemd-tmpfiles-clean.timer mdcheck_start.timer \
   mdcheck_continue.timer mdmonitor-oneshot.timer mdadm-last-resort@.timer e2scrub_all.timer
systemctl --root=/ disable e2scrub_reap.service
