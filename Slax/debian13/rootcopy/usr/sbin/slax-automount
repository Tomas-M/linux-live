#!/bin/bash
# Recreate fstab entries in /etc/fstab and make /media directories
# This script is called by udev rules, see /lib/udev/rules.d/
#
# Author: Tomas M <http://slax.linux-live.org/>

# Variables available in udev environment:
# $ACTION (eg: add, remove)
# $DEVNAME (full device node name including path)
# $DEVTYPE (eg: disk)
# $ID_FS_TYPE (eg: ext3)
# $MAJOR and $MINOR numbers
# $SUBSYSTEM (eg: block)

PATH=$PATH:/usr/bin:/usr/sbin:/bin:/sbin

# A transient systemd service receives the device event from the udev rule.
ACTION=$1
DEVNAME=$2

BAS="$(basename "$DEVNAME")"
UNIT="media-$BAS.mount"
MNT="/media/$BAS"
TARGET="/run/systemd/system/$UNIT"


# exit if noautomount boot parameter is present
if cat /proc/cmdline | grep -q noautomount; then
   exit
fi

# exit if 'automount' boot parameter is missing
if ! cat /proc/cmdline | grep -q automount; then
   exit
fi

# Serialize events for this path; queued removals may refer to an older device.
exec 9>"/run/lock/slax-automount-$BAS.lock"
flock 9
if [ "$ACTION" = "remove" ]; then
   # Finish queued remove/add pairs before deciding that the device disappeared.
   udevadm settle || exit 1
   if [ -b "$DEVNAME" ]; then exit; fi
fi

# Initramfs already owns boot and session disks; expose them without a second mount
if [ -L "$MNT" ] && readlink "$MNT" | grep -q '^/run/initramfs/'; then
   if [ "$ACTION" = "remove" ]; then rm "$MNT"; fi
   gtk-bookmarks-update
   exit
fi


if [ "$ACTION" = "add" -o "$ACTION" = "change" ]; then
   if [ ! -b "$DEVNAME" ]; then
      exit
   fi

   # Wait for partitioning tools holding the parent disk's standard exclusive lock.
   DISK=$BAS
   if [ -f "/sys/class/block/$BAS/partition" ]; then
      DISK=$(basename "$(dirname "$(readlink -f "/sys/class/block/$BAS")")")
   fi
   exec 8<"/dev/$DISK" || exit 1
   flock -s 8
   # A later queued remove must not undo a mount made during an earlier add.
   udevadm settle || exit 1
   if [ ! -b "$DEVNAME" ]; then
      exit
   fi

   # Mount the partitions, not a whole disk with a duplicate filesystem signature.
   if ls "/sys/class/block/$BAS"/*/partition >/dev/null 2>&1; then
      exit
   fi

   # Reconcile the current state, not the filesystem data captured by an old event.
   if mountpoint -q "$MNT"; then
      gtk-bookmarks-update
      exit
   fi
   ID_FS_TYPE=$(blkid -p -s TYPE -o value "$DEVNAME")

   if [ "$ID_FS_TYPE" != "" -a "$(cat /proc/filesystems | grep "$ID_FS_TYPE")" != "" ]; then

      mkdir -p /run/systemd/system "$MNT"

      echo "# Slax skip savechanges" >"$TARGET.new"
      echo "[Unit]" >>"$TARGET.new"
      echo "Description=Disk $BAS" >>"$TARGET.new"
      echo "" >>"$TARGET.new"
      echo "[Mount]" >>"$TARGET.new"
      echo "What=$DEVNAME" >>"$TARGET.new"
      echo "Where=$MNT" >>"$TARGET.new"
      echo "Type=$ID_FS_TYPE" >>"$TARGET.new"
      echo "Options=defaults" >>"$TARGET.new"
      mv "$TARGET.new" "$TARGET"
      systemctl daemon-reload
      if ! systemctl start "$UNIT"; then
         exit 1
      fi

      gtk-bookmarks-update
      # A file-manager process can outlive this event; it must not retain either lock.
      exec 8<&- 9>&-
      XDG_RUNTIME_DIR="/run/user/$(id -u)" DISPLAY=:0.0 pcmanfm -n "file://$MNT" >/dev/null 2>&1
   fi
fi

if [ "$ACTION" = "remove" ]; then
   if ! systemctl stop "$UNIT"; then
      exit 1
   fi
   if [ -f "$TARGET" ]; then
      rm "$TARGET"
      systemctl daemon-reload
   fi
   if [ -d "$MNT" ]; then
      rmdir "$MNT"
   fi
   gtk-bookmarks-update
fi
