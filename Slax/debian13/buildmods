#!/bin/sh
set -e
THIS=$(CDPATH= cd "$(dirname "$0")" && pwd)
SUITE=${1:?Usage: buildmods suite workdir kernel.deb media-dir}
WORK=${2:?}
IMAGE=${3:?}
MEDIA=${4:?}
RUN=$(mktemp -d "$WORK/rootfs.XXXXXX")
UNION=$RUN/root
BRANCH=$RUN/branches/01-core
ARTIFACTS=$RUN/artifacts
mkdir -p "$UNION" "$BRANCH" "$MEDIA/slax/modules" "$ARTIFACTS" "$WORK/manifests"

# Unmount only this build's mounts, including after a failed recipe.
finish()
{
   STATUS=$?
   trap - 0
   if mountpoint -q "$UNION"; then
      auplink "$UNION" flush || STATUS=1
      umount -R "$UNION" || STATUS=1
   fi
   exit "$STATUS"
}
trap finish 0
trap 'exit 130' INT
trap 'exit 143' TERM

# Freeze the previous module and put a fresh writable branch above it.
new_branch()
{
   auplink "$UNION" flush
   mount -i -t aufs -o "remount,mod=$BRANCH=ro+wh" none "$UNION"
   BRANCH=$RUN/branches/$1
   mkdir "$BRANCH"
   mount -i -t aufs -o "remount,add=0:$BRANCH=rw" none "$UNION"
}

# Every package operation runs in the target root, with service startup blocked.
in_root()
{
   chroot "$UNION" /usr/bin/env DEBIAN_FRONTEND=noninteractive LC_ALL=C TMPDIR=/tmp /bin/sh -ec \
      'cd "$1"; shift; exec sh "$@"' sh "$@"
}

# Directory redirects refer to source inode numbers, which change in SquashFS.
mount -i -t aufs -o "br=$BRANCH=rw,xino=$RUN/xino,nodirren" none "$UNION"
debootstrap --variant=minbase --arch=amd64 --components=main,contrib,non-free,non-free-firmware \
   "$SUITE" "$UNION" http://deb.debian.org/debian

# Build files, caches and runtime mounts never become part of a module.
for DIR in dev proc sys run tmp boot build artifacts var/cache/apt var/lib/apt/lists; do
   mkdir -p "$UNION/$DIR"
done
mount --rbind /dev "$UNION/dev"
mount -t proc proc "$UNION/proc"
mount --bind /sys "$UNION/sys"
mount -t tmpfs tmpfs "$UNION/run"
for DIR in tmp boot var/cache/apt var/lib/apt/lists; do
   mkdir -p "$RUN/$DIR"
   mount --bind "$RUN/$DIR" "$UNION/$DIR"
done
# Preserve the standard writable, sticky temporary directory inside the chroot.
chmod 1777 "$RUN/tmp"
mount --bind "$THIS" "$UNION/build"
mount -o remount,bind,ro "$UNION/build"
mount --bind "$ARTIFACTS" "$UNION/artifacts"
printf '#!/bin/sh\nexit 101\n' > "$UNION/usr/sbin/policy-rc.d"
chmod 755 "$UNION/usr/sbin/policy-rc.d"
cp "$IMAGE" "$ARTIFACTS/kernel.deb"

sed "s/trixie/$SUITE/g" "$THIS/rootcopy/etc/apt/sources.list" > "$RUN/sources.list"
cp "$RUN/sources.list" "$UNION/etc/apt/sources.list"
in_root /build install
in_root /build copy
# Use the selected suite after rootcopy has applied the Slax defaults.
cp "$RUN/sources.list" "$UNION/etc/apt/sources.list"
in_root /build cleanup
chroot "$UNION" dpkg-query -W -f='${binary:Package}\t${Version}\n' > "$WORK/manifests/01-core.packages"

for RECIPE in "$THIS"/modules/*; do
   NAME=$(basename "$RECIPE")
   new_branch "$NAME"
   in_root "/build/modules/$NAME" build
   if [ -f "$RECIPE/compile" ]; then
      RUNTIME=$BRANCH
      new_branch "$NAME-build"
      mkdir -p "$ARTIFACTS/$NAME"
      in_root "/build/modules/$NAME" compile
      auplink "$UNION" flush
      mount -i -t aufs -o "remount,del=$BRANCH" none "$UNION"
      rm -rf "$BRANCH"
      BRANCH=$RUNTIME
      mount -i -t aufs -o "remount,mod=$BRANCH=rw" none "$UNION"
      # Replace the stock binaries even when the patched package version is unchanged.
      chroot "$UNION" /usr/bin/env DEBIAN_FRONTEND=noninteractive TMPDIR=/tmp /bin/sh -ec \
         'apt-get install -y --no-install-recommends --reinstall /artifacts/"$1"/*.deb' sh "$NAME"
   fi
   in_root /build cleanup
   chroot "$UNION" dpkg-query -W -f='${binary:Package}\t${Version}\n' > "$WORK/manifests/$NAME.packages"
done
auplink "$UNION" flush
umount -R "$UNION"

# Keep functional whiteouts; omit only AUFS bookkeeping and mounted build data.
for BRANCH in "$RUN"/branches/*; do
   mksquashfs "$BRANCH" "$MEDIA/slax/modules/$(basename "$BRANCH").sb" \
      -noappend -comp xz -Xbcj x86 -b 1024k -always-use-fragments \
      -e .wh..wh.aufs .wh..wh.plnk .wh..wh.orph boot dev proc sys run tmp build artifacts \
      var/cache/apt var/lib/apt/lists usr/sbin/policy-rc.d
done
printf 'Filesystem branches: %s/branches\n' "$RUN"
