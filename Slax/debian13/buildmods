#!/bin/sh
set -e
THIS=$(CDPATH= cd "$(dirname "$0")" && pwd)
KIT=$(CDPATH= cd "$THIS/../.." && pwd)
SUITE=${1:?Usage: buildmods suite workdir media-dir}
WORK=${2:?}
MEDIA=${3:?}
RUN=$(mktemp -d "$WORK/rootfs.XXXXXX")
UNION=$RUN/root
BRANCH=$RUN/branches/01-core
LOWER=$RUN/empty
ARTIFACTS=$RUN/artifacts
mkdir -p "$UNION" "$BRANCH" "$LOWER" "$RUN/work" "$MEDIA/slax/modules" "$ARTIFACTS" "$WORK/manifests"
printf '%s\n' "$RUN" > "$WORK/rootfs-directory.txt"

# Unmount this build's root and every bind mount before changing its layer stack.
close_root()
{
   if mountpoint -q "$UNION"; then
      umount -R "$UNION"
   fi
}

# Failed recipes must leave no mounted overlay or bind mounts behind.
finish()
{
   STATUS=$?
   trap - 0
   close_root || STATUS=1
   exit "$STATUS"
}
trap finish 0
trap 'exit 130' INT
trap 'exit 143' TERM

# Disable inode-dependent copy-up metadata because completed layers become SquashFS.
open_root()
{
   mkdir -p "$RUN/work/$(basename "$BRANCH")"
   mount -t overlay overlay -o "lowerdir=$LOWER,upperdir=$BRANCH,workdir=$RUN/work/$(basename "$BRANCH"),index=off,metacopy=off,redirect_dir=off,xino=off" "$UNION"
   for DIR in dev proc sys run tmp boot build kit artifacts var/cache/apt var/lib/apt/lists; do
      mkdir -p "$UNION/$DIR"
   done
   mount --rbind /dev "$UNION/dev"
   mount --make-rslave "$UNION/dev"
   mount -t proc proc "$UNION/proc"
   mount --bind /sys "$UNION/sys"
   mount -t tmpfs tmpfs "$UNION/run"
   for DIR in tmp boot var/cache/apt var/lib/apt/lists; do
      mkdir -p "$RUN/$DIR"
      mount --bind "$RUN/$DIR" "$UNION/$DIR"
   done
   chmod 1777 "$RUN/tmp"
   mount --bind "$THIS" "$UNION/build"
   mount -o remount,bind,ro "$UNION/build"
   mount --bind "$KIT" "$UNION/kit"
   mount -o remount,bind,ro "$UNION/kit"
   mount --bind "$ARTIFACTS" "$UNION/artifacts"
}

# Every new layer sees the frozen preceding runtime layers in priority order.
new_branch()
{
   close_root
   LOWER=$BRANCH:$LOWER
   BRANCH=$RUN/branches/$1
   mkdir "$BRANCH"
   open_root
}

# Discard compiler changes and restore the previous writable runtime layer.
discard_build()
{
   close_root
   rm -rf "$BRANCH" "$RUN/work/$(basename "$BRANCH")"
   BRANCH=$RUNTIME
   LOWER=${LOWER#*:}
   open_root
}

# Every package operation runs in the target root with service startup blocked.
in_root()
{
   chroot "$UNION" /usr/bin/env DEBIAN_FRONTEND=noninteractive LC_ALL=C TMPDIR=/tmp /bin/sh -ec \
      'cd "$1"; shift; exec sh "$@"' sh "$@"
}

open_root
debootstrap --variant=minbase --arch=amd64 --components=main,contrib,non-free,non-free-firmware \
   "$SUITE" "$UNION" https://deb.debian.org/debian
printf '#!/bin/sh\nexit 101\n' > "$UNION/usr/sbin/policy-rc.d"
chmod 755 "$UNION/usr/sbin/policy-rc.d"
sed "s/trixie/$SUITE/g" "$THIS/rootcopy/etc/apt/sources.list" > "$RUN/sources.list"
cp "$RUN/sources.list" "$UNION/etc/apt/sources.list"
in_root /build install

RUNTIME=$BRANCH
new_branch 01-core-build
mkdir -p "$ARTIFACTS/01-core"
in_root /build compile
discard_build

chroot "$UNION" env DEBIAN_FRONTEND=noninteractive LC_ALL=C apt-get install -y --no-install-recommends /artifacts/01-core/xfsprogs.deb
chroot "$UNION" apt-mark hold xfsprogs
in_root /build cleanup
in_root /build copy
cp "$RUN/sources.list" "$UNION/etc/apt/sources.list"
chroot "$UNION" dpkg-query -W -f='${binary:Package}\t${Version}\n' > "$WORK/manifests/01-core.packages"

for RECIPE in "$THIS"/modules/*; do
   NAME=$(basename "$RECIPE")
   new_branch "$NAME"
   in_root "/build/modules/$NAME" build
   if [ -f "$RECIPE/compile" ]; then
      RUNTIME=$BRANCH
      new_branch "$NAME-build"
      mkdir -p "$ARTIFACTS/$NAME"
      in_root "/build/modules/$NAME" compile
      discard_build
      chroot "$UNION" /usr/bin/env DEBIAN_FRONTEND=noninteractive TMPDIR=/tmp /bin/sh -ec \
         'set -- /artifacts/"$1"/*.deb
          if [ -f "$1" ]; then apt-get install -y --no-install-recommends --reinstall --allow-downgrades "$@"; fi' sh "$NAME"
   fi
   in_root /build cleanup
   if [ -f "$RECIPE/cleanup" ]; then
      in_root "/build/modules/$NAME" cleanup
   fi
   if [ -f "$RECIPE/copy" ]; then
      in_root "/build/modules/$NAME" copy
   elif [ -d "$RECIPE/rootcopy" ]; then
      chroot "$UNION" cp -a "/build/modules/$NAME/rootcopy/." /
   fi
   chroot "$UNION" dpkg-query -W -f='${binary:Package}\t${Version}\n' > "$WORK/manifests/$NAME.packages"
done

# Build the initramfs against the target Debian modules, independently of the host kernel.
KERNEL=$(basename "$RUN"/boot/vmlinuz-*)
KERNEL=${KERNEL#vmlinuz-}
cp "$KIT/config" "$RUN/tmp/slax-build-config"
printf '\nLIVEKITNAME=slax\nUNIONFS=overlay\nNETWORK=true\nKERNEL=%s\nLMK=lib/modules/$KERNEL\nBEXT=sb\n' "$KERNEL" >> "$RUN/tmp/slax-build-config"
INITRAMFS=$(chroot "$UNION" env LIVEKITCONFIG=/tmp/slax-build-config SPLASH=/kit/Slax/debian13/bootsplash sh -c 'cd /kit/initramfs; sh ./initramfs_create')
mkdir -p "$MEDIA/slax/boot"
mv "$RUN/$INITRAMFS" "$MEDIA/slax/boot/initrfs.img"
cp "$RUN/boot/vmlinuz-$KERNEL" "$MEDIA/slax/boot/vmlinuz"
printf '%s\n' "$KERNEL" > "$WORK/kernel-release.txt"
close_root

# Preserve OverlayFS whiteout devices and opaque-directory xattrs in each lower layer.
for BRANCH in "$RUN"/branches/*; do
   chmod 755 "$BRANCH"
   mksquashfs "$BRANCH" "$MEDIA/slax/modules/$(basename "$BRANCH").sb" \
      -noappend -comp xz -Xbcj x86 -b 1024k -always-use-fragments \
      -e boot dev proc sys run tmp build kit artifacts var/cache/apt var/lib/apt/lists usr/sbin/policy-rc.d
done
printf 'Filesystem layers: %s/branches\n' "$RUN"
