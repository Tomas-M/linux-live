#!/bin/sh
set -e

# Vulkan validation and mock drivers are development tools, not rendering backends.
rm -f /usr/lib/chromium/libVkLayer_khronos_validation.so /usr/lib/chromium/libVkICD_mock_icd.so
# GN's symbol tables are build artifacts; keep the real Vulkan loader and SwiftShader.
rm -f /usr/lib/chromium/*.TOC
