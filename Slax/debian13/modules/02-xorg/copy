#!/bin/sh
set -e
cp -a rootcopy/. /
# Keep Breeze selected when GTK later registers its Adwaita cursor theme.
update-alternatives --install /usr/share/icons/default/index.theme x-cursor-theme /usr/share/icons/breeze_cursors/cursor.theme 100
ln -sf /usr/lib/systemd/system/xorg.service /etc/systemd/system/display-manager.service
