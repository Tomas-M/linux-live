#!/bin/sh
set -e
apt-get update
apt-get install --yes --no-install-recommends \
   xserver-xorg xserver-xorg-video-all xserver-xorg-video-intel \
   xinit xterm xinput blackbox libxcursor1 breeze-cursor-theme \
   x11-utils wmctrl xdotool libdrm-intel1 libgl1-mesa-dri libglu1-mesa

# Keep the white cursor and allow the guest account to start Xorg.
chmod u+s /usr/lib/xorg/Xorg
rm -rf /usr/share/icons/breeze_cursors
mv /usr/share/icons/Breeze_Light /usr/share/icons/breeze_cursors
# Extract the server utilities without their unnecessary cpp dependency.
cd /tmp
apt-get download x11-xserver-utils
mkdir x11utils
dpkg -x x11-xserver-utils*.deb x11utils
cp -a x11utils/. /
update-alternatives --set x-terminal-emulator /usr/bin/xterm
