[Unit]
Description=VirtualBox shared folders and guest information
ConditionVirtualization=oracle
After=systemd-modules-load.service

[Service]
# Coldplug may still be loading the driver when this service starts.
ExecStartPre=/usr/sbin/modprobe vboxguest
ExecStart=/usr/sbin/VBoxService --foreground --only-automount --enable-vminfo

[Install]
WantedBy=multi-user.target
