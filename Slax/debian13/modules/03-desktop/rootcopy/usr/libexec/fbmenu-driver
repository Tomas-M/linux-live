#!/bin/sh

# Only graphics modules need the splash to release display memory before loading.
if [ "$1" = "--check" ]; then
   modprobe -b --show-depends "$2" 2>/dev/null | grep -qE '/drivers/(gpu/drm|video/fbdev)/'
   exit $?
fi

if /run/fbmenu --pause >/dev/null 2>&1; then
   trap '/run/fbmenu --continue >/dev/null 2>&1' 0
   trap 'exit 1' HUP INT TERM
fi

modprobe -b "$1"
