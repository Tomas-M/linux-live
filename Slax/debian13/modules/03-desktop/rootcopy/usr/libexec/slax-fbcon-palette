#!/bin/sh

# Use near-black (#010101) on all consoles to avoid skipped zero-filled pixels
# when framebuffer drivers restore the screen after a VT switch.
for COLOR in red grn blu; do
   read PALETTE < "/sys/module/vt/parameters/default_$COLOR"
   printf '1,%s\n' "${PALETTE#*,}" > "/sys/module/vt/parameters/default_$COLOR"
done
# Restore the palette and show the login cursor hidden during graphical boot.
printf '\033]R\033[?25h' > "/dev/$1"
