[Desktop Entry]
Type=Application
Name=Mines
Exec=fbinstall org.gnome.Mines slax-gnome-mines "Mines" "gnome-mines" "/usr/games/gnome-mines"
X-Xlunch-Executable=/usr/games/gnome-mines
Icon=slax-gnome-mines
Terminal=false
StartupNotify=true
Comment=Clear hidden mines from a minefield
Categories=GNOME;GTK;Game;LogicGame;
Keywords=minesweeper;
