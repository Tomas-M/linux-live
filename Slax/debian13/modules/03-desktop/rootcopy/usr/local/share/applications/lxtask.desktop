[Desktop Entry]
Name=Task Manager
Comment=Monitor CPU and memory usage and manage running processes
GenericName=Process manager
Keywords=task;kill;suspend;processor;memory;monitoring;performance;
Exec=fbinstall lxtask slax-task-manager "Task Manager" "lxtask" "lxtask"
X-Xlunch-Executable=lxtask
Icon=slax-task-manager
Terminal=false
StartupNotify=true
Type=Application
Categories=GTK;System;Monitor;
