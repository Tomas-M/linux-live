#!/bin/sh
# Start only the desktop agent belonging to the detected hypervisor.
if [ "$(systemd-detect-virt --vm)" = oracle ]; then
   VBoxClient --clipboard --session-type x11
   VBoxClient --vmsvga-session --session-type x11
elif [ "$(systemd-detect-virt --vm)" = vmware ]; then
   vmtoolsd -n vmusr &
else
   exit 0
fi
exec slax-guest-resize
