#!/bin/sh

# Try native autodetection first; generate a configuration only after startup fails.
if /usr/bin/startx "$@"; then
   exit 0
fi

# Keep the fallback local to this attempt, outside persistent changes.
CONFIG=$(mktemp -d /run/slax-xorg.XXXXXX) || exit 1
trap 'rm -r "$CONFIG"' 0
trap 'exit 1' HUP INT TERM
HOME="$CONFIG" /usr/bin/Xorg -configure
if [ ! -s "$CONFIG/xorg.conf.new" ]; then exit 1; fi
XORGCONFIG="$CONFIG/xorg.conf.new" /usr/bin/startx "$@"
