#!/bin/sh

# Try native autodetection before the framebuffer fallback.
if /usr/bin/startx "$@"; then
   exit 0
fi

# Preserve explicitly selected configurations and retry only for this invocation.
if [ -n "$XORGCONFIG" ] || [ -f /etc/X11/xorg.conf ]; then exit 1; fi
for ARG in "$@"; do
   if [ "$ARG" = -config ] || [ "$ARG" = -configdir ]; then exit 1; fi
done
if [ ! -c /dev/fb0 ]; then exit 1; fi
XORGCONFIG=slax-framebuffer.conf exec /usr/bin/startx "$@"
