#!/bin/bash

OUTPUT=$(xrandr 2>/dev/null | grep -iv disconnected | grep -i 'connected' | head -n 1 | cut -d " " -f 1)
MODE=$1

xrandr --output $OUTPUT --mode $MODE -s $MODE
fbvboxpointer

if [ "$2" = "-n" ]; then
   exit
fi

# Restore the image and scaling mode without fbsetbg's DISPLAY-specific lookup.
sh ~/.fehbg

while [ "$(ps -ef | grep picom | grep -v grep)" != "" ]; do
   killall picom
   sleep 0.1
done

picom -b --config /etc/picom.conf
