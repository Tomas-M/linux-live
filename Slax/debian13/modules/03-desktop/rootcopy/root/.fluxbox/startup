#!/bin/sh
#
# fluxbox startup-script:
#
# Lines starting with a '#' are ignored.

# Logout ends this window manager and lets xinit stop its own X server.
SLAX_DESKTOP_PID=$$
export SLAX_DESKTOP_PID

# Apply an optional user keymap.
if [ -f "$HOME/.Xmodmap" ]; then
   xmodmap "$HOME/.Xmodmap"
fi

# merge xresource settings
xrdb -merge "$HOME/.Xresources"

# Restore the keyboard tray's saved layout and preferred alternate.
fbkeyboard &
KEYBOARDPID=$!

# setup bookmarks for file manager
/usr/sbin/gtk-bookmarks-update

# Set the background and use the cursor theme and size selected by Xresources.
fbsetroot -solid '#010101'
fbvboxpointer
xsetroot -cursor_name watch

# disable screen blanking
xset s off
xset -dpms

# preload picom and fluxbox to cache
(picom --help; fluxbox --help; xfce4-panel --help) >/dev/null 2>&1

# Keep Skippy's shared styling while giving each user private IPC endpoints.
SKIPPY_RUNTIME=${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}
SLAX_SKIPPY_CONFIG=$SKIPPY_RUNTIME/slax-skippy.rc
export SKIPPY_RUNTIME SLAX_SKIPPY_CONFIG
mkdir -p "$SKIPPY_RUNTIME"
awk '
   /^\[/ { in_system=($0 == "[system]") }
   in_system && /^[[:space:]]*(daemonPath|clientPath)[[:space:]]*=/ { next }
   { print }
   /^\[system\]$/ {
      print "daemonPath = " ENVIRON["SKIPPY_RUNTIME"] "/slax-skippy-daemon"
      print "clientPath = " ENVIRON["SKIPPY_RUNTIME"] "/slax-skippy-client"
   }
' /etc/xdg/skippy-xd.rc > "$SLAX_SKIPPY_CONFIG"

# Debian-local change:
#   - fbautostart has been added with a quick hack to check to see if it
#     exists. If it does, we'll start it up by default.
which fbautostart > /dev/null
if [ $? -eq 0 ]; then
    fbautostart &
fi

# Start desktop integration only on its matching hypervisor.
slax-guest-desktop &

# Apply the startup modes directly; SPICE follows the host's preferred mode.
if [ ! -e /dev/virtio-ports/com.redhat.spice.0 ] && [ "$(systemd-detect-virt --vm | grep -Ex 'oracle|vmware|qemu|kvm')" != "" ]; then
   SCREEN_OUTPUT=$(xrandr --query | awk '$2 == "connected" { print $1; exit }')
   for MODE in 1440x900 1280x800; do
      xrandr --output "$SCREEN_OUTPUT" --mode "$MODE"
      fbvboxpointer
   done
fi

# Restart a crashed panel while preserving clean exits and the X session lifetime.
(
   while true; do
      if xfce4-panel --disable-wm-check --sm-client-disable; then break; fi
      if ! xdpyinfo >/dev/null 2>&1; then break; fi
      sleep 1
   done
) &

(
   while [ "$(wmctrl -l | grep xfce4-panel)" = "" ]; do
      sleep 0.1
   done
   picom -b --config /etc/picom.conf
   # Retain window snapshots for Alt+Tab, including minimized applications.
   # Fluxbox commands include the default screen in DISPLAY; match its IPC path.
   SKIPPYDISPLAY=$DISPLAY
   if ! printf '%s\n' "${DISPLAY##*:}" | grep -q '\.'; then
      SKIPPYDISPLAY=$DISPLAY.0
   fi
   DISPLAY=$SKIPPYDISPLAY skippy-xd --config "$SLAX_SKIPPY_CONFIG" --start-daemon &
   volumeicon &
   VOLUMEPID=$!
   connman-gtk --tray &
   NETWORKPID=$!
   slax-status &
   STATUSPID=$!

   # Wait up to ten monotonic seconds for visible icons, skipping failed applets.
   read UPTIME IDLE < /proc/uptime
   DEADLINE=$(( ${UPTIME%%.*} + 10 ))
   while true; do
      MISSING=
      for TRAY in "fbkeyboard:$KEYBOARDPID" "volumeicon:$VOLUMEPID" "connman-gtk:$NETWORKPID" "slax-status:$STATUSPID"; do
         if kill -0 "${TRAY#*:}" 2>/dev/null && ! xdotool search --onlyvisible --classname "^${TRAY%:*}$" >/dev/null 2>&1; then
            MISSING=1
         fi
      done
      read UPTIME IDLE < /proc/uptime
      if [ -z "$MISSING" ] || [ "${UPTIME%%.*}" -ge "$DEADLINE" ]; then
         break
      fi
      sleep 0.1
   done

   # Finish the panel's initial redraw on black before showing the icon desktop.
   pcmanfm --desktop &

   # Announce the completed desktop instead of delaying its startup with sound.
   SND=/usr/share/sounds/startup.wav
   if [ -r "$SND" ]; then
      aplay "$SND"
   fi

   # Preload Chromium after the sound only with more than 512 MiB available RAM.
   AVAILABLEKB=$(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo)
   if [ "$AVAILABLEKB" -gt 524288 ]; then
      fbliveapp chromium --no-startup-window &
   fi
) &

# And last but not least we start fluxbox.
# Because it is the last app you have to run it with ''exec'' before it.
exec fluxbox
