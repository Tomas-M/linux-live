Description: Keep constrained combo box popups inside their scrollable contents
 Sliding a popup to fit the monitor must not preserve an item alignment that
 scrolls before the first item or past the last one, leaving an empty viewport.
 Keep the active item clear of scroll arrows and short menus fully visible.
Author: Slax <build@slax.org>

--- a/gtk/gtkmenu.c
+++ b/gtk/gtkmenu.c
@@ -2486,17 +2486,21 @@
                                gboolean            flipped_y,
                                gpointer            user_data)
 {
-  GtkBorder arrows_border;
-
   g_return_if_fail (GTK_IS_MENU (menu));
 
   if (!flipped_rect || !final_rect)
     return;
 
-  get_arrows_border (menu, &arrows_border);
-  menu->priv->scroll_offset = arrows_border.top + (final_rect->y - flipped_rect->y);
+  /* Keep alignment within the contents when the monitor constrains the popup. */
+  menu->priv->scroll_offset =
+    CLAMP (final_rect->y - flipped_rect->y, 0,
+           MAX (0, flipped_rect->height - final_rect->height));
   gtk_menu_scroll_to (menu, menu->priv->scroll_offset,
                       GTK_MENU_SCROLL_FLAG_ADAPT);
+
+  /* Newly visible scroll arrows must not cover the selected item. */
+  if (gtk_menu_get_active (menu))
+    gtk_menu_scroll_item_visible (GTK_MENU_SHELL (menu), gtk_menu_get_active (menu));
 }
 
