+/* Identify Chromium's nonstandard Open response only where key state is queryable. */
+static GtkWidget *
+get_chromium_accept_button (GtkDialog *dialog)
+{
+#ifdef GDK_WINDOWING_X11
+  if (GDK_IS_X11_DISPLAY (gtk_widget_get_display (GTK_WIDGET (dialog))) &&
+      g_strcmp0 (g_get_prgname (), "chromium") == 0 &&
+      gtk_file_chooser_get_action (GTK_FILE_CHOOSER (dialog)) == GTK_FILE_CHOOSER_ACTION_OPEN)
+    return gtk_dialog_get_widget_for_response (dialog, 0);
+#endif
+  return NULL;
+}
+
+/* Match all Enter and Space variants used to activate GTK's file list. */
+static gboolean
+is_activation_key (guint keyval)
+{
+  return keyval == GDK_KEY_Return || keyval == GDK_KEY_ISO_Enter ||
+         keyval == GDK_KEY_KP_Enter || keyval == GDK_KEY_space ||
+         keyval == GDK_KEY_KP_Space;
+}
+
+/* Read physical keys so a key held before mapping cannot accept an upload. */
+static gboolean
+activation_key_down (GtkWidget *widget)
+{
+#ifdef GDK_WINDOWING_X11
+  Display *display = gdk_x11_display_get_xdisplay (gtk_widget_get_display (widget));
+  guint keyvals[] = { GDK_KEY_Return, GDK_KEY_ISO_Enter, GDK_KEY_KP_Enter,
+                     GDK_KEY_space, GDK_KEY_KP_Space };
+  char keys[32];
+  guint i;
+
+  XQueryKeymap (display, keys);
+  for (i = 0; i < G_N_ELEMENTS (keyvals); i++)
+    {
+      KeyCode code = XKeysymToKeycode (display, keyvals[i]);
+      if (code && (keys[code / 8] & (1 << (code % 8))))
+        return TRUE;
+    }
+#endif
+  return FALSE;
+}
+
+/* Keep Chromium's held-key protection while allowing fresh keyboard activation. */
+static gboolean
+gtk_file_chooser_dialog_key_press (GtkWidget *widget,
+                                   GdkEventKey *event)
+{
+  GtkFileChooserDialogPrivate *priv = GTK_FILE_CHOOSER_DIALOG (widget)->priv;
+  gboolean protected = get_chromium_accept_button (GTK_DIALOG (widget)) != NULL;
+  gboolean settling = g_get_monotonic_time () - priv->chromium_show_time < 500 * 1000;
+
+  if (protected && is_activation_key (event->keyval) &&
+      (priv->chromium_keys_held || settling))
+    return TRUE;
+  return GTK_WIDGET_CLASS (gtk_file_chooser_dialog_parent_class)->key_press_event (widget, event);
+}
+
+/* Repeated key events must not unlock a key that is still physically held. */
+static gboolean
+gtk_file_chooser_dialog_key_release (GtkWidget *widget,
+                                     GdkEventKey *event)
+{
+  GtkFileChooserDialogPrivate *priv = GTK_FILE_CHOOSER_DIALOG (widget)->priv;
+
+  if (priv->chromium_keys_held && is_activation_key (event->keyval))
+    priv->chromium_keys_held = activation_key_down (widget);
+  return GTK_WIDGET_CLASS (gtk_file_chooser_dialog_parent_class)->key_release_event (widget, event);
+}
+
