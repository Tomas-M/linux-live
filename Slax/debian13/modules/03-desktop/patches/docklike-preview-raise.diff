-// Dim other clients through Picom without changing focus, stacking or minimization.
+// Stop on real window changes; child crossings must not restart a cancelled hover.
+void GroupMenuItem::cancelPeek()
+{
+	if (!peekItem)
+		return;
+	peekItem->mPeekBlocked = true;
+	peekItem->peek(false);
+}
+
+// Window changes can synthesize crossings without moving the physical pointer.
+bool GroupMenuItem::pointerInsidePeek()
+{
+	GdkRectangle pointer = {0, 0, 1, 1};
+	gdk_device_get_position(Plugin::mPointer, nullptr, &pointer.x, &pointer.y);
+	return gdk_rectangle_intersect(&mPeekArea, &pointer, nullptr);
+}
