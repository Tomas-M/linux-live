+// Keep neutral focus on the WM's mapped input-only window without changing stacking.
+void BScreen::clearFocus(Window owner) {
+    m_dummy_window.show();
+    FocusControl::setExpectingFocus(0);
+    m_dummy_window.setInputFocus(RevertToPointerRoot, CurrentTime);
+    FocusControl::setFocusedWindow(0);
+    Atom atom = XInternAtom(rootWindow().display(), "_FLUXBOX_FOCUS_ROOT", False);
+    XChangeProperty(rootWindow().display(), rootWindow().window(), atom,
+                    XA_WINDOW, 32, PropModeReplace, (unsigned char *)&owner, 1);
+}
+
 void BScreen::buttonPressEvent(XButtonEvent &be) {
+    if (be.button == Button1)
+        clearFocus();
     if (be.button == 1 && !isRootColormapInstalled())
         imageControl().installRootColormap();
 
