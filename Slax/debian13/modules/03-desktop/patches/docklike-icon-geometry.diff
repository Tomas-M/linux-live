+#ifdef ENABLE_X11
+	// External plugins keep their local allocations when the parent panel moves.
+	static void watchPanelGeometry(XfwWindow* window, GtkWidget* box)
+	{
+		if (xfw_window_get_window_type(window) != XFW_WINDOW_TYPE_DOCK)
+			return;
+		g_signal_connect_object(window, "geometry-changed",
+			G_CALLBACK(+[](XfwWindow*, GtkWidget* box) {
+				gtk_container_foreach(GTK_CONTAINER(box), +[](GtkWidget* button, gpointer) {
+					static_cast<Group*>(g_object_get_data(G_OBJECT(button), "group"))->updateIconGeometry();
+				}, nullptr);
+			}), box, G_CONNECT_DEFAULT);
+	}
+#endif
 
 	static void init(XfcePanelPlugin* xfPlugin)
 	{
