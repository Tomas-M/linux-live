+#ifdef ENABLE_X11
+// Xfw's X11 backend expects physical root coordinates.
+void Group::updateIconGeometry()
+{
+	if (!mWindows.size())
+		return;
+
+	GdkWindow* surface = gtk_widget_get_window(mButton);
+	if (!surface || !GDK_IS_X11_DISPLAY(gdk_window_get_display(surface)))
+		return;
+
+	GdkRectangle rect{};
+	int x, y;
+	if (gtk_widget_get_mapped(mButton) && gdk_window_get_origin(surface, &x, &y))
+	{
+		gtk_widget_get_allocation(mButton, &rect);
+		if (gtk_widget_get_has_window(mButton))
+			rect.x = rect.y = 0;
+		int scale = gdk_window_get_scale_factor(surface);
+		rect = {(x + rect.x) * scale, (y + rect.y) * scale, rect.width * scale, rect.height * scale};
+	}
+	mWindows.forEach([&](GroupWindow* window) {
+		xfw_window_set_button_geometry(window->mXfwWindow, surface, &rect, nullptr);
+	});
+}
+#endif
+
 void Group::add(GroupWindow* window)
 {
 	mWindows.push(window);
+#ifdef ENABLE_X11
+	updateIconGeometry();
+#endif
 	mWindowsCount.updateState();
 	mGroupMenu.add(window->mGroupMenuItem);
 	Help::Gtk::cssClassAdd(mButton, "open_group");
@@ -263,6 +306,14 @@
 
 void Group::remove(GroupWindow* window)
 {
+#ifdef ENABLE_X11
+	GdkWindow* surface = gtk_widget_get_window(mButton);
+	if (surface && GDK_IS_X11_DISPLAY(gdk_window_get_display(surface)))
+	{
+		const GdkRectangle empty{};
+		xfw_window_set_button_geometry(window->mXfwWindow, surface, &empty, nullptr);
+	}
+#endif
 	// Preserve the selected window as earlier entries shift, or select the first survivor.
 	uint removedIndex = mWindows.getIndex(window);
 	mWindows.pop(window);
