Description: Fit previews within two pixel limits and ellipsize their titles
Author: Slax <build@slax.org>
Forwarded: no
--- a/src/GroupMenuItem.cpp
+++ b/src/GroupMenuItem.cpp
@@ -43,7 +43,10 @@
 	mLabel = GTK_LABEL(gtk_label_new(""));
 	gtk_label_set_xalign(mLabel, 0);
 	gtk_label_set_ellipsize(mLabel, PANGO_ELLIPSIZE_END);
-	gtk_label_set_width_chars(mLabel, 26);
+	// Let the thumbnail determine the card width.
+	gtk_label_set_width_chars(mLabel, Settings::showPreviews ? 1 : 26);
+	gtk_label_set_max_width_chars(mLabel, Settings::showPreviews ? 1 : -1);
+	gtk_widget_set_hexpand(GTK_WIDGET(mLabel), true);
 	gtk_widget_show(GTK_WIDGET(mLabel));
 	gtk_grid_attach(mGrid, GTK_WIDGET(mLabel), 1, 0, 1, 1);
 
@@ -164,10 +167,6 @@
 		GdkWindow* window;
 		GdkPixbuf* pixbuf;
 		GdkPixbuf* thumbnail;
-
-		double scale = 0.125;
-		if (Settings::previewScale)
-			scale = Settings::previewScale;
 
 		window = gdk_x11_window_foreign_new_for_display(Plugin::mDisplay,
 			xfw_window_x11_get_xid(mGroupWindow->mXfwWindow));
@@ -184,9 +183,12 @@
 			if (pixbuf != nullptr)
 			{
 				gint scale_factor = gtk_widget_get_scale_factor(GTK_WIDGET(mPreview));
-				scale *= scale_factor;
-				thumbnail = gdk_pixbuf_scale_simple(pixbuf,
-					gdk_pixbuf_get_width(pixbuf) * scale, gdk_pixbuf_get_height(pixbuf) * scale, GDK_INTERP_BILINEAR);
+				// Fit both logical-pixel limits while preserving the window aspect ratio.
+				double scale = std::min(static_cast<double>(Settings::previewMaxWidth) / gdk_pixbuf_get_width(pixbuf),
+					static_cast<double>(Settings::previewMaxHeight) / gdk_pixbuf_get_height(pixbuf)) * scale_factor;
+				gint width = std::max(1, static_cast<int>(gdk_pixbuf_get_width(pixbuf) * scale));
+				gint height = std::max(1, static_cast<int>(gdk_pixbuf_get_height(pixbuf) * scale));
+				thumbnail = gdk_pixbuf_scale_simple(pixbuf, width, height, GDK_INTERP_BILINEAR);
 				cairo_surface_t* surface = gdk_cairo_surface_create_from_pixbuf(thumbnail, scale_factor, NULL);
 
 				gtk_image_set_from_surface(mPreview, surface);
