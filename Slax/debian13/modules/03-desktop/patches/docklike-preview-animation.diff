+	// Animate the shared viewport and card positions on GTK's frame clock.
+	void animate(double progress)
+	{
+		double eased = progress * progress * (3 - 2 * progress);
+		current.x = from.x + (target.x - from.x) * eased;
+		current.y = from.y + (target.y - from.y) * eased;
+		current.width = from.width + (target.width - from.width) * eased;
+		current.height = from.height + (target.height - from.height) * eased;
+		gtk_widget_set_size_request(stage, std::max(1, static_cast<int>(current.width + 0.5)), std::max(1, static_cast<int>(current.height + 0.5)));
+		gtk_window_resize(GTK_WINDOW(window), current.width + 0.5, current.height + 0.5);
+#ifdef ENABLE_WAYLAND
+		if (gtk_layer_is_supported())
+		{
+			gtk_layer_set_margin(GTK_WINDOW(window), GTK_LAYER_SHELL_EDGE_LEFT, current.x);
+			gtk_layer_set_margin(GTK_WINDOW(window), GTK_LAYER_SHELL_EDGE_TOP, current.y);
+		}
+		else
+#endif
+			gtk_window_move(GTK_WINDOW(window), current.x + 0.5, current.y + 0.5);
+		for (Card& card : cards)
+		{
+			card.current.x = card.from.x + (card.target.x - card.from.x) * eased;
+			card.current.y = card.from.y + (card.target.y - card.from.y) * eased;
+			card.current.width = card.from.width + (card.target.width - card.from.width) * eased;
+			card.current.height = card.from.height + (card.target.height - card.from.height) * eased;
+			card.opacity = card.fromOpacity + (1 - card.fromOpacity) * eased;
+			gtk_layout_move(GTK_LAYOUT(stage), GTK_WIDGET(card.item->mItem), card.current.x + 0.5, card.current.y + 0.5);
+			gtk_widget_set_size_request(GTK_WIDGET(card.item->mItem), card.current.width + 0.5, card.current.height + 0.5);
+			gtk_widget_set_opacity(GTK_WIDGET(card.item->mItem), card.opacity);
+			card.item->mPreviewBlend = eased;
+			gtk_widget_queue_draw(card.item->mPreview);
+			if (progress == 1)
+				card.item->setPreviousPreview(nullptr);
+		}
+		for (Ghost& ghost : ghosts)
+		{
+			double age = std::min(1.0, (g_get_monotonic_time() - ghost.started) / 180000.0);
+			double fade = age * age * (3 - 2 * age);
+			ghost.current.x = ghost.from.x + 12 * fade;
+			ghost.current.y = ghost.from.y + 6 * fade;
+			ghost.opacity = ghost.fromOpacity * (1 - fade);
+			gtk_layout_move(GTK_LAYOUT(stage), ghost.widget, ghost.current.x, ghost.current.y);
+			gtk_widget_set_opacity(ghost.widget, ghost.opacity);
+		}
+		if (progress == 1)
+		{
+			for (const Ghost& ghost : ghosts)
+				gtk_widget_destroy(ghost.widget);
+			ghosts.clear();
+		}
+	}
+};
