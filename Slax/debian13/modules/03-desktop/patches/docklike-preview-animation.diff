+// Blend image layers inside the animated card while retaining each aspect ratio.
+void GroupMenuItem::drawPreview(cairo_t* cr, int width, int height)
+{
+	cairo_push_group(cr);
+	cairo_set_operator(cr, CAIRO_OPERATOR_ADD);
+	cairo_surface_t* layers[] = {mPreviousPreview, mPreviewSurface};
+	double alpha[] = {1 - mPreviewBlend, mPreviousPreview ? mPreviewBlend : 1};
+	for (int index = 0; index < 2; ++index)
+	{
+		if (!layers[index])
+			continue;
+		double sx, sy;
+		cairo_surface_get_device_scale(layers[index], &sx, &sy);
+		double imageWidth = cairo_image_surface_get_width(layers[index]) / sx;
+		double imageHeight = cairo_image_surface_get_height(layers[index]) / sy;
+		double scale = std::min(width / imageWidth, height / imageHeight);
+		cairo_save(cr);
+		cairo_translate(cr, (width - imageWidth * scale) / 2, (height - imageHeight * scale) / 2);
+		cairo_scale(cr, scale, scale);
+		cairo_set_source_surface(cr, layers[index], 0, 0);
+		cairo_paint_with_alpha(cr, alpha[index]);
+		cairo_restore(cr);
+	}
+	cairo_pop_group_to_source(cr);
+	cairo_set_operator(cr, CAIRO_OPERATOR_OVER);
+	cairo_paint(cr);
+}
+
+// Retarget rapid icon changes from the image that is currently being displayed.
+cairo_surface_t* GroupMenuItem::snapshotPreview()
+{
+	if (!mPreviewSurface && !mPreviousPreview)
+		return nullptr;
+	int width = std::max(1, gtk_widget_get_allocated_width(mPreview));
+	int height = std::max(1, gtk_widget_get_allocated_height(mPreview));
+	int scale = gtk_widget_get_scale_factor(mPreview);
+	cairo_surface_t* surface = cairo_image_surface_create(CAIRO_FORMAT_ARGB32, width * scale, height * scale);
+	cairo_surface_set_device_scale(surface, scale, scale);
+	cairo_t* cr = cairo_create(surface);
+	drawPreview(cr, width, height);
+	cairo_destroy(cr);
+	return surface;
+}
+
+// Keep one old image layer only for the duration of a group transition.
+void GroupMenuItem::setPreviousPreview(cairo_surface_t* surface)
+{
+	if (mPreviousPreview)
+		cairo_surface_destroy(mPreviousPreview);
+	mPreviousPreview = surface ? cairo_surface_reference(surface) : nullptr;
+	mPreviewBlend = surface ? 0 : 1;
+	gtk_widget_queue_draw(mPreview);
+}
