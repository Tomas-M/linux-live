+	// Panel selection is independent of the window manager's active client.
+	void selectGroup(Group* group)
+	{
+		mSelectedGroup = group;
+		mGroups.forEach([](std::pair<std::shared_ptr<AppInfo>, std::shared_ptr<Group>> entry) {
+			entry.second->updateActiveStyle();
+		});
+	}
+
+	// Explicit focus changes dismiss every group's pending or visible preview.
+	void dismissPreviews()
+	{
+		selectGroup(nullptr);
+		GroupMenuItem::cancelPeek();
+		mGroups.forEach([](std::pair<std::shared_ptr<AppInfo>, std::shared_ptr<Group>> entry) {
+			entry.second->mMenuShowTimeout.stop();
+			entry.second->mGroupMenu.hide();
+		});
+	}
+
 	void drawGroups()
 	{
+		selectGroup(nullptr);
 		// Remove old groups
 		Xfw::mGroupWindows.clear();
 		mGroups.clear();
