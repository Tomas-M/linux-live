+
+// A clicked group owns the indicator only while its previews remain open.
+bool Group::isHighlighted() const
+{
+	return Dock::mSelectedGroup ? Dock::mSelectedGroup == this : mActive;
+}
+
+// Apply the same derived selection to the button background and native indicator.
+void Group::updateActiveStyle()
+{
+	if (isHighlighted())
+		Help::Gtk::cssClassAdd(mButton, "active_group");
+	else
+		Help::Gtk::cssClassRemove(mButton, "active_group");
+	gtk_widget_queue_draw(mButton);
 }
 
