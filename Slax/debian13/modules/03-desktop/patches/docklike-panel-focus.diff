+#ifdef ENABLE_X11
+	// Root focus requests notify even when there was already no active client.
+	static GdkFilterReturn focusRootEvent(GdkXEvent* raw, GdkEvent*, gpointer)
+	{
+		XEvent* event = static_cast<XEvent*>(raw);
+		Display* display = GDK_DISPLAY_XDISPLAY(Plugin::mDisplay);
+		Atom focus = XInternAtom(display, "_FLUXBOX_FOCUS_ROOT", False);
+		if (event->type != PropertyNotify || event->xproperty.atom != focus)
+			return GDK_FILTER_CONTINUE;
+		if (!gtk_widget_get_realized(gtk_widget_get_toplevel(GTK_WIDGET(Plugin::mXfPlugin))))
+			return GDK_FILTER_CONTINUE;
+		Atom type;
+		int format;
+		gulong count, remaining;
+		guchar* data = nullptr;
+		XGetWindowProperty(display, DefaultRootWindow(display), focus, 0, 1, False, XA_WINDOW, &type, &format, &count, &remaining, &data);
+		Window owner = data && count ? *reinterpret_cast<Window*>(data) : None;
+		if (data)
+			XFree(data);
+		Window self = GDK_WINDOW_XID(gtk_widget_get_window(gtk_widget_get_toplevel(GTK_WIDGET(Plugin::mXfPlugin))));
+		if (owner != self)
+			Dock::dismissPreviews();
+		return GDK_FILTER_CONTINUE;
+	}
+#endif
+
 	// public:
+
+	// Ask a supporting window manager to focus its neutral input window.
+	void clearFocus()
+	{
+#ifdef ENABLE_X11
+		if (!GDK_IS_X11_DISPLAY(Plugin::mDisplay))
+			return;
+		GdkAtom atom = gdk_atom_intern_static_string("_FLUXBOX_FOCUS_ROOT");
+		if (!gdk_x11_screen_supports_net_wm_hint(gdk_screen_get_default(), atom))
+			return;
+		XEvent event = {};
+		event.xclient.type = ClientMessage;
+		event.xclient.window = GDK_WINDOW_XID(gdk_get_default_root_window());
+		event.xclient.message_type = gdk_x11_atom_to_xatom_for_display(Plugin::mDisplay, atom);
+		event.xclient.format = 32;
+		event.xclient.data.l[0] = GDK_WINDOW_XID(gtk_widget_get_window(gtk_widget_get_toplevel(GTK_WIDGET(Plugin::mXfPlugin))));
+		XSendEvent(GDK_DISPLAY_XDISPLAY(Plugin::mDisplay), event.xclient.window, False, SubstructureRedirectMask | SubstructureNotifyMask, &event);
+		gdk_display_flush(Plugin::mDisplay);
+#endif
+	}
 
