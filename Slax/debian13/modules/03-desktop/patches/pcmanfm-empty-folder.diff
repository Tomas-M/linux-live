+/* Distinguish a successfully empty folder from hidden items, loading and read failures. */
+static void update_empty_message(FmTabPage *page)
+{
+    FmFolderModel *model=fm_folder_view_get_model(page->folder_view);
+    gboolean visible=FALSE;
+    if (page->folder && model && !page->busy)
+    {
+        gboolean loaded=fm_folder_is_loaded(page->folder) && fm_folder_is_valid(page->folder);
+        gboolean failed=g_object_get_data(G_OBJECT(page->folder),"slax-load-error")!=NULL;
+        gboolean empty=gtk_tree_model_iter_n_children(GTK_TREE_MODEL(model),NULL)==0;
+        visible=loaded && !failed && empty;
+        if (visible) gtk_label_set_text(GTK_LABEL(page->empty_message),
+            fm_folder_is_empty(page->folder)?_("This folder is empty"):_("No visible items"));
+    }
+    gtk_widget_set_visible(page->empty_message,visible);
+}
