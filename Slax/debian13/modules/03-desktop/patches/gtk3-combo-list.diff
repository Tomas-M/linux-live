+/* Reveal the active row after the list receives its constrained viewport. */
+static void
+gtk_combo_box_list_scroll_active (GtkWidget     *tree_view,
+                                 GtkAllocation *allocation,
+                                 GtkComboBox   *combo_box)
+{
+  GtkComboBoxPrivate *priv = combo_box->priv;
+  gint height;
+
+  gtk_widget_get_size_request (priv->popup_window, NULL, &height);
+  if (allocation->height > height)
+    return;
+  g_signal_handlers_disconnect_by_func (tree_view, gtk_combo_box_list_scroll_active, combo_box);
+  if (gtk_tree_row_reference_valid (priv->active_row))
+    {
+      GtkTreePath *path = gtk_tree_row_reference_get_path (priv->active_row);
+      gtk_tree_view_scroll_to_cell (GTK_TREE_VIEW (tree_view), path, NULL, FALSE, 0.0, 0.0);
+      gtk_tree_path_free (path);
+    }
+}
