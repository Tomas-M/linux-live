      * check for duplications ourselves here. */
     switch(evt)
     {
+    case G_FILE_MONITOR_EVENT_RENAMED:
+    {
+        /* Keep the same file info and model row when its basename changes. */
+        GList *item = _fm_folder_get_file_by_path(folder, path);
+        FmPath *renamed = fm_path_new_for_gfile(other);
+        if(item)
+        {
+            GList *replaced = _fm_folder_get_file_by_path(folder, renamed);
+            if(replaced && replaced != item)
+                _fm_folder_event_file_deleted(folder, renamed);
+            fm_file_info_set_path(item->data, renamed);
+            if(!_fm_folder_event_file_changed(folder, renamed))
+                fm_path_unref(renamed);
+        }
+        else if(!_fm_folder_event_file_added(folder, renamed))
+            fm_path_unref(renamed);
+        fm_path_unref(path);
+        break;
+    }
+    case G_FILE_MONITOR_EVENT_MOVED_IN:
     case G_FILE_MONITOR_EVENT_CREATED:
         if (!_fm_folder_event_file_added(folder, path))
             fm_path_unref(path);
