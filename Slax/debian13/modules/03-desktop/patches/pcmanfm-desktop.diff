 static GtkWindow* desktop_pref_dlg = NULL;
 
+/* Run xrandr with separate arguments and stable, locale-independent output. */
+static gboolean screen_command(gchar **argv, gchar **output, GError **error)
+{
+    gchar **env = g_get_environ();
+    gchar *details = NULL;
+    gint status;
+    gboolean success;
+
+    env = g_environ_setenv(env, "LC_ALL", "C", TRUE);
+    success = g_spawn_sync(NULL, argv, env, G_SPAWN_SEARCH_PATH, NULL, NULL,
+                           output, &details, &status, error);
+    g_strfreev(env);
+    if(success && status != 0)
+    {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                            details && *details ? g_strstrip(details) : _("The display settings command failed."));
+        success = FALSE;
+    }
+    g_free(details);
+    if(!success && output)
+        g_clear_pointer(output, g_free);
+    return success;
+}
+
+/* Query only this monitor's modes, including its current mode and refresh rate. */
+static gboolean screen_modes(const gchar *output, GtkComboBoxText *combo,
+                             gchar **mode, gchar **rate, GError **error)
+{
+    gchar *argv[] = {"xrandr", "--query", NULL};
+    gchar *text = NULL, *current = NULL, *refresh = NULL;
+    gchar **lines;
+    gboolean active = FALSE;
+    guint i, j;
+
+    if(!screen_command(argv, &text, error))
+        return FALSE;
+    if(combo)
+        gtk_combo_box_text_remove_all(combo);
+    lines = g_strsplit(text, "\n", -1);
+    for(i = 0; lines[i]; i++)
+    {
+        gchar **words;
+        if(*lines[i] && !g_ascii_isspace(*lines[i]))
+        {
+            words = g_strsplit(lines[i], " ", 3);
+            active = g_strcmp0(words[0], output) == 0 && g_strcmp0(words[1], "connected") == 0;
+            g_strfreev(words);
+            continue;
+        }
+        if(!active)
+            continue;
+        words = g_strsplit_set(g_strstrip(lines[i]), " \t", -1);
+        if(!words[0])
+        {
+            g_strfreev(words);
+            continue;
+        }
+        if(*words[0] && combo)
+            gtk_combo_box_text_append(combo, words[0], words[0]);
+        for(j = 1; words[j]; j++)
+            if(strchr(words[j], '*'))
+            {
+                g_free(current);
+                g_free(refresh);
+                current = g_strdup(words[0]);
+                refresh = g_strndup(words[j], strcspn(words[j], "*+"));
+            }
+        g_strfreev(words);
+    }
+    g_strfreev(lines);
+    g_free(text);
+    if(!current)
+    {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND, _("No active display was found for this monitor."));
+        return FALSE;
+    }
+    if(combo)
+        gtk_combo_box_set_active_id(GTK_COMBO_BOX(combo), current);
+    if(mode) *mode = current;
+    else g_free(current);
+    if(rate) *rate = refresh;
+    else g_free(refresh);
+    return TRUE;
+}
+
+/* Preserve the other outputs and restore the original refresh rate on rollback. */
+static gboolean set_screen_mode(const gchar *output, const gchar *mode,
+                                const gchar *rate, GError **error)
+{
+    gchar *argv[] = {"xrandr", "--output", (gchar*)output, "--mode", (gchar*)mode,
+                    rate ? "--rate" : NULL, (gchar*)rate, NULL};
+    if(!screen_command(argv, NULL, error))
+        return FALSE;
+    g_spawn_command_line_async("fbvboxpointer", NULL);
+    return TRUE;
+}
