+/* Every unconfirmed change, including closing either dialog, restores the old mode. */
+static gboolean on_screen_resolution_apply(gpointer user_data)
+{
+    GtkComboBoxText *combo = user_data;
+    const gchar *output = g_object_get_data(G_OBJECT(combo), "screen-output");
+    gchar *selected = gtk_combo_box_text_get_active_text(combo);
+    gchar *previous = NULL, *rate = NULL;
+    GError *error = NULL;
+
+    g_object_set_data(G_OBJECT(combo), "resolution-pending", NULL);
+    if(!selected || !gtk_widget_get_parent(GTK_WIDGET(combo)))
+    {
+        g_free(selected);
+        return G_SOURCE_REMOVE;
+    }
+    if(!screen_modes(output, NULL, &previous, &rate, &error))
+        goto failed;
+    if(g_strcmp0(selected, previous) == 0)
+        goto finished;
+    if(!set_screen_mode(output, selected, NULL, &error))
+    {
+        set_screen_mode(output, previous, rate, NULL);
+        goto failed;
+    }
+    {
+        ScreenConfirmation confirmation;
+        guint timer;
+        gint response;
+        confirmation.dialog = gtk_message_dialog_new(desktop_pref_dlg,
+            GTK_DIALOG_MODAL | GTK_DIALOG_DESTROY_WITH_PARENT,
+            GTK_MESSAGE_QUESTION, GTK_BUTTONS_NONE, "%s", _("Keep this resolution?"));
+        g_object_ref(confirmation.dialog);
+        gtk_dialog_add_buttons(GTK_DIALOG(confirmation.dialog), _("_Revert"), GTK_RESPONSE_REJECT,
+                               _("_Keep changes"), GTK_RESPONSE_ACCEPT, NULL);
+        gtk_window_set_title(GTK_WINDOW(confirmation.dialog), _("Display settings"));
+        gtk_button_box_set_layout(GTK_BUTTON_BOX(gtk_dialog_get_action_area(GTK_DIALOG(confirmation.dialog))), GTK_BUTTONBOX_END);
+        gtk_box_set_spacing(GTK_BOX(gtk_dialog_get_action_area(GTK_DIALOG(confirmation.dialog))), 8);
+        gtk_container_set_border_width(GTK_CONTAINER(gtk_dialog_get_action_area(GTK_DIALOG(confirmation.dialog))), 12);
+        gtk_style_context_remove_class(gtk_widget_get_style_context(gtk_dialog_get_action_area(GTK_DIALOG(confirmation.dialog))), "linked");
+        gtk_dialog_set_default_response(GTK_DIALOG(confirmation.dialog), GTK_RESPONSE_REJECT);
+        gtk_window_set_position(GTK_WINDOW(confirmation.dialog), GTK_WIN_POS_NONE);
+        confirmation.deadline = g_get_monotonic_time() + 10 * G_USEC_PER_SEC;
+        screen_confirmation_tick(&confirmation);
+        g_object_set_data(G_OBJECT(combo), "screen-confirmation", confirmation.dialog);
+        on_screen_modes_changed(gtk_widget_get_screen(GTK_WIDGET(desktop_pref_dlg)), combo);
+        timer = g_timeout_add(100, screen_confirmation_tick, &confirmation);
+        response = gtk_dialog_run(GTK_DIALOG(confirmation.dialog));
+        g_source_remove(timer);
+        g_object_set_data(G_OBJECT(combo), "screen-confirmation", NULL);
+        gtk_widget_destroy(confirmation.dialog);
+        g_object_unref(confirmation.dialog);
+        if(response != GTK_RESPONSE_ACCEPT && !set_screen_mode(output, previous, rate, &error))
+            goto failed;
+    }
+    goto finished;
+failed:
+    fm_show_error(desktop_pref_dlg, _("Display settings"), error->message);
+    g_clear_error(&error);
+finished:
+    if(gtk_widget_get_parent(GTK_WIDGET(combo)))
+        on_screen_modes_changed(NULL, combo);
+    g_free(selected);
+    g_free(previous);
+    g_free(rate);
+    return G_SOURCE_REMOVE;
+}
+
+/* Let the combo popup finish closing and release its grab before opening a dialog. */
+static void on_screen_resolution_changed(GtkComboBoxText *combo, gpointer user_data)
+{
+    guint pending = GPOINTER_TO_UINT(g_object_get_data(G_OBJECT(combo), "resolution-pending"));
+    if(pending)
+        g_source_remove(pending);
+    pending = g_idle_add_full(G_PRIORITY_DEFAULT_IDLE, on_screen_resolution_apply, g_object_ref(combo), g_object_unref);
+    g_object_set_data(G_OBJECT(combo), "resolution-pending", GUINT_TO_POINTER(pending));
+}
