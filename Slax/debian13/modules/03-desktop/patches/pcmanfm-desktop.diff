+typedef struct
+{
+    GtkWidget *dialog;
+    gint64 deadline;
+} ScreenConfirmation;
+
+/* Use monotonic time so delays and clock corrections cannot extend the trial. */
+static gboolean screen_confirmation_tick(gpointer user_data)
+{
+    ScreenConfirmation *confirmation = user_data;
+    gint seconds = MAX(0, (confirmation->deadline - g_get_monotonic_time() + G_USEC_PER_SEC - 1) / G_USEC_PER_SEC);
+    gtk_message_dialog_format_secondary_text(GTK_MESSAGE_DIALOG(confirmation->dialog),
+        ngettext("The previous resolution will be restored in %d second.",
+                 "The previous resolution will be restored in %d seconds.", seconds), seconds);
+    if(seconds == 0)
+        gtk_dialog_response(GTK_DIALOG(confirmation->dialog), GTK_RESPONSE_REJECT);
+    return G_SOURCE_CONTINUE;
+}
