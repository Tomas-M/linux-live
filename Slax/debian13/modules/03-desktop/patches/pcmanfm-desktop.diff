+/* Keep the selector synchronized with hotplug and external resolution changes. */
+static void on_screen_modes_changed(GdkScreen *screen, GtkComboBoxText *combo)
+{
+    const gchar *output = g_object_get_data(G_OBJECT(combo), "screen-output");
+    gboolean available;
+    /* Resolution changes must not leave the preferences outside the work area. */
+    if(screen && desktop_pref_dlg && gtk_widget_get_realized(GTK_WIDGET(desktop_pref_dlg)))
+    {
+        GdkRectangle frame, bounds;
+        GdkWindow *window = gtk_widget_get_window(GTK_WIDGET(desktop_pref_dlg));
+        gint x, y;
+        gdk_window_get_frame_extents(window, &frame);
+        gdk_screen_get_monitor_workarea(screen, gdk_screen_get_monitor_at_window(screen, window), &bounds);
+        x = CLAMP(frame.x, bounds.x, MAX(bounds.x, bounds.x + bounds.width - frame.width));
+        y = CLAMP(frame.y, bounds.y, MAX(bounds.y, bounds.y + bounds.height - frame.height));
+        if(x != frame.x || y != frame.y)
+            gtk_window_move(desktop_pref_dlg, x, y);
+        /* Anchor the confirmation at the parent's visible upper-left corner. */
+        GtkWidget *confirmation = g_object_get_data(G_OBJECT(combo), "screen-confirmation");
+        if(confirmation)
+        {
+            GtkRequisition size;
+            gint width, height;
+            gtk_widget_get_preferred_size(confirmation, &size, NULL);
+            width = size.width + frame.width - gdk_window_get_width(window);
+            height = size.height + frame.height - gdk_window_get_height(window);
+            gtk_window_move(GTK_WINDOW(confirmation),
+                CLAMP(x + 8, bounds.x, MAX(bounds.x, bounds.x + bounds.width - width)),
+                CLAMP(y + 8, bounds.y, MAX(bounds.y, bounds.y + bounds.height - height)));
+        }
+    }
