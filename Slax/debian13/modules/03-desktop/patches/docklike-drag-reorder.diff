+	// Move real allocations, including their input windows, on GTK's frame clock.
+	static gboolean animateButtons(GtkWidget*, GdkFrameClock* clock, gpointer)
+	{
+		// Moving input windows can suppress native destination motion notifications.
+		if (dragging)
+			reorderButtons();
+		bool active = false;
+		gint64 now = gdk_frame_clock_get_frame_time(clock);
+		for (auto& entry : motions)
+		{
+			ButtonMotion& motion = entry.second;
+			double progress = std::min(1., std::max(0., (now - motion.started) / 180000.));
+			double eased = 1. - pow(1. - progress, 3.);
+			motion.shown = motion.target;
+			motion.shown.x = lround(motion.from.x + (motion.target.x - motion.from.x) * eased);
+			motion.shown.y = lround(motion.from.y + (motion.target.y - motion.from.y) * eased);
+			if (dragging && entry.first == dragging->mButton)
+			{
+				int x, y; GtkAllocation box;
+				gtk_widget_get_allocation(mBox, &box);
+				gdk_window_get_device_position(gtk_widget_get_window(mBox), gdk_drag_context_get_device(dragContext), &x, &y, nullptr);
+				if (gtk_orientable_get_orientation(GTK_ORIENTABLE(mBox)) == GTK_ORIENTATION_HORIZONTAL)
+					motion.shown.x = std::max(box.x, std::min(box.x + box.width - motion.target.width, (int)lround(x - dragOffset)));
+				else
+					motion.shown.y = std::max(box.y, std::min(box.y + box.height - motion.target.height, (int)lround(y - dragOffset)));
+			}
+			gtk_widget_size_allocate(entry.first, &motion.shown);
+			active |= progress < 1. && (motion.from.x != motion.target.x || motion.from.y != motion.target.y);
+		}
+		gtk_widget_queue_draw(mBox);
+		active |= dragging != nullptr;
+		if (!active)
+			motionTick = 0;
+		return active;
+	}
+
+	// Retarget from the currently displayed position when order or visibility changes.
+	static void layoutButtons()
+	{
+		auto visible = buttons(true);
+		for (auto it = motions.begin(); it != motions.end();)
+			if (std::find(visible.begin(), visible.end(), it->first) == visible.end())
+				it = motions.erase(it);
+			else
+				++it;
+		for (GtkWidget* widget : visible)
+		{
+			GtkAllocation target;
+			gtk_widget_get_allocation(widget, &target);
+			auto entry = motions.find(widget);
+			if (entry == motions.end())
+				motions.emplace(widget, ButtonMotion{target, target, target, g_get_monotonic_time()});
+			else
+			{
+				ButtonMotion& motion = entry->second;
+				if (target.x != motion.target.x || target.y != motion.target.y)
+				{
+					motion.from = motion.shown;
+					motion.started = g_get_monotonic_time();
+				}
+				motion.target = target;
+				motion.shown.width = target.width;
+				motion.shown.height = target.height;
+				gtk_widget_size_allocate(widget, &motion.shown);
+			}
+		}
+		if (!motionTick)
+			motionTick = gtk_widget_add_tick_callback(mBox, animateButtons, nullptr, nullptr);
+	}
+
+	// XEmbed proxies hide the source widget; match our active pointer and drag target.
+	bool isGroupDrag(GdkDragContext* context)
+	{
+		if (!dragging)
+			return false;
+		GdkAtom target = gdk_atom_intern_static_string("application/docklike_group");
+		return gdk_drag_context_get_device(context) == gdk_drag_context_get_device(dragContext)
+			&& g_list_find(gdk_drag_context_list_targets(context), target);
+	}
+
+	// Preview and click handlers share the active native transaction.
+	bool isDragging()
+	{
+		return dragging != nullptr;
+	}
+
+	// Commit completed reorders; cancellation restores surviving originals.
+	void finishDrag(bool commit)
+	{
+		if (!dragging)
+			return;
+		auto source = dragging;
+		auto motion = motions.find(source->mButton);
+		if (motion != motions.end())
+		{
+			motion->second.from = motion->second.shown;
+			motion->second.started = g_get_monotonic_time();
+		}
+		dragging.reset();
+		g_clear_object(&dragContext);
+		if (!commit)
+		{
+			int position = 0;
+			for (auto& weak : originalOrder)
+				if (auto group = weak.lock())
+					if (gtk_widget_get_parent(group->mButton) == mBox && gtk_widget_get_visible(group->mButton))
+						gtk_box_reorder_child(GTK_BOX(mBox), group->mButton, position++);
+		}
+		originalOrder.clear();
+		source->mPreviewSuppressed = true;
+		savePinned();
+	}
+
+	// Late GTK completion signals belong only to their original source transaction.
+	void endDrag(GdkDragContext* context, bool commit)
+	{
+		if (context == dragContext)
+			finishDrag(commit);
+	}
+
+	// Keep the source alive until GTK releases its drag, even if its last window closes.
+	void beginDrag(Group* group, GdkDragContext* context)
+	{
+		finishDrag(false);
+		dismissPreviews();
+		dragging = mGroups.get(group->mAppInfo);
+		dragContext = GDK_DRAG_CONTEXT(g_object_ref(context));
+		// Keep the default pointer instead of GTK's action cursor for this panel drag.
+		g_signal_connect(context, "action-changed", G_CALLBACK(+[](GdkDragContext* source, GdkDragAction, gpointer) { g_signal_stop_emission_by_name(source, "action-changed"); }), nullptr);
+		for (GtkWidget* widget : buttons(true))
+		{
+			Group* item = (Group*)g_object_get_data(G_OBJECT(widget), "group");
+			originalOrder.push_back(mGroups.get(item->mAppInfo));
+		}
+		dragOffset = gtk_orientable_get_orientation(GTK_ORIENTABLE(mBox)) == GTK_ORIENTATION_HORIZONTAL ? group->mDragPressX : group->mDragPressY;
+		gtk_widget_queue_resize(mBox);
+	}
+
+	// GTK owns the pointer and Escape handling; cancel without resurrecting closed groups.
+	void cancelDrag()
+	{
+		if (dragContext)
+		{
+			GdkDragContext* context = GDK_DRAG_CONTEXT(g_object_ref(dragContext));
+			gtk_drag_cancel(context);
+			finishDrag(false);
+			g_object_unref(context);
+		}
+	}
+
+	// Target slots remain stable while their displayed buttons slide toward them.
+	static GtkAllocation buttonSlot(GtkWidget* widget)
+	{
+		auto entry = motions.find(widget);
+		if (entry != motions.end())
+			return entry->second.target;
+		GtkAllocation slot;
+		gtk_widget_get_allocation(widget, &slot);
+		return slot;
+	}
+
+	// Yield when the moving button overlaps a neighbour, accounting for its grab offset.
+	static void reorderButtons()
+	{
+		int x, y;
+		gdk_window_get_device_position(gtk_widget_get_window(mBox), gdk_drag_context_get_device(dragContext), &x, &y, nullptr);
+		bool horizontal = gtk_orientable_get_orientation(GTK_ORIENTABLE(mBox)) == GTK_ORIENTATION_HORIZONTAL;
+		auto visible = buttons(true);
+		int current = std::find(visible.begin(), visible.end(), dragging->mButton) - visible.begin();
+		int position = current;
+		GtkAllocation source = buttonSlot(dragging->mButton);
+		double size = horizontal ? source.width : source.height;
+		double start = (horizontal ? x : y) - dragOffset;
+		double centre = start + size / 2.;
+		double slotCentre = horizontal ? source.x + source.width / 2. : source.y + source.height / 2.;
+		if (centre > slotCentre)
+		{
+			while (position + 1 < (int)visible.size())
+			{
+				GtkAllocation next = buttonSlot(visible[position + 1]);
+				if (start + size < (horizontal ? next.x + next.width / 2. : next.y + next.height / 2.))
+					break;
+				++position;
+			}
+		}
+		else if (centre < slotCentre)
+		{
+			while (position > 0)
+			{
+				GtkAllocation previous = buttonSlot(visible[position - 1]);
+				if (start > (horizontal ? previous.x + previous.width / 2. : previous.y + previous.height / 2.))
+					break;
+				--position;
+			}
+		}
+		if (position != current)
+		{
+			auto children = buttons();
+			int index = std::find(children.begin(), children.end(), visible[position]) - children.begin();
+			gtk_box_reorder_child(GTK_BOX(mBox), dragging->mButton, index);
+			// Allocate now: an embedded panel may defer an unchanged size until the drop.
+			GtkAllocation allocation;
+			gtk_widget_get_allocation(mBox, &allocation);
+			gtk_widget_size_allocate(mBox, &allocation);
+		}
+	}
+
+	// Acknowledge GTK destination events separately from source-frame position updates.
+	bool dragMotion(GdkDragContext* context, guint time)
+	{
+		if (!isGroupDrag(context))
+			return false;
+		reorderButtons();
+		gdk_drag_status(context, GDK_ACTION_MOVE, time);
+		return true;
+	}
+
+	// Sources can disappear when an application closes during a drag.
+	void groupHidden(Group* group)
+	{
+		if (dragging.get() == group)
+			cancelDrag();
+	}
+
+	// Accept only our active transaction, including drops between button hit areas.
+	void dropGroup(GdkDragContext* context)
+	{
+		if (isGroupDrag(context))
+			finishDrag(true);
+	}
+
+	// Draw the moving button once, above its neighbours, while retaining native hit testing.
+	bool skipDragDraw(GtkWidget* widget)
+	{
+		return dragging && widget == dragging->mButton && !paintingDrag;
+	}
