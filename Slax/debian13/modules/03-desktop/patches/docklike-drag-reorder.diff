+	// Enumerate current children instead of keeping pointers to closed applications.
+	static std::vector<GtkWidget*> buttons(bool visible = false)
+	{
+		std::vector<GtkWidget*> result;
+		GList* children = gtk_container_get_children(GTK_CONTAINER(mBox));
+		for (GList* child = children; child; child = child->next)
+			if (!visible || gtk_widget_get_visible(GTK_WIDGET(child->data)))
+				result.push_back(GTK_WIDGET(child->data));
+		g_list_free(children);
+		return result;
+	}
