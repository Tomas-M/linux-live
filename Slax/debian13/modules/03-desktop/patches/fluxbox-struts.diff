+// Translate root-coordinate EWMH reservations into per-monitor edge widths.
+Strut *BScreen::requestStrut(const unsigned long *values)
+{
+    Strut *next=0;
+    int rootWidth=width(), rootHeight=height();
+    for (int head=1; head<=std::max(1,numHeads()); ++head)
+    {
+        int x=getHeadX(head), y=getHeadY(head);
+        int w=getHeadWidth(head), h=getHeadHeight(head);
+        int offsets[4]={x,rootWidth-x-w,y,rootHeight-y-h};
+        int lengths[4]={w,w,h,h};
+        int starts[4]={y,y,x,x}, ends[4]={y+h,y+h,x+w,x+w};
+        int reserved[4]={0,0,0,0};
+        for (int edge=0; edge<4; ++edge)
+        {
+            unsigned long start=values[4+2*edge], end=values[5+2*edge];
+            bool validRange=start<=end;
+            bool overlaps=start<static_cast<unsigned long>(ends[edge]) && end>=static_cast<unsigned long>(starts[edge]);
+            if (validRange && overlaps)
+            {
+                int limit=edge<2 ? rootWidth : rootHeight;
+                int thickness=std::min<unsigned long>(values[edge],limit);
+                reserved[edge]=std::max(0,std::min(lengths[edge],thickness-offsets[edge]));
+            }
+        }
+        next=m_head_areas[head-1]->requestStrut(head,reserved[0],reserved[1],reserved[2],reserved[3],next);
+    }
+    return next;
+}
+
 void BScreen::clearStrut(Strut *str) {
     if (str->next())
         clearStrut(str->next());
