+// Prefer partial struts, validate X11 data and clear withdrawn reservations.
+void Ewmh::updateStrut(WinClient &winclient)
+{
+    BScreen &screen=winclient.screen();
+    Strut *strut=0;
+    Atom properties[2]={m_net->wm_strut_partial,m_net->wm_strut};
+    for (int i=0; i<2; ++i)
+    {
+        Atom type=0;
+        int format=0;
+        unsigned long count=i==0 ? 12 : 4, items=0, remaining=0;
+        unsigned long *data=0;
+        bool readable=winclient.property(properties[i],0,count,False,XA_CARDINAL,
+                                        &type,&format,&items,&remaining,(unsigned char **)&data);
+        bool cardinal=type==XA_CARDINAL && format==32;
+        bool complete=data && items==count && remaining==0;
+        bool valid=readable && cardinal && complete;
+        if (valid)
+        {
+            unsigned long values[12]={0,0,0,0,0,screen.height()-1,0,screen.height()-1,
+                                     0,screen.width()-1,0,screen.width()-1};
+            std::copy(data,data+count,values);
+            strut=screen.requestStrut(values);
+        }
+        if (data) XFree(data);
+        if (valid) break;
+    }
+    winclient.setStrut(strut);
+    screen.updateAvailableWorkspaceArea();
 }
 
 
