+// Cache an inset one-pixel ring using the same antialiased curves as window clipping.
+static void xrender_outline(struct xrender_data *xd, struct xrender_image_data_inner *inner,
+                             xcb_render_picture_t picture, int radius, bool active) {
+	radius = min3(radius, inner->size.width / 2, inner->size.height / 2);
+	if (inner->outline && inner->outline->radius != radius) {
+		xrender_release_rounded_corner_cache(&xd->base, inner->outline);
+		inner->outline = NULL;
+	}
+	if (!inner->outline) {
+		inner->outline = xrender_make_rounded_corner_cache(
+		    xd->base.c, xd->white_pixel, inner->size.width, inner->size.height,
+		    radius, xd->round_top_only);
+		if (inner->size.width > 2 && inner->size.height > 2) {
+			auto inset = xrender_make_rounded_corner_cache(
+			    xd->base.c, xd->white_pixel, inner->size.width - 2,
+			    inner->size.height - 2, max2(0, radius - 1), xd->round_top_only);
+			xcb_render_composite(xd->base.c->c, XCB_RENDER_PICT_OP_OUT_REVERSE,
+			                     inset->p, XCB_NONE, inner->outline->p,
+			                     0, 0, 0, 0, 1, 1,
+			                     to_u16_checked(inner->size.width - 2),
+			                     to_u16_checked(inner->size.height - 2));
+			xrender_release_rounded_corner_cache(&xd->base, inset);
+		}
+	}
+	// ATOP preserves native CSD alpha, including transparent rounded corners.
+	xcb_render_composite(xd->base.c->c, XCB_RENDER_PICT_OP_ATOP, xd->outline_pixels[active],
+	                     inner->outline->p, picture, 0, 0, 0, 0, 0, 0,
+	                     to_u16_checked(inner->size.width),
+	                     to_u16_checked(inner->size.height));
 }
 
