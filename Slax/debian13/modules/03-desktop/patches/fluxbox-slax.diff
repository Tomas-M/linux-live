+// CENTER means that this point is not an enabled resize border.
+FluxboxWindow::ReferenceCorner FluxboxWindow::getBorderResizeDirection(int x, int y) const {
+    if (!isResizable() || isShaded() || Fluxbox::instance()->getIgnoreBorder())
+        return CENTER;
+    if ((isMaximized() || isFullscreen()) && screen().getMaxDisableResize())
+        return CENTER;
+    if (x >= 0 && x < (int)frame().width() && y >= 0 && y < (int)frame().height())
+        return CENTER;
+    int border = frame().window().borderWidth();
+    return getResizeDirection(x, y, EDGEORCORNERRESIZE, border, border);
+}
+
+// Reuse the active theme's directional cursors for both hover and the grab.
+Cursor FluxboxWindow::getResizeCursor(ReferenceCorner dir) const {
+    if (dir == LEFTTOP) return frame().theme()->upperLeftAngleCursor();
+    if (dir == RIGHTTOP) return frame().theme()->upperRightAngleCursor();
+    if (dir == RIGHTBOTTOM) return frame().theme()->lowerRightAngleCursor();
+    if (dir == LEFTBOTTOM) return frame().theme()->lowerLeftAngleCursor();
+    if (dir == LEFT) return frame().theme()->leftSideCursor();
+    if (dir == RIGHT) return frame().theme()->rightSideCursor();
+    if (dir == TOP) return frame().theme()->topSideCursor();
+    if (dir == BOTTOM) return frame().theme()->bottomSideCursor();
+    return None;
+}
+
+// X coordinates are relative to the inside of the frame's outer border.
+void FluxboxWindow::updateBorderCursor(int x, int y) {
+    frame().window().setCursor(getResizeCursor(getBorderResizeDirection(x, y)));
+}
