+/* Complete an ordinary unmount without blocking GTK or hiding a failed mount. */
+static void on_bookmark_unmounted(GObject* source, GAsyncResult* result, gpointer user_data)
+{
+    GtkWidget* view = user_data;
+    GtkWidget* parent = gtk_widget_get_toplevel(view);
+    GError* error = NULL;
+    char* message = NULL;
+    gboolean completed = g_subprocess_communicate_utf8_finish(G_SUBPROCESS(source), result, NULL, &message, &error);
+    if(!completed || !g_subprocess_get_successful(G_SUBPROCESS(source)))
+        fm_show_error(GTK_IS_WINDOW(parent) ? GTK_WINDOW(parent) : NULL, NULL,
+                      error ? error->message : message);
+    g_clear_error(&error);
+    g_free(message);
+    gtk_widget_queue_draw(view);
+    g_object_unref(view);
+}
