+/* A themed sidebar button inside the tree cell keeps the native Places model. */
+typedef GtkCellRendererPixbuf FmMountIndicator;
+typedef GtkCellRendererPixbufClass FmMountIndicatorClass;
+G_DEFINE_TYPE(FmMountIndicator, _fm_mount_indicator, GTK_TYPE_CELL_RENDERER_PIXBUF);
+
+enum { MOUNT_BUTTON_SIZE = 26, MOUNT_BUTTON_MARGIN = 3 };
+
+/* Draw the same circular sidebar button used by GTK's file chooser. */
+static void mount_indicator_render(GtkCellRenderer* cell, cairo_t* cr, GtkWidget* widget,
+                                   const GdkRectangle* background, const GdkRectangle* area,
+                                   GtkCellRendererState flags)
+{
+    char* icon = NULL;
+    g_object_get(cell, "icon-name", &icon, NULL);
+    if(!icon) return;
+    GtkWidget* button = g_object_get_data(G_OBJECT(cell), "sidebar-button");
+    GtkStyleContext* style = gtk_widget_get_style_context(button);
+    int x = area->x+(area->width-MOUNT_BUTTON_SIZE)/2;
+    int y = area->y+(area->height-MOUNT_BUTTON_SIZE)/2;
+    int pointer_x, pointer_y;
+    GdkModifierType modifiers;
+    GdkDevice* pointer = gdk_seat_get_pointer(gdk_display_get_default_seat(gtk_widget_get_display(widget)));
+    gdk_window_get_device_position(gtk_tree_view_get_bin_window(GTK_TREE_VIEW(widget)), pointer,
+                                   &pointer_x, &pointer_y, &modifiers);
+    gboolean hover = pointer_x >= x && pointer_x < x+MOUNT_BUTTON_SIZE;
+    hover = hover && pointer_y >= y && pointer_y < y+MOUNT_BUTTON_SIZE;
+    GtkStateFlags state = GTK_STATE_FLAG_NORMAL;
+    if(hover) state = modifiers & GDK_BUTTON1_MASK ? GTK_STATE_FLAG_ACTIVE : GTK_STATE_FLAG_PRELIGHT;
+    if(flags & GTK_CELL_RENDERER_SELECTED) gtk_style_context_add_class(style, "selected-place");
+    else gtk_style_context_remove_class(style, "selected-place");
+    gtk_style_context_set_state(style, state);
+    gtk_render_background(style, cr, x, y, MOUNT_BUTTON_SIZE, MOUNT_BUTTON_SIZE);
+    gtk_render_frame(style, cr, x, y, MOUNT_BUTTON_SIZE, MOUNT_BUTTON_SIZE);
+    /* Resolve symbolic colors against the button, independently of row selection. */
+    int scale = gtk_widget_get_scale_factor(widget);
+    GtkIconTheme* theme = gtk_icon_theme_get_for_screen(gtk_widget_get_screen(widget));
+    GtkIconInfo* info = gtk_icon_theme_lookup_icon_for_scale(theme, icon, 16, scale, 0);
+    g_free(icon);
+    if(!info) return;
+    GdkPixbuf* symbol = gtk_icon_info_load_symbolic_for_context(info, style, NULL, NULL);
+    g_object_unref(info);
+    if(!symbol) return;
+    cairo_surface_t* image = gdk_cairo_surface_create_from_pixbuf(symbol, scale, gtk_widget_get_window(widget));
+    cairo_push_group(cr);
+    gtk_render_icon_surface(style, cr, image, x+(MOUNT_BUTTON_SIZE-gdk_pixbuf_get_width(symbol)/scale)/2,
+                             y+(MOUNT_BUTTON_SIZE-gdk_pixbuf_get_height(symbol)/scale)/2);
+    cairo_pop_group_to_source(cr);
+    cairo_paint_with_alpha(cr, hover ? 1.0 : 0.7);
+    cairo_surface_destroy(image);
+    g_object_unref(symbol);
+}
+
+/* Keep the circular button's theme context alive for the renderer. */
+static void _fm_mount_indicator_init(FmMountIndicator* self)
+{
+    GtkWidget* button = gtk_button_new();
+    GtkStyleContext* style = gtk_widget_get_style_context(button);
+    gtk_style_context_add_class(style, "image-button");
+    gtk_style_context_add_class(style, "sidebar-button");
+    g_object_set_data_full(G_OBJECT(self), "sidebar-button", g_object_ref_sink(button), g_object_unref);
+    gtk_cell_renderer_set_fixed_size(GTK_CELL_RENDERER(self), MOUNT_BUTTON_SIZE+2*MOUNT_BUTTON_MARGIN,
+                                     MOUNT_BUTTON_SIZE+2*MOUNT_BUTTON_MARGIN);
+}
+
+/* Use GTK's icon renderer for the symbol and add the native button frame. */
+static void _fm_mount_indicator_class_init(FmMountIndicatorClass* klass)
+{
+    GTK_CELL_RENDERER_CLASS(klass)->render = mount_indicator_render;
+}
+
+/* Redraw when the pointer moves between the row label and its action button. */
+static gboolean on_mount_pointer(GtkWidget* widget, GdkEvent* event, gpointer user_data)
+{
+    gtk_widget_queue_draw(widget);
+    return FALSE;
+}
