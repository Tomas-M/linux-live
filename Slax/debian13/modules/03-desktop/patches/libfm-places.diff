+/* Refresh generated media bookmarks outside GTK when any mount changes. */
+static void on_unix_mounts_changed(GUnixMountMonitor* monitor, gpointer user_data)
+{
+    if(geteuid() != 0) return;
+    char* argv[] = {"/usr/sbin/gtk-bookmarks-update", NULL};
+    GError* error = NULL;
+    if(!g_spawn_async(NULL, argv, NULL, 0, NULL, NULL, NULL, &error))
+    {
+        g_warning("Cannot refresh media bookmarks: %s", error->message);
+        g_error_free(error);
+    }
+}
