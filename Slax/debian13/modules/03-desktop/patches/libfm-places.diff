 gboolean fm_places_item_is_mounted(FmPlacesItem* item)
 {
+    /* Bookmarks only offer unmount for an exact, non-system mount point. */
+    if(item->type == FM_PLACES_ITEM_PATH && item->bm_item)
+    {
+        FmPath* path = fm_file_info_get_path(item->fi);
+        if(!fm_path_is_native(path)) return FALSE;
+        char* filename = fm_path_to_str(path);
+        GUnixMountEntry* mount = g_unix_mount_at(filename, NULL);
+        gboolean mounted = mount && !g_unix_is_mount_path_system_internal(filename);
+        if(mount) g_unix_mount_free(mount);
+        g_free(filename);
+        return mounted;
+    }
     return item->mounted ? TRUE : FALSE;
 }
 
