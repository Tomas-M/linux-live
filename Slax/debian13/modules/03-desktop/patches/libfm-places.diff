+/* Use identical button bounds on press and release, before GTK can select the row. */
+static gboolean mount_indicator_hit(FmPlacesView *view,GdkEventButton *event,GtkTreePath *path,GtkTreeViewColumn *column,int cell_x)
+{
+    GtkTreeIter iter;
+    FmPlacesItem *item=NULL;
+    if(!gtk_tree_model_get_iter(GTK_TREE_MODEL(model),&iter,path)) return FALSE;
+    gtk_tree_model_get(GTK_TREE_MODEL(model),&iter,FM_PLACES_MODEL_COL_INFO,&item,-1);
+    if(!item || (!fm_places_item_get_native(item) && !fm_places_item_is_mounted(item))) return FALSE;
+    gtk_tree_view_column_cell_set_cell_data(column,GTK_TREE_MODEL(model),&iter,FALSE,FALSE);
+    int start,width;
+    gtk_tree_view_column_cell_get_position(column,GTK_CELL_RENDERER(view->mount_indicator_renderer),&start,&width);
+    GdkRectangle area;
+    gtk_tree_view_get_cell_area(GTK_TREE_VIEW(view),path,column,&area);
+    double top=area.y+(area.height-MOUNT_BUTTON_SIZE)/2.0;
+    gboolean inside_x=cell_x>=start+MOUNT_BUTTON_LEFT && cell_x<start+MOUNT_BUTTON_LEFT+MOUNT_BUTTON_SIZE;
+    gboolean inside_y=event->y>=top && event->y<top+MOUNT_BUTTON_SIZE;
+    return inside_x && inside_y;
+}
