Description: Keep group selection and preview hover valid while windows are removed
Author: Slax <build@slax.org>
Forwarded: no
--- a/src/Group.cpp
+++ b/src/Group.cpp
@@ -246,7 +246,14 @@
 
 void Group::remove(GroupWindow* window)
 {
+	// Preserve the selected window as earlier entries shift, or select the first survivor.
+	uint removedIndex = mWindows.getIndex(window);
 	mWindows.pop(window);
+	if (mTopWindowIndex > removedIndex)
+		--mTopWindowIndex;
+	else if (mTopWindowIndex == removedIndex)
+		mTopWindowIndex = 0;
+
 	mWindowsCount.updateState();
 	if (!mWindowsCount && Dock::mSelectedGroup == this)
 		Dock::selectGroup(nullptr);
