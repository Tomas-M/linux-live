 void GroupMenu::hide()
 {
+	mGroup->mWindows.forEach([](GroupWindow* window) -> void {
+		window->mGroupMenuItem->peek(false);
+	});
 	mVisible = false;
 	gtk_widget_hide(mWindow);
 }
