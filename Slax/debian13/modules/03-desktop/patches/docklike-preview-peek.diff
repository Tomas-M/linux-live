+// Dim other clients through Picom without changing focus, stacking or minimization.
+void GroupMenuItem::peek(bool show)
+{
+#ifdef ENABLE_X11
+	if (!GDK_IS_X11_DISPLAY(Plugin::mDisplay))
+		return;
+	if (show && !Settings::showPreviews)
+		return;
+	if (show && mGroupWindow->getState(XFW_WINDOW_STATE_MINIMIZED))
+		return;
+	if (show && !mPeekWindows.empty())
+		return;
+
+	Display* display = GDK_DISPLAY_XDISPLAY(Plugin::mDisplay);
+	Atom property = XInternAtom(display, "_SLAX_PREVIEW_DIM", False);
+	gdk_x11_display_error_trap_push(Plugin::mDisplay);
+	if (show)
+	{
+		gulong dim = 1;
+		for (GList* node = xfw_screen_get_windows(Xfw::mXfwScreen); node != nullptr; node = node->next)
+		{
+			XfwWindow* window = XFW_WINDOW(node->data);
+			if (window == mGroupWindow->mXfwWindow)
+				continue;
+			Window xid = xfw_window_x11_get_xid(window);
+			mPeekWindows.push_back(xid);
+			XChangeProperty(display, xid, property, XA_CARDINAL, 32, PropModeReplace, (const guchar*)&dim, 1);
+		}
+	}
+	else
+	{
+		for (gulong window : mPeekWindows)
+			XDeleteProperty(display, window, property);
+		mPeekWindows.clear();
+	}
+	gdk_x11_display_error_trap_pop_ignored(Plugin::mDisplay);
+#endif
+}
