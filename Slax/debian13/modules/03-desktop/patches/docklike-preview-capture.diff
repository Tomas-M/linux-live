@@ -0,0 +1,153 @@
+#include "PreviewCapture.hpp"
+
+// Negotiate the standard extension once for this display connection.
+PreviewCapture::PreviewCapture() : mDisplay(gdk_display_get_default())
+{
+	if (!GDK_IS_X11_DISPLAY(mDisplay))
+		return;
+	int major = 0, minor = 4;
+	if (XCompositeQueryVersion(GDK_DISPLAY_XDISPLAY(mDisplay), &major, &minor))
+		mCompositeAvailable = major > 0 || minor >= 2;
+}
+
+// Release the server reference even when the application has already closed.
+PreviewCapture::~PreviewCapture()
+{
+	clear();
+}
+
+// A pixmap reference is not a copied screenshot and must not outlive its owner.
+void PreviewCapture::clear()
+{
+	if (!mPixmap)
+		return;
+	gdk_x11_display_error_trap_push(mDisplay);
+	XFreePixmap(GDK_DISPLAY_XDISPLAY(mDisplay), mPixmap);
+	gdk_x11_display_error_trap_pop_ignored(mDisplay);
+	mPixmap = None;
+}
+
+// Retain the frame and client crop; retry only transient failures of mapped windows.
+bool PreviewCapture::prepare(Window window)
+{
+	if (!mCompositeAvailable || !gdk_screen_is_composited(gdk_display_get_default_screen(mDisplay)))
+	{
+		clear();
+		return true;
+	}
+	Display* display = GDK_DISPLAY_XDISPLAY(mDisplay);
+	XWindowAttributes client, frameAttributes;
+	Window frame = window, root, parent, child;
+	GdkRectangle area;
+	gdk_x11_display_error_trap_push(mDisplay);
+	bool valid = XGetWindowAttributes(display, window, &client) && client.map_state == IsViewable;
+	if (!valid)
+	{
+		gdk_x11_display_error_trap_pop_ignored(mDisplay);
+		return true;
+	}
+	while (valid)
+	{
+		Window* children = nullptr;
+		unsigned count;
+		valid = XQueryTree(display, frame, &root, &parent, &children, &count);
+		if (children)
+			XFree(children);
+		if (!valid || parent == root)
+			break;
+		frame = parent;
+	}
+	if (valid)
+		valid = XGetWindowAttributes(display, frame, &frameAttributes);
+	if (valid)
+		valid = XTranslateCoordinates(display, window, frame, 0, 0, &area.x, &area.y, &child);
+	Pixmap pixmap = valid ? XCompositeNameWindowPixmap(display, frame) : None;
+	int error = gdk_x11_display_error_trap_pop(mDisplay);
+	if (error || !pixmap)
+		return false;
+	unsigned width, height, border, depth;
+	int left, top;
+	XGetGeometry(display, pixmap, &root, &left, &top, &width, &height, &border, &depth);
+	area.x += frameAttributes.border_width;
+	area.y += frameAttributes.border_width;
+	area.width = client.width;
+	area.height = client.height;
+	// Client and frame resize requests can interleave; retry inconsistent crops.
+	bool nonnegative = area.x >= 0 && area.y >= 0;
+	bool fits = area.x + area.width <= static_cast<int>(width) && area.y + area.height <= static_cast<int>(height);
+	if (!nonnegative || !fits)
+	{
+		XFreePixmap(display, pixmap);
+		return false;
+	}
+	clear();
+	mPixmap = pixmap;
+	mFrame = frameAttributes;
+	mFrame.width = width;
+	mFrame.height = height;
+	mArea = area;
+	return true;
+}
+
+// Keep a bounded image after unmapping, then release the native backing reference.
+cairo_surface_t* PreviewCapture::snapshot(Window window, int maxWidth, int maxHeight, int scale)
+{
+	if (!GDK_IS_X11_DISPLAY(mDisplay))
+		return nullptr;
+	Display* display = GDK_DISPLAY_XDISPLAY(mDisplay);
+	XWindowAttributes attributes;
+	gdk_x11_display_error_trap_push(mDisplay);
+	bool valid = XGetWindowAttributes(display, window, &attributes);
+	int error = gdk_x11_display_error_trap_pop(mDisplay);
+	if (!valid || error)
+		return nullptr;
+	if (attributes.map_state == IsViewable && !prepare(window))
+		return nullptr;
+
+	cairo_surface_t* source = nullptr;
+	GdkRectangle area = mArea;
+	gdk_x11_display_error_trap_push(mDisplay);
+	if (mPixmap)
+		source = cairo_xlib_surface_create(display, mPixmap, mFrame.visual, mFrame.width, mFrame.height);
+	else if (attributes.map_state == IsViewable && !gdk_screen_is_composited(gdk_display_get_default_screen(mDisplay)))
+	{
+		// Preserve operation without a compositor, but never sample unmapped drawables.
+		GdkWindow* foreign = gdk_x11_window_foreign_new_for_display(mDisplay, window);
+		GdkPixbuf* pixels = foreign ? gdk_pixbuf_get_from_window(foreign, 0, 0, attributes.width, attributes.height) : nullptr;
+		if (pixels)
+		{
+			source = gdk_cairo_surface_create_from_pixbuf(pixels, 1, nullptr);
+			area = {0, 0, gdk_pixbuf_get_width(pixels), gdk_pixbuf_get_height(pixels)};
+			g_object_unref(pixels);
+		}
+		if (foreign)
+			g_object_unref(foreign);
+	}
+	cairo_surface_t* result = nullptr;
+	if (source)
+	{
+		double fit = std::min(static_cast<double>(maxWidth) / area.width, static_cast<double>(maxHeight) / area.height) * scale;
+		int width = std::max(1, static_cast<int>(area.width * fit));
+		int height = std::max(1, static_cast<int>(area.height * fit));
+		result = cairo_image_surface_create(CAIRO_FORMAT_ARGB32, width, height);
+		cairo_t* cr = cairo_create(result);
+		cairo_scale(cr, static_cast<double>(width) / area.width, static_cast<double>(height) / area.height);
+		cairo_set_source_surface(cr, source, -area.x, -area.y);
+		cairo_pattern_set_filter(cairo_get_source(cr), CAIRO_FILTER_BILINEAR);
+		cairo_paint(cr);
+		valid = cairo_status(cr) == CAIRO_STATUS_SUCCESS;
+		cairo_destroy(cr);
+		cairo_surface_destroy(source);
+		cairo_surface_flush(result);
+		cairo_surface_set_device_scale(result, scale, scale);
+	}
+	error = gdk_x11_display_error_trap_pop(mDisplay);
+	if (attributes.map_state != IsViewable)
+		clear();
+	if (result && (error || !valid || cairo_surface_status(result) != CAIRO_STATUS_SUCCESS))
+	{
+		cairo_surface_destroy(result);
+		result = nullptr;
+	}
+	return result;
+}
