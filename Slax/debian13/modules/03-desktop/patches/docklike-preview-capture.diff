@@ -0,0 +1,27 @@
+#ifndef PREVIEW_CAPTURE_HPP
+#define PREVIEW_CAPTURE_HPP
+
+#include <gdk/gdkx.h>
+#include <cairo-xlib.h>
+#include <X11/extensions/Xcomposite.h>
+#include <algorithm>
+
+// Retain the compositor's existing backing pixmap until an unmapped window is sampled.
+class PreviewCapture
+{
+public:
+	PreviewCapture();
+	~PreviewCapture();
+	bool prepare(Window window);
+	cairo_surface_t* snapshot(Window window, int maxWidth, int maxHeight, int scale);
+	void clear();
+
+private:
+	GdkDisplay* mDisplay;
+	Pixmap mPixmap = None;
+	XWindowAttributes mFrame = {};
+	GdkRectangle mArea = {};
+	bool mCompositeAvailable = false;
+};
+
+#endif
