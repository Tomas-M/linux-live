+// Preserve the root hit area through pending delays and synthetic crossings.
+void GroupMenuItem::updatePeekArea()
+{
+	GtkWidget* widget = GTK_WIDGET(mItem);
+	GtkWidget* window = gtk_widget_get_toplevel(widget);
+	int left, top;
+	gdk_window_get_origin(gtk_widget_get_window(window), &left, &top);
+	gtk_widget_translate_coordinates(widget, window, 0, 0, &mPeekArea.x, &mPeekArea.y);
+	mPeekArea.x += left;
+	mPeekArea.y += top;
+	mPeekArea.width = gtk_widget_get_allocated_width(widget);
+	mPeekArea.height = gtk_widget_get_allocated_height(widget);
+}
+
