+
+// Ignore synthetic crossings and stale hide timers while the pointer is on the icon.
+bool Group::pointerInside()
+{
+	GdkRectangle point = {0, 0, 1, 1}, area;
+	gdk_device_get_position(Plugin::mPointer, nullptr, &point.x, &point.y);
+	GtkWidget* window = gtk_widget_get_toplevel(mButton);
+	int left, top;
+	gdk_window_get_origin(gtk_widget_get_window(window), &left, &top);
+	gtk_widget_translate_coordinates(mButton, window, 0, 0, &area.x, &area.y);
+	area.x += left;
+	area.y += top;
+	area.width = gtk_widget_get_allocated_width(mButton);
+	area.height = gtk_widget_get_allocated_height(mButton);
+	return gdk_rectangle_intersect(&area, &point, nullptr);
 }
 
