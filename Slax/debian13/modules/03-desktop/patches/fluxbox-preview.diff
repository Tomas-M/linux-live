+
+// Reuse the current logical order, and never undo a subsequent raise or cycle.
+void Layer::preview(LayerItem &item, bool show) {
+    if (show) {
+        tempRaise(item);
+        if (m_needs_restack)
+            m_preview = &item;
+    } else if (m_preview == &item) {
+        restack();
+    }
