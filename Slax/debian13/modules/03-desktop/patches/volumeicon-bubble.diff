+/* Outside clicks, including a second tray click, dismiss without changing volume. */
+static gboolean scale_press(GtkWidget *widget, GdkEventButton *event, gpointer data)
+{
+	int x, y;
+	gdk_window_get_origin(gtk_widget_get_window(widget), &x, &y);
+	gboolean inside_x = event->x_root >= x && event->x_root < x + gtk_widget_get_allocated_width(widget);
+	gboolean inside_y = event->y_root >= y && event->y_root < y + gtk_widget_get_allocated_height(widget);
+	if(inside_x && inside_y) return FALSE;
+	scale_close();
+	return TRUE;
+}
