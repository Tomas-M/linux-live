+/* Draw one continuous themed outline around the rounded body and its tail. */
+static gboolean scale_draw(GtkWidget *widget, cairo_t *cr, gpointer data)
+{
+	int width = gtk_widget_get_allocated_width(widget), height = gtk_widget_get_allocated_height(widget);
+	int top = m_scale_arrow_bottom ? 0 : 12, edge = m_scale_arrow_bottom ? height - 12 : 12;
+	int tip = m_scale_arrow_bottom ? height - 1 : 1;
+	cairo_save(cr);
+	cairo_set_operator(cr, CAIRO_OPERATOR_SOURCE);
+	cairo_set_source_rgba(cr, 0, 0, 0, 0);
+	cairo_paint(cr);
+	cairo_set_operator(cr, CAIRO_OPERATOR_OVER);
+	gtk_render_background(m_scale_style, cr, 0, top, width, height - 12);
+	gtk_render_frame_gap(m_scale_style, cr, 0, top, width, height - 12,
+	                     m_scale_arrow_bottom ? GTK_POS_BOTTOM : GTK_POS_TOP,
+	                     m_scale_arrow_x - 10, m_scale_arrow_x + 10);
+	GdkRGBA background, border;
+	gtk_style_context_get_background_color(m_scale_style, GTK_STATE_FLAG_NORMAL, &background);
+	gtk_style_context_get_border_color(m_scale_style, GTK_STATE_FLAG_NORMAL, &border);
+	cairo_move_to(cr, m_scale_arrow_x - 10, edge);
+	cairo_line_to(cr, m_scale_arrow_x, tip);
+	cairo_line_to(cr, m_scale_arrow_x + 10, edge);
+	cairo_close_path(cr);
+	gdk_cairo_set_source_rgba(cr, &background);
+	cairo_fill(cr);
+	cairo_move_to(cr, m_scale_arrow_x - 10, edge);
+	cairo_line_to(cr, m_scale_arrow_x, tip);
+	cairo_line_to(cr, m_scale_arrow_x + 10, edge);
+	gdk_cairo_set_source_rgba(cr, &border);
+	cairo_set_line_width(cr, 1);
+	cairo_stroke(cr);
+	cairo_restore(cr);
+	return FALSE;
+}
