 #define WSTATE_PAIR(a, b) ((int)(a) * NUM_OF_WSTATES + (int)(b))
+
+/// Read the taskbar's current button and fit the window inside it without stretching.
+static bool win_script_icon_target(struct session *ps, xcb_window_t client,
+                                   struct win_script_context *ctx) {
+	auto prop = x_get_prop(&ps->c, client, ps->atoms->a_NET_WM_ICON_GEOMETRY,
+	                      4, XCB_ATOM_CARDINAL, 32);
+	bool valid = prop.nitems == 4 && prop.r->bytes_after == 0;
+	if (valid) {
+		double x = prop.p32[0], y = prop.p32[1];
+		double width = prop.c32[2], height = prop.c32[3];
+		valid = x >= 0 && y >= 0 && width > 0 && height > 0 &&
+		        x + width <= ps->root_width && y + height <= ps->root_height;
+		if (valid) {
+			ctx->icon_x = x + width / 2;
+			ctx->icon_y = y + height / 2;
+			ctx->icon_scale = fmin(1, fmin(width / ctx->width, height / ctx->height));
+		}
+	}
+	free_winprop(&prop);
+	return valid;
+}
+
+/// Workspace changes also unmap windows. EWMH Hidden identifies minimization in Fluxbox.
+static enum animation_trigger
+win_script_icon_trigger(struct session *ps, struct win *w, const struct window_options *opts,
+                        enum animation_trigger trigger, struct win_script_context *ctx) {
+	auto client = win_client_id(w, /*fallback_to_self=*/true);
+	if (trigger == ANIMATION_TRIGGER_HIDE &&
+	    (opts->animations[ANIMATION_TRIGGER_MINIMIZE].script ||
+	     opts->animations[ANIMATION_TRIGGER_RESTORE].script)) {
+		auto state = x_get_prop(&ps->c, client, ps->atoms->a_NET_WM_STATE, 32,
+		                        XCB_ATOM_ATOM, 32);
+		w->was_iconified = false;
+		for (unsigned i = 0; i < state.nitems; i++) {
+			if (state.atom[i] == ps->atoms->a_NET_WM_STATE_HIDDEN) {
+				w->was_iconified = true;
+				break;
+			}
+		}
+		free_winprop(&state);
+	}
+	if (!w->was_iconified) {
+		return trigger;
+	}
+	auto icon_trigger = trigger == ANIMATION_TRIGGER_HIDE ? ANIMATION_TRIGGER_MINIMIZE
+	                                                     : ANIMATION_TRIGGER_RESTORE;
+	w->was_iconified = trigger == ANIMATION_TRIGGER_HIDE;
+	return opts->animations[icon_trigger].script && win_script_icon_target(ps, client, ctx)
+	           ? icon_trigger
+	           : trigger;
+}
