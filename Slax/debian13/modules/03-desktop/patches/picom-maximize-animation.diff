+	// Animate only when both changes reach the same render pass. A late state
+	// notification would rescale a layout that was already shown at target size.
+	bool resized = win_ctx.width_before != win_ctx.width ||
+	               win_ctx.height_before != win_ctx.height;
+	bool maximize_changed =
+	    !w->is_ewmh_fullscreen && old_maximized_axes != w->ewmh_maximized_axes;
+	if (trigger == ANIMATION_TRIGGER_GEOMETRY && resized && maximize_changed) {
+		// Treat a newly maximized axis as a grow and a removed axis as a shrink.
+		bool maximizing = (w->ewmh_maximized_axes & ~old_maximized_axes) != 0;
+		auto maximize_trigger = maximizing ? ANIMATION_TRIGGER_MAXIMIZE
+		                                   : ANIMATION_TRIGGER_UNMAXIMIZE;
+		if (win_options(w).animations[maximize_trigger].script) {
+			// Limit each axis to a 5% settle without passing its previous size.
+			win_ctx.resize_scale_x =
+			    clamp(win_ctx.width_before / win_ctx.width, 0.95, 1.05);
+			win_ctx.resize_scale_y =
+			    clamp(win_ctx.height_before / win_ctx.height, 0.95, 1.05);
+			trigger = maximize_trigger;
+		}
+	}
 	if (trigger == ANIMATION_TRIGGER_INVALID) {
 		// No state changes, if there's a animation running, we just continue it.
 		return win_advance_animation(w, delta_t, &win_ctx);
