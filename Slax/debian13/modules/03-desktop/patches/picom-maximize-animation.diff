+bool win_update_prop_ewmh_state(struct x_connection *c, const struct atom *atoms,
                                 struct win *w) {
 	auto prop = x_get_prop(c, win_client_id(w, /*fallback_to_self=*/true),
 	                       atoms->a_NET_WM_STATE, 12, XCB_ATOM_ATOM, 0);
 	bool is_fullscreen = false;
+	uint8_t maximized_axes = 0;
 	for (uint32_t i = 0; i < prop.nitems; i++) {
 		if (prop.atom[i] == atoms->a_NET_WM_STATE_FULLSCREEN) {
 			is_fullscreen = true;
-			break;
-		}
-	}
+		} else if (prop.atom[i] == atoms->a_NET_WM_STATE_MAXIMIZED_HORZ) {
+			maximized_axes |= 1;
+		} else if (prop.atom[i] == atoms->a_NET_WM_STATE_MAXIMIZED_VERT) {
+			maximized_axes |= 2;
+		}
+	}
+	w->ewmh_maximized_axes = maximized_axes;
 	free_winprop(&prop);
 
 	bool changed = w->is_ewmh_fullscreen != is_fullscreen;
@@ -1880,8 +1885,10 @@
 	auto win_ctx = win_script_context_prepare(ps, w);
 	bool geometry_changed = !win_geometry_eq(w->previous.g, w->g);
 	auto old_state = w->previous.state;
+	auto old_maximized_axes = w->previous.maximized_axes;
 
 	w->previous.state = w->state;
+	w->previous.maximized_axes = w->ewmh_maximized_axes;
 	w->previous.opacity = w->opacity;
 	w->previous.g = w->g;
 
@@ -1959,6 +1966,26 @@
 		              : ANIMATION_TRIGGER_DECREASE_OPACITY;
