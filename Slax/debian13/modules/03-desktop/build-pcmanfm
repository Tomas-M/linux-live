#!/bin/sh
set -eu
CWD=$(pwd)
OUTPUT=$1
VERSION=$(dpkg-query -W -f='${Version}' pcmanfm)
SOURCEVERSION=$(dpkg-query -W -f='${source:Version}' pcmanfm)
apt-get build-dep --yes --no-install-recommends "pcmanfm=$SOURCEVERSION"
mkdir -p /tmp/pcmanfm-rebuild
cd /tmp/pcmanfm-rebuild
apt-get source "pcmanfm=$SOURCEVERSION"
cd pcmanfm-*/
sed -i "1s/([^)]*)/($VERSION)/" debian/changelog
# Keep desktop drag state, captions and icon redraws consistent after every drop.
patch -p1 < "$CWD/patches/pcmanfm-desktop.diff"
dpkg-buildpackage -b -us -uc
cp ../pcmanfm_*.deb "$OUTPUT/"
