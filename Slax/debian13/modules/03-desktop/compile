#!/bin/sh
set -e
CWD=$(pwd)
OUTPUT=/artifacts/03-desktop
apt-get update
apt-get build-dep --yes --no-install-recommends fluxbox picom xfce4-panel xfce4-docklike-plugin
apt-get install --yes --no-install-recommends build-essential dpkg-dev quilt libimlib2-dev libgtk2.0-dev libnotify-dev libstartup-notification0-dev libxcursor-dev libxfixes-dev
mkdir -p /tmp/fluxbox-rebuild
cd /tmp/fluxbox-rebuild
apt-get source fluxbox
cd fluxbox-*/
# Keep Debian's binary rebuild version and identify the Slax patch.
VERSION=$(dpkg-query -W -f='${Version}' fluxbox)
sed -i "1s/([^)]*)/($VERSION+slax3)/" debian/changelog

# Build the Debian package with Slax's window and menu changes.
mkdir -p debian/patches
cp "$CWD/patches/fluxbox-slax.diff" debian/patches/
cp "$CWD/patches/fluxbox-preview.diff" debian/patches/
cp "$CWD/patches/fluxbox-panel-focus.diff" debian/patches/
printf 'fluxbox-slax.diff\nfluxbox-preview.diff\nfluxbox-panel-focus.diff\n' >> debian/patches/series
quilt push -a
cp "$CWD/patches/imlib2-config" /usr/bin/imlib2-config
chmod 755 /usr/bin/imlib2-config
dpkg-buildpackage -b -us -uc
cp ../fluxbox_*.deb "$OUTPUT/"

# Let unused panel space relinquish application and taskbar focus.
mkdir -p /tmp/panel-rebuild
cd /tmp/panel-rebuild
apt-get source xfce4-panel
cd xfce4-panel-*/
VERSION=$(dpkg-parsechangelog -S Version)
sed -i "1s/([^)]*)/($VERSION+slax1)/" debian/changelog
cp "$CWD/patches/panel-clear-focus.diff" debian/patches/
printf 'panel-clear-focus.diff\n' >> debian/patches/series
quilt push -a
dpkg-buildpackage -b -us -uc
cp ../xfce4-panel_*.deb "$OUTPUT/"

# Keep smooth upper corners available without requiring OpenGL.
mkdir -p /tmp/picom-rebuild
cd /tmp/picom-rebuild
apt-get source picom
cd picom-*/
VERSION=$(dpkg-parsechangelog -S Version)
sed -i "1s/([^)]*)/($VERSION+slax3)/" debian/changelog
# Picom and its installed helpers use native code and POSIX shell, not Python.
sed -i 's/^Depends: python3, /Depends: /' debian/control
mkdir -p debian/patches
cp "$CWD/patches/picom-top-corners.diff" debian/patches/
cp "$CWD/patches/picom-window-outline.diff" debian/patches/
printf 'picom-top-corners.diff\npicom-window-outline.diff\n' >> debian/patches/series
dpkg-buildpackage -b -us -uc
cp ../picom_*.deb "$OUTPUT/"

# Recycle one animated popup with bounded, proportional previews and hover dimming.
mkdir -p /tmp/docklike-rebuild
cd /tmp/docklike-rebuild
apt-get source xfce4-docklike-plugin
cd xfce4-docklike-plugin-*/
VERSION=$(dpkg-parsechangelog -S Version)
sed -i "1s/([^)]*)/($VERSION+slax23)/" debian/changelog
mkdir -p debian/patches
cp "$CWD"/patches/docklike-*.diff debian/patches/
printf 'docklike-preview-sizing.diff\ndocklike-preview-peek.diff\ndocklike-preview-animation.diff\ndocklike-taskbar-click.diff\ndocklike-popup-motion.diff\ndocklike-preview-header.diff\ndocklike-preview-raise.diff\ndocklike-preview-delay.diff\ndocklike-panel-focus.diff\ndocklike-preview-capture.diff\n' >> debian/patches/series
quilt push -a
dpkg-buildpackage -b -us -uc
# Reject incomplete plugin packages before they enter the runtime branch.
dpkg-deb -c ../xfce4-docklike-plugin_*.deb > /tmp/docklike-package-files
grep -q '/libdocklike.so$' /tmp/docklike-package-files
grep -q '/docklike.desktop$' /tmp/docklike-package-files
cp ../xfce4-docklike-plugin_*.deb "$OUTPUT/"

# Collect the additional desktop programs into one binary package.
PACKAGE=$OUTPUT/tools
mkdir -p "$PACKAGE/usr/bin" "$PACKAGE/usr/share/icons/hicolor/48x48/apps" "$PACKAGE/DEBIAN"
cc -Os -s -o "$PACKAGE/usr/bin/fbinstall" "$CWD/fbinstall.c" $(pkg-config --cflags --libs gtk+-2.0)
cc -Os -s -o "$PACKAGE/usr/bin/fbstartupnotify" "$CWD/fbstartupnotify.c" $(pkg-config --cflags --libs gtk+-2.0 gio-unix-2.0 libstartup-notification-1.0 xcursor x11 xfixes)
cc -Os -s -o "$PACKAGE/usr/bin/fbvboxpointer" "$CWD/fbvboxpointer.c" -lX11
cd /tmp
wget -O xlunch.tar.gz https://github.com/Tomas-M/xlunch/archive/v5.8.1.tar.gz
tar -xf xlunch.tar.gz
cd xlunch-5.8.1
make
# Reject releases without Focus support before packaging the launcher profile.
./xlunch --check-ui-config "$CWD/rootcopy/etc/xlunch/focus.ini"
cp xlunch "$PACKAGE/usr/bin/"
cp extra/gentriesquick "$PACKAGE/usr/bin/xlunch_genquick"
cp extra/ghost.png "$PACKAGE/usr/share/icons/hicolor/48x48/apps/xlunch_ghost.png"
cp docs/logo.png "$PACKAGE/usr/share/icons/hicolor/48x48/apps/xlunch.png"
mkdir -p "$PACKAGE/usr/share/xlunch"
cp -a extra/focus-icons "$PACKAGE/usr/share/xlunch/"

cd /tmp
wget -O systrayiconlauncher.tar.gz https://github.com/Tomas-M/SystrayIconLauncher/archive/master.tar.gz
tar -xf systrayiconlauncher.tar.gz
cd SystrayIconLauncher-master
make
cp systrayicon "$PACKAGE/usr/bin/"

cd /tmp
wget -O gtkdialog.tar.gz https://github.com/Tomas-M/GTKdialog/archive/master.tar.gz
tar -xf gtkdialog.tar.gz
cd GTKdialog-master
make
cp gtkdialog "$PACKAGE/usr/bin/"

cd /tmp
wget -O cbatticon.tar.gz https://github.com/valr/cbatticon/archive/1.6.10.tar.gz
tar -xf cbatticon.tar.gz
cd cbatticon-1.6.10
sed -i 's/WITH_GTK3 = 1/WITH_GTK3 = 0/' Makefile
make
cp cbatticon "$PACKAGE/usr/bin/"
strip "$PACKAGE/usr/bin/xlunch" "$PACKAGE/usr/bin/systrayicon" \
   "$PACKAGE/usr/bin/gtkdialog" "$PACKAGE/usr/bin/cbatticon"

# Derive runtime dependencies from the compiled executables, not build dependencies.
mkdir -p /tmp/slax-desktop-tools/debian
cd /tmp/slax-desktop-tools
cat > debian/control <<'EOF'
Source: slax-desktop-tools
Section: x11
Priority: optional
Maintainer: Slax <build@slax.org>

Package: slax-desktop-tools
Architecture: any
Description: Slax desktop launchers, software installer and battery indicator
EOF
DEPENDS=$(dpkg-shlibdeps -O "$PACKAGE/usr/bin/xlunch" "$PACKAGE/usr/bin/systrayicon" \
   "$PACKAGE/usr/bin/gtkdialog" "$PACKAGE/usr/bin/cbatticon" "$PACKAGE/usr/bin/fbinstall" "$PACKAGE/usr/bin/fbstartupnotify" "$PACKAGE/usr/bin/fbvboxpointer")
cat > "$PACKAGE/DEBIAN/control" <<EOF
Package: slax-desktop-tools
Version: 1
Architecture: amd64
Maintainer: Slax <build@slax.org>
Depends: ${DEPENDS#shlibs:Depends=}
Description: Slax desktop launchers, software installer and battery indicator
EOF
dpkg-deb --build --root-owner-group "$PACKAGE" "$OUTPUT/slax-desktop-tools.deb"
