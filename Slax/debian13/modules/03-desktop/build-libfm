#!/bin/sh
set -eu
CWD=$(pwd)
OUTPUT=$1
VERSION=$(dpkg-query -W -f='${Version}' libfm4t64)
SOURCEVERSION=$(dpkg-query -W -f='${source:Version}' libfm4t64)
apt-get build-dep --yes --no-install-recommends "libfm=$SOURCEVERSION"
mkdir -p /tmp/libfm-rebuild
cd /tmp/libfm-rebuild
apt-get source "libfm=$SOURCEVERSION"
cd libfm-*/
sed -i "1s/([^)]*)/($VERSION)/" debian/changelog
# Preserve file identity across renames instead of deleting and recreating rows.
patch -p1 < "$CWD/patches/libfm-rename.diff"
# Use native, event-driven filesystem rows with asynchronous mount actions.
patch -p1 < "$CWD/patches/libfm-places.diff"
patch -p1 < "$CWD/patches/libfm-check-selection.diff"
cp "$CWD/libfm-places-model.h" src/gtk/slax-places-model.h
cp "$CWD/libfm-places-view.h" src/gtk/slax-places-view.h
cp "$CWD/places-labels.h" src/gtk/slax-places-labels.h
cp "$CWD/places-check.h" src/gtk/slax-places-check.h
# Pad icon captions symmetrically and render their themed selection background.
patch -p1 < "$CWD/patches/libfm-icon-label.diff"
patch -p1 < "$CWD/patches/libfm-symlink-badge.diff"
gdk-pixbuf-csource --raw --static --name=link_icon_data "$CWD/symlink-badge.png" > src/gtk/slax-link-icon.h
# Match drag previews to the displayed image, using a folder for multiple files.
patch -p1 < "$CWD/patches/libfm-drag-preview.diff"
dpkg-buildpackage -b -us -uc
cp ../libfm4t64_*.deb ../libfm-gtk3-4t64_*.deb ../libfm-modules_*.deb "$OUTPUT/"
