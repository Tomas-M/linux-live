#!/bin/sh
set -e
apt-get update
apt-get install --no-install-recommends --yes \
   xserver-xorg xserver-xorg-video-all xserver-xorg-video-intel \
   xinit xterm xinput libxcursor1 x11-utils wmctrl xdotool \
   libdrm-intel1 libgl1-mesa-dri libglu1-mesa fluxbox feh volumeicon-alsa \
   murrine-themes libnotify4 libgtk2.0-0 librsvg2-common libglib2.0-bin \
   desktop-file-utils xfce4-panel scrot spice-vdagent galculator pcmanfm \
   connman-gtk at-spi2-core scite xarchiver xdg-utils

# Allow the guest account to start Xorg.
chmod u+s /usr/lib/xorg/Xorg
# Extract the server utilities without their unnecessary cpp dependency.
cd /tmp
apt-get download x11-xserver-utils
mkdir x11utils
dpkg -x x11-xserver-utils*.deb x11utils
cp -a x11utils/. /
update-alternatives --set x-terminal-emulator /usr/bin/xterm
