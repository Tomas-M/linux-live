#!/bin/sh
set -e
apt-get update
# Debian's headers require their exact runtime version in this disposable branch.
GTKVERSION=$(apt-cache show --no-all-versions libgtk-3-dev | sed -n 's/^Version: //p')
apt-get install --yes --no-install-recommends --allow-downgrades build-essential pkg-config libgtk-3-dev "libgtk-3-0t64=$GTKVERSION"

# Apply Slax's UI adjustments while keeping the stock Debian applications.
cc -Os -shared -fPIC -s -o /artifacts/04-apps/libslax-app-style.so \
   gtk-app-style.c $(pkg-config --cflags --libs gtk+-3.0)
