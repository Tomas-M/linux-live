#!/bin/sh
set -e
CWD=$(pwd)
apt-get update
apt-get build-dep --yes --no-install-recommends pcmanfm
mkdir -p /tmp/pcmanfm-rebuild
cd /tmp/pcmanfm-rebuild
apt-get source pcmanfm
cd pcmanfm-*/
# Keep Debian's binary rebuild version and identify the Slax patch.
VERSION=$(dpkg-query -W -f='${Version}' pcmanfm)
sed -i "1s/([^)]*)/($VERSION+slax1)/" debian/changelog
# Keep the Slax patch in the Debian package instead of copying an untracked binary.
mkdir -p debian/patches
cp "$CWD/patches/pcmanfm-slax.diff" debian/patches/
printf 'pcmanfm-slax.diff\n' >> debian/patches/series
dpkg-buildpackage -b -us -uc
cp ../pcmanfm_*.deb /artifacts/04-apps/
