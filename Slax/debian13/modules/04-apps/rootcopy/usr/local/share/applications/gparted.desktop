[Desktop Entry]
Type=Application
Name=Partition Manager
Exec=fbinstall gparted slax-gparted "Partition Manager" "gparted" "/usr/sbin/gparted" %f
X-Xlunch-Executable=/usr/sbin/gparted
Icon=slax-gparted
Terminal=false
StartupNotify=true
GenericName=Partition Editor
Comment=Create, reorganize, and delete partitions
Categories=GNOME;System;Filesystem;
Keywords=Partition;
