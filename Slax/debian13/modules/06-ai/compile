#!/bin/sh
set -e

# Host C tools and Cargo dependencies stay in the disposable build branch and tmpfs.
apt-get update
apt-get install --yes --no-install-recommends gcc libc6-dev rustup musl-tools
export RUSTUP_HOME=/tmp/slax-ai-rustup CARGO_HOME=/tmp/slax-ai-cargo CARGO_TARGET_DIR=/tmp/slax-ai-target
export CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=musl-gcc
rustup toolchain install 1.99.0 --profile minimal
rustup target add x86_64-unknown-linux-musl --toolchain 1.99.0
cd /build/slax-ai
cargo build --release --locked --target x86_64-unknown-linux-musl

# The runtime package contains one static executable, including its UI and Slax knowledge.
PACKAGE=$(mktemp -d)
mkdir -p "$PACKAGE/DEBIAN"
install -D -m 755 "$CARGO_TARGET_DIR/x86_64-unknown-linux-musl/release/slax-ai" "$PACKAGE/usr/bin/slax-ai"
cat > "$PACKAGE/DEBIAN/control" <<'EOF'
Package: slax-ai
Version: 0.1.0
Architecture: amd64
Maintainer: Slax
Depends: chromium
Description: Slax AI local agent and browser interface
 Static native client with embedded UI and local tools.
EOF
dpkg-deb --build "$PACKAGE" /artifacts/06-ai/slax-ai_0.1.0_amd64.deb
