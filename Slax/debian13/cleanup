rm -Rf /var/cache/apparmor/*
rm -f /var/cache/fontconfig/*
rm -Rf /var/cache/man/*
rm -f /var/lib/systemd/random-seed
rm -f /var/lib/apt/lists/deb.*
rm -Rf /root/.local/share/mc
rm -Rf /root/.cache
rm -f /root/.wget-hsts

rm -f /var/lib/dpkg/*-old
find /var/log -type f -delete
rm -f /var/cache/apt/archives/*.deb
rm -Rf /var/lib/connman/*
rm -f /var/cache/apt/*.bin
rm -f /var/cache/debconf/*-old
rm -f /var/lib/dhcp/dhclient.leases
rm -f /root/.bash_history
rm -f /root/.wget-hsts
rm -Rf /usr/share/doc/*
rm -Rf /usr/share/info/*
rm -f /usr/share/images/fluxbox/debian-squared.jpg
rm -Rf /usr/share/fluxbox/nls/??*
rm -Rf /usr/share/gnome/help

# Remove development documentation and metadata for tools absent from the live system.
rm -Rf /usr/share/gtk-doc /usr/share/doc-base /usr/share/lintian
rm -Rf /usr/share/bug /usr/share/apport /usr/share/metainfo /usr/share/appdata

# GTK embeds English emoji data; these external resources contain translated names.
rm -f /usr/share/gtk-3.0/emoji/*.gresource

# Kernel self-tests are not hardware drivers; regenerate indexes after removing them.
for DIR in /lib/modules/*; do
   if [ -d "$DIR/kernel/lib" ]; then
      if [ -n "$(find "$DIR/kernel/lib" -type f -name 'test_*.ko*' -print -delete)" ]; then
         depmod "${DIR##*/}"
      fi
   fi
done

rm -Rf /usr/share/locale/??
rm -Rf /usr/share/locale/??_*
rm -Rf /usr/share/locale/??@*
rm -Rf /usr/share/locale/???
rm -Rf /usr/share/i18n/locales/*_*
# Runtime conversion uses gconv; keep the source charmap only for UTF-8 locale generation.
find /usr/share/i18n/charmaps -type f ! -name UTF-8.gz -delete
rm -Rf /usr/share/man/??
rm -Rf /usr/share/man/??.*
rm -Rf /usr/share/man/*_*

# Keep user and administration manuals, without programming, OpenSSL API or PAM references.
rm -Rf /usr/share/man/man2* /usr/share/man/man3*
rm -f /usr/share/man/man7/*.7ssl /usr/share/man/man7/*.7ssl.*
rm -f /usr/share/man/man*/pam_*

rm -Rf /usr/share/icons/elementaryXubuntu-dark
rm -Rf /usr/share/icons/gnome/256x256
rm -Rf /usr/share/icons/Adwaita/cursors
rm -Rf /usr/share/icons/Adwaita/512x512
rm -Rf /usr/share/icons/Adwaita/256x256
rm -Rf /usr/share/icons/Adwaita/64x64
rm -Rf /usr/share/icons/Adwaita/96x96
rm -Rf /usr/share/yudit/*

rm -f /usr/share/applications/picom.desktop
rm -f /etc/xdg/autostart/picom.desktop
rm -f /usr/share/applications/debian-uxterm.desktop
rm -f /usr/share/applications/htop.desktop
