rm -f /etc/systemd/system/multi-user.target.wants/media-sr0.mount
rm -f /etc/systemd/system/media-sda1.mount
rm -f /etc/systemd/system/multi-user.target.wants/media-sda1.mount

rm -f /etc/.pwd.lock
rm -f /etc/console-setup/cached*
rm -f /root/.gtk-bookmarks

# Unzip gzipped files (man pages), so LZMA can compress 2times better.
# First we fix symlinks, then uncompress files
# $1 = search directory
uncompress_files()
{
   [ -d "$1" ] || return 0

   find "$1" -type l -name "*.gz" | while IFS= read -r LINE; do
      LINK=$(readlink "$LINE")
      ln -sfn "${LINK%.gz}" "${LINE%.gz}"
      rm -f "$LINE"
   done
   find "$1" -type f -name "*.gz" -exec gunzip -f {} +
}

uncompress_files /etc/alternatives
uncompress_files /usr/share/man

# remove broken links
# $1 = search directory
remove_broken_links()
{
   [ -d "$1" ] || return 0
   find "$1" -type l ! -exec test -e {} \; -delete
}

remove_broken_links /etc/alternatives
remove_broken_links /usr/share/man
remove_broken_links /usr/share/scite

